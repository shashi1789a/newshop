<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Seller Dashboard — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --lavender: #f0ebff;
      --lavender-2: #e0d5ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       SELLER DASHBOARD
    ===================================================== */

    .seller-dashboard {
      width: 94%;
      max-width: 1400px;
      margin: 45px auto 80px;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       DASHBOARD HEADER
    ===================================================== */

    .dashboard-header {
      background: var(--surface);
      padding: 36px 40px;
      border-radius: var(--radius-xl);
      margin-bottom: 32px;
      box-shadow: 0 20px 60px rgba(13, 59, 46, 0.08);
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border-soft);
    }

    .dashboard-header::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
    }

    .dashboard-header::after {
      content: "🏪";
      position: absolute;
      font-size: 260px;
      opacity: 0.035;
      right: -40px;
      bottom: -80px;
      transform: rotate(-12deg);
      pointer-events: none;
    }

    .dashboard-header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      border: 1px solid rgba(13, 59, 46, 0.08);
      color: var(--forest-3);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
      position: relative;
      z-index: 2;
    }

    .dashboard-header-eyebrow::before {
      content: "✨";
      font-size: 12px;
    }

    .dashboard-header h1 {
      font-family: var(--font-serif);
      font-size: 42px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 12px;
      position: relative;
      z-index: 2;
    }

    .dashboard-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .dashboard-header p {
      color: var(--text-muted);
      font-size: 15px;
      line-height: 1.7;
      position: relative;
      z-index: 2;
      max-width: 620px;
    }

    .dashboard-header p + p {
      margin-top: 4px;
    }

    .dashboard-header strong {
      color: var(--forest);
      font-weight: 800;
    }

    /* =====================================================
       STATS GRID
    ===================================================== */

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .dashboard-card {
      background: var(--surface);
      padding: 26px 24px 24px;
      border-radius: var(--radius-lg);
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      border: 2px solid var(--border-soft);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .dashboard-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .dashboard-card:hover::before {
      transform: scaleX(1);
    }

    .dashboard-card:hover {
      transform: translateY(-6px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .dashboard-card h2 {
      font-size: 10.5px;
      color: var(--text-light);
      margin-bottom: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dashboard-card h2 i {
      color: var(--mango-deep);
      font-size: 11px;
    }

    .dashboard-card p {
      font-family: var(--font-serif);
      font-size: 34px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -1.2px;
      line-height: 1;
    }

    /* Sales card — special */

    .sales-card {
      background:
        radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.08) 0%, transparent 60%),
        linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      border-color: rgba(16, 185, 129, 0.2);
    }

    .sales-card::before {
      background: linear-gradient(90deg, var(--emerald) 0%, var(--forest-3) 100%);
    }

    .sales-card h2 {
      color: var(--forest-3);
    }

    .sales-card h2 i {
      color: var(--emerald);
    }

    .sales-card p {
      background: linear-gradient(120deg, var(--forest) 0%, var(--emerald) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* =====================================================
       SECTIONS
    ===================================================== */

    .section {
      background: var(--surface);
      padding: 32px 34px;
      border-radius: var(--radius-xl);
      margin-bottom: 32px;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      border: 1px solid var(--border-soft);
      position: relative;
      overflow: hidden;
    }

    .section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--emerald) 100%);
      opacity: 0.6;
    }

    .section h2 {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.5px;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--border);
      display: flex;
      align-items: center;
      gap: 14px;
      position: relative;
      z-index: 2;
    }

    .section h2::before {
      content: "";
      width: 5px;
      height: 24px;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 4px;
      flex-shrink: 0;
    }

    /* =====================================================
       ACTIONS
    ===================================================== */

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      position: relative;
      z-index: 2;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 13px 22px;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.2);
      position: relative;
      overflow: hidden;
    }

    .action-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .action-btn:hover::before { left: 100%; }

    .action-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(13, 59, 46, 0.32);
      gap: 14px;
    }

    /* =====================================================
       PRODUCT LIST
    ===================================================== */

    .product-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 20px;
      position: relative;
      z-index: 2;
    }

    .product-card {
      border: 2px solid var(--border-soft);
      border-radius: var(--radius);
      padding: 16px;
      background: #ffffff;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .product-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .product-card:hover::before {
      transform: scaleX(1);
    }

    .product-card:hover {
      transform: translateY(-6px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .product-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: var(--radius-sm);
      margin-bottom: 14px;
      background: linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .product-card:hover img {
      transform: scale(1.04);
    }

    .product-card h3 {
      font-family: var(--font-serif);
      font-size: 17px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.3px;
      margin-bottom: 8px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-card p {
      color: var(--text-muted);
      font-size: 12.5px;
      margin-bottom: 6px;
      font-weight: 600;
    }

    .product-card p strong {
      color: var(--forest);
      font-weight: 800;
    }

    .product-price {
      font-family: var(--font-serif);
      font-size: 20px !important;
      font-weight: 700 !important;
      color: var(--forest) !important;
      margin-top: 10px !important;
      letter-spacing: -0.6px;
      padding-top: 10px;
      border-top: 1px dashed var(--border);
    }

    /* =====================================================
       VIEW ALL LINK
    ===================================================== */

    .view-all {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 24px;
      color: var(--forest-3);
      font-weight: 800;
      font-size: 13px;
      text-decoration: none;
      letter-spacing: 0.3px;
      padding: 10px 18px;
      border-radius: 30px;
      background: rgba(16, 185, 129, 0.08);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      z-index: 2;
    }

    .view-all::after {
      content: "→";
      transition: transform 0.3s ease;
    }

    .view-all:hover {
      background: var(--forest);
      color: #ffffff;
      gap: 12px;
    }

    .view-all:hover::after {
      transform: translateX(4px);
    }

    /* =====================================================
       EMPTY
    ===================================================== */

    .empty {
      color: var(--text-muted);
      padding: 20px 24px;
      font-size: 14px;
      background: var(--surface-2);
      border-radius: var(--radius-sm);
      border: 1px dashed var(--border);
      text-align: center;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: relative;
      z-index: 2;
    }

    .empty::before {
      content: "📦";
      font-size: 18px;
      opacity: 0.6;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 900px) {

      .seller-dashboard {
        width: 94%;
        margin: 32px auto 60px;
      }

      .dashboard-header {
        padding: 30px 28px;
      }

      .dashboard-header h1 {
        font-size: 34px;
      }

      .dashboard-card p {
        font-size: 28px;
      }

      .section {
        padding: 26px 24px;
      }

      .section h2 {
        font-size: 21px;
      }

    }

    @media (max-width: 600px) {

      .seller-dashboard {
        width: 94%;
        margin: 24px auto 60px;
      }

      .dashboard-header {
        padding: 26px 22px;
      }

      .dashboard-header h1 {
        font-size: 26px;
        letter-spacing: -1px;
      }

      .dashboard-header-eyebrow {
        font-size: 10px;
        padding: 6px 12px;
        letter-spacing: 1.5px;
      }

      .dashboard-header p {
        font-size: 13.5px;
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .dashboard-card {
        padding: 20px 20px 18px;
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .dashboard-card h2 {
        margin-bottom: 0;
        flex: 1;
      }

      .dashboard-card p {
        font-size: 24px;
        flex-shrink: 0;
      }

      .section {
        padding: 22px 20px;
        border-radius: var(--radius-lg);
      }

      .section h2 {
        font-size: 18px;
        margin-bottom: 18px;
        padding-bottom: 12px;
      }

      .section h2::before {
        height: 20px;
        width: 4px;
      }

      .actions {
        flex-direction: column;
      }

      .action-btn {
        width: 100%;
        justify-content: center;
      }

      .product-list {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
      }

      .product-card {
        padding: 12px;
      }

      .product-card img {
        height: 150px;
        margin-bottom: 10px;
      }

      .product-card h3 {
        font-size: 14px;
      }

      .product-card p {
        font-size: 11px;
      }

      .product-price {
        font-size: 16px !important;
      }

      .view-all {
        font-size: 12px;
        padding: 8px 14px;
      }

    }

  </style>

</head>

<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="seller-dashboard">


    <!-- =================================================
         DASHBOARD HEADER
    ================================================== -->

    <section class="dashboard-header" data-reveal="down">

      <span class="dashboard-header-eyebrow">
        Seller Hub
      </span>

      <h1>
        Seller <em>Dashboard.</em>
      </h1>

      <p>
        Welcome back,
        <strong>
          <%= user && user.name ? user.name : "Seller" %>
        </strong>
      </p>

      <p>
        Manage your new clothes, pre-loved clothes, orders, and sales —
        all in one place.
      </p>

    </section>


    <!-- =================================================
         STATISTICS
    ================================================== -->

    <section class="dashboard-grid">


      <!-- TOTAL PRODUCTS -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="0">

        <h2>
          <i class="fas fa-tshirt"></i>
          Total Products
        </h2>

        <p>
          <%= typeof totalProducts !== "undefined" ? totalProducts : 0 %>
        </p>

      </div>


      <!-- ACTIVE PRODUCTS -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="50">

        <h2>
          <i class="fas fa-check-circle"></i>
          Active Products
        </h2>

        <p>
          <%= typeof activeProducts !== "undefined" ? activeProducts : 0 %>
        </p>

      </div>


      <!-- INACTIVE PRODUCTS -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="100">

        <h2>
          <i class="fas fa-pause-circle"></i>
          Inactive Products
        </h2>

        <p>
          <%= typeof inactiveProducts !== "undefined" ? inactiveProducts : 0 %>
        </p>

      </div>


      <!-- OLD CLOTHES -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="150">

        <h2>
          <i class="fas fa-recycle"></i>
          Old Clothes
        </h2>

        <p>
          <%= typeof totalOldClothes !== "undefined" ? totalOldClothes : 0 %>
        </p>

      </div>


      <!-- ACTIVE OLD CLOTHES -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="200">

        <h2>
          <i class="fas fa-leaf"></i>
          Active Old Clothes
        </h2>

        <p>
          <%= typeof activeOldClothes !== "undefined" ? activeOldClothes : 0 %>
        </p>

      </div>


      <!-- TOTAL ORDERS -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="250">

        <h2>
          <i class="fas fa-shopping-bag"></i>
          Total Orders
        </h2>

        <p>
          <%= typeof totalOrders !== "undefined" ? totalOrders : 0 %>
        </p>

      </div>


      <!-- PENDING -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="300">

        <h2>
          <i class="fas fa-clock"></i>
          Pending Orders
        </h2>

        <p>
          <%= typeof pendingOrders !== "undefined" ? pendingOrders : 0 %>
        </p>

      </div>


      <!-- SHIPPED -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="350">

        <h2>
          <i class="fas fa-shipping-fast"></i>
          Shipped Orders
        </h2>

        <p>
          <%= typeof shippedOrders !== "undefined" ? shippedOrders : 0 %>
        </p>

      </div>


      <!-- DELIVERED -->

      <div class="dashboard-card" data-reveal="zoom-up" data-delay="400">

        <h2>
          <i class="fas fa-check-double"></i>
          Delivered Orders
        </h2>

        <p>
          <%= typeof deliveredOrders !== "undefined" ? deliveredOrders : 0 %>
        </p>

      </div>


      <!-- SALES -->

      <div class="dashboard-card sales-card" data-reveal="zoom-up" data-delay="450">

        <h2>
          <i class="fas fa-rupee-sign"></i>
          Total Sales
        </h2>

        <p>
          ₹<%= typeof totalSales !== "undefined" ? totalSales : 0 %>
        </p>

      </div>


    </section>


    <!-- =================================================
         QUICK ACTIONS
    ================================================== -->

