<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Sales Report — Reciclaja Seller</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       CONTAINER
    ===================================================== */

    .container {
      width: 94%;
      max-width: 1300px;
      margin: 45px auto 80px;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       PAGE HEADER
    ===================================================== */

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 34px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
      gap: 20px;
      flex-wrap: wrap;
      position: relative;
    }

    .header::after {
      content: "";
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 90px;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 3px;
    }

    .header-text {
      flex: 1;
      min-width: 260px;
    }

    .header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.22);
      color: var(--forest-3);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .header-eyebrow::before {
      content: "📈";
      font-size: 12px;
    }

    .header h1 {
      font-family: var(--font-serif);
      font-size: 40px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 8px;
    }

    .header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .header p {
      color: var(--text-muted);
      font-size: 14.5px;
      line-height: 1.65;
      max-width: 560px;
    }

    /* =====================================================
       BACK BUTTON
    ===================================================== */

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 13px 24px;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }

    .back-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .back-btn:hover::before { left: 100%; }

    .back-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    .back-btn i {
      transition: transform 0.3s ease;
    }

    .back-btn:hover i {
      transform: translateX(-3px);
    }

    /* =====================================================
       STATS
    ===================================================== */

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: var(--surface);
      padding: 28px 26px 26px;
      border-radius: var(--radius-lg);
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      border: 2px solid var(--border-soft);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .stat-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .stat-card:hover::before {
      transform: scaleX(1);
    }

    .stat-card:hover {
      transform: translateY(-6px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .stat-card-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: #ffffff;
      margin-bottom: 18px;
      transition: transform 0.35s ease;
      position: relative;
      z-index: 2;
    }

    .stat-card:hover .stat-card-icon {
      transform: scale(1.08) rotate(-6deg);
    }

    .stat-card:nth-child(1) .stat-card-icon {
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .stat-card:nth-child(2) .stat-card-icon {
      background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
      box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
    }

    .stat-card:nth-child(3) .stat-card-icon {
      background: linear-gradient(135deg, #2b7de0 0%, #125ca5 100%);
      box-shadow: 0 8px 20px rgba(43, 125, 224, 0.3);
    }

    .stat-card h3 {
      color: var(--text-light);
      font-size: 10.5px;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 8px;
      position: relative;
      z-index: 2;
    }

    .stat-card p {
      font-family: var(--font-serif);
      font-size: 34px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -1.2px;
      line-height: 1;
      position: relative;
      z-index: 2;
    }

    /* Total sales card special */

    .stat-card.sales-card {
      background:
        radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.08) 0%, transparent 60%),
        linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      border-color: rgba(16, 185, 129, 0.2);
    }

    .stat-card.sales-card h3 {
      color: var(--forest-3);
    }

    .stat-card.sales-card p {
      background: linear-gradient(120deg, var(--forest) 0%, var(--emerald) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* =====================================================
       SALES BOX
    ===================================================== */

    .sales-box {
      background: var(--surface);
      border-radius: var(--radius-xl);
      padding: 32px 34px;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      border: 1px solid var(--border-soft);
      position: relative;
      overflow: hidden;
    }

    .sales-box::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--emerald) 100%);
      opacity: 0.6;
    }

    .sales-box h2 {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.5px;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--border);
      display: flex;
      align-items: center;
      gap: 14px;
      position: relative;
      z-index: 2;
    }

    .sales-box h2::before {
      content: "";
      width: 5px;
      height: 24px;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 4px;
      flex-shrink: 0;
    }

    /* =====================================================
       TABLE
    ===================================================== */

    table {
      width: 100%;
      border-collapse: collapse;
      position: relative;
      z-index: 2;
    }

    thead th {
      background: var(--surface-2);
      padding: 14px 18px;
      text-align: left;
      color: var(--forest);
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    thead th:first-child {
      border-top-left-radius: var(--radius-sm);
      border-bottom-left-radius: 0;
    }

    thead th:last-child {
      border-top-right-radius: var(--radius-sm);
      text-align: right;
    }

    tbody td {
      padding: 16px 18px;
      color: var(--text-muted);
      font-size: 13.5px;
      font-weight: 600;
      border-bottom: 1px dashed var(--border);
      transition: all 0.25s ease;
    }

    tbody td:first-child {
      color: var(--forest);
      font-weight: 800;
      font-family: var(--font-serif);
      font-size: 14.5px;
      letter-spacing: -0.2px;
    }

    tbody td:last-child {
      text-align: right;
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 16px;
      color: var(--forest);
      letter-spacing: -0.3px;
    }

    tbody tr {
      transition: all 0.25s ease;
    }

    tbody tr:hover td {
      background: var(--surface-2);
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    /* Status text */

    tbody td .status-text {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      background: var(--surface-2);
      color: var(--text-muted);
      border: 1px solid var(--border-soft);
    }

    /* =====================================================
       EMPTY STATE
    ===================================================== */

    .empty {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
      position: relative;
      z-index: 2;
    }

    .empty-icon {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      color: var(--coral);
      margin: 0 auto 22px;
      box-shadow: 0 12px 32px rgba(249, 115, 98, 0.2);
      position: relative;
    }

    .empty h3 {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.5px;
      margin-bottom: 10px;
    }

    .empty p {
      font-size: 14.5px;
      max-width: 480px;
      margin: 0 auto;
      line-height: 1.65;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 900px) {

      .container {
        width: 94%;
        margin: 32px auto 60px;
      }

      .header h1 {
        font-size: 34px;
      }

      .stats {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .stat-card {
        padding: 22px 22px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .stat-card-icon {
        width: 46px;
        height: 46px;
        font-size: 17px;
        margin-bottom: 0;
        flex-shrink: 0;
      }

      .stat-card h3 {
        margin-bottom: 6px;
        font-size: 10px;
      }

      .stat-card p {
        font-size: 26px;
      }

      .sales-box {
        padding: 26px 22px;
      }

      .sales-box h2 {
        font-size: 20px;
      }

    }

    @media (max-width: 768px) {

      .header {
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
      }

      .back-btn {
        justify-content: center;
        width: 100%;
      }

      .sales-box {
        overflow-x: auto;
      }

      table {
        min-width: 480px;
      }

    }

    @media (max-width: 500px) {

      .header h1 {
        font-size: 26px;
        letter-spacing: -1px;
      }

      .header-eyebrow {
        font-size: 10px;
        padding: 6px 12px;
        letter-spacing: 1.5px;
      }

      .header p {
        font-size: 13px;
      }

      .stat-card {
        padding: 18px 18px 16px;
      }

      .stat-card p {
        font-size: 22px;
      }

      .sales-box {
        padding: 22px 18px;
        border-radius: var(--radius-lg);
      }

      .sales-box h2 {
        font-size: 18px;
        margin-bottom: 18px;
      }

      .sales-box h2::before {
        height: 20px;
        width: 4px;
      }

      thead th,
      tbody td {
        padding: 12px 14px;
        font-size: 12px;
      }

      thead th {
        font-size: 9.5px;
      }

      tbody td:first-child {
        font-size: 13px;
      }

      tbody td:last-child {
        font-size: 14px;
      }

      .empty {
        padding: 40px 16px;
      }

      .empty-icon {
        width: 72px;
        height: 72px;
        font-size: 30px;
      }

      .empty h3 {
        font-size: 20px;
      }

      .empty p {
        font-size: 13px;
      }

    }

  </style>

</head>


<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <div class="container">


    <!-- =================================================
         PAGE HEADER
    ================================================== -->

    <div class="header" data-reveal="down">

      <div class="header-text">

        <span class="header-eyebrow">
          Analytics
        </span>

        <h1>
          Sales <em>Report.</em>
        </h1>

        <p>
          Track your total sales, order volume, and completed deliveries —
          all in one clear overview.
        </p>

      </div>


      <a href="/seller/dashboard" class="back-btn">
        <i class="fas fa-arrow-left"></i>
        Dashboard
      </a>

    </div>


    <%
      const safeTotalSales =
        typeof totalSales !== "undefined" ? totalSales : 0;

      const safeTotalOrders =
        typeof totalOrders !== "undefined" ? totalOrders : 0;

      const safeDeliveredOrders =
        typeof deliveredOrders !== "undefined" ? deliveredOrders : 0;

      const safeSales =
        Array.isArray(sales) ? sales : [];
    %>


    <!-- =================================================
         STATS
    ================================================== -->

    <div class="stats">


      <!-- TOTAL SALES -->

      <div
        class="stat-card sales-card"
        data-reveal="zoom-up"
        data-delay="0"
      >

        <div class="stat-card-icon">
          <i class="fas fa-rupee-sign"></i>
        </div>

        <h3>
          <i class="fas fa-chart-line"></i>
          Total Sales
        </h3>

        <p>
          ₹<%= Number(safeTotalSales || 0).toLocaleString("en-IN") %>
        </p>

      </div>


      <!-- TOTAL ORDERS -->

      <div
        class="stat-card"
        data-reveal="zoom-up"
        data-delay="100"
      >

        <div class="stat-card-icon">
          <i class="fas fa-shopping-bag"></i>
        </div>

        <h3>
          <i class="fas fa-box"></i>
          Total Orders
        </h3>

        <p>
          <%= safeTotalOrders %>
        </p>

      </div>


      <!-- DELIVERED ORDERS -->

      <div
        class="stat-card"
        data-reveal="zoom-up"
        data-delay="200"
      >

        <div class="stat-card-icon">
          <i class="fas fa-check-double"></i>
        </div>

        <h3>
          <i class="fas fa-check-circle"></i>
          Delivered Orders
        </h3>

        <p>
          <%= safeDeliveredOrders %>
        </p>

      </div>


    </div>


    <!-- =================================================
         SALES TABLE
    ================================================== -->

    <div class="sales-box" data-reveal="up">


      <h2>
        Sales Details
      </h2>


      <% if (safeSales.length === 0) { %>


        <div class="empty">

          <div class="empty-icon">
            <i class="fas fa-chart-bar"></i>
          </div>

          <h3>
            No Sales Found
          </h3>

          <p>
            Your sales information will appear here once customers
            purchase your products.
          </p>

        </div>


      <% } else { %>


        <table>

          <thead>

            <tr>

              <th>
                Order ID
              </th>

              <th>
                Date
              </th>

              <th>
                Status
              </th>

              <th>
                Amount
              </th>

            </tr>

          </thead>


          <tbody>

            <% safeSales.forEach((sale, index) => { %>

              <tr>

                <td>
                  #<%= String(sale._id).slice(-8).toUpperCase() %>
                </td>

                <td>

                  <%= sale.createdAt
                    ? new Date(sale.createdAt).toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                      })
                    : "N/A"
                  %>

                </td>

                <td>

                  <span class="status-text">
                    <%= sale.status || "Pending" %>
                  </span>

                </td>

                <td>

                  ₹<%= Number(
                    sale.totalAmount ||
                    sale.total ||
                    sale.amount ||
                    0
                  ).toLocaleString("en-IN") %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>


      <% } %>


    </div>


  </div>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    console.log("Reciclaja — Sales Report page loaded 📈");

  </script>

</body>

</html>