<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>My Wishlist — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       WISHLIST CONTAINER
    ===================================================== */

    .wishlist-container {
      width: 94%;
      max-width: 1200px;
      margin: 45px auto 80px;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       PAGE HEADER
    ===================================================== */

    .wishlist-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
      gap: 20px;
      flex-wrap: wrap;
      position: relative;
    }

    .wishlist-header::after {
      content: "";
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 90px;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 3px;
    }

    .header-text {
      flex: 1;
      min-width: 260px;
    }

    .header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(249, 115, 98, 0.08);
      border: 1px solid rgba(249, 115, 98, 0.22);
      color: var(--coral-deep);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .header-eyebrow::before {
      content: "❤️";
      font-size: 12px;
    }

    .wishlist-header h1 {
      font-family: var(--font-serif);
      font-size: 42px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 8px;
    }

    .wishlist-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .wishlist-header p {
      color: var(--text-muted);
      font-size: 14.5px;
      max-width: 540px;
      line-height: 1.65;
    }

    /* =====================================================
       WISHLIST COUNT BADGE
    ===================================================== */

    .wishlist-count {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      color: #ffffff;
      padding: 12px 20px;
      border-radius: 30px;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      box-shadow: 0 8px 20px rgba(249, 115, 98, 0.28);
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }

    .wishlist-count::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .wishlist-count:hover::before { left: 100%; }

    .wishlist-count i {
      font-size: 12px;
    }

    /* =====================================================
       WISHLIST GRID
    ===================================================== */

    .wishlist-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    /* =====================================================
       PRODUCT CARD
    ===================================================== */

    .card {
      background: var(--surface);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      border: 2px solid var(--border-soft);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      display: flex;
      flex-direction: column;
      animation: cardIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    @keyframes cardIn {
      0% { opacity: 0; transform: translateY(20px) scale(0.97); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 3;
    }

    .card:hover::before {
      transform: scaleX(1);
    }

    .card:hover {
      transform: translateY(-8px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    /* =====================================================
       PRODUCT IMAGE
    ===================================================== */

    .product-image {
      width: 100%;
      height: 280px;
      background: linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      overflow: hidden;
      position: relative;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .card:hover .product-image img {
      transform: scale(1.07);
    }

    .image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
      justify-content: center;
      font-size: 46px;
      color: var(--text-light);
      opacity: 0.6;
    }

    /* =====================================================
       CARD CONTENT
    ===================================================== */

    .card-content {
      padding: 20px 18px 18px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .card-content h3 {
      font-family: var(--font-serif);
      font-size: 17px;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 8px;
      line-height: 1.35;
      letter-spacing: -0.3px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .category {
      color: var(--text-light);
      font-size: 10.5px;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .category i {
      color: var(--mango-deep);
      font-size: 10px;
    }

    .condition {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      color: var(--forest-3);
      padding: 6px 13px;
      border-radius: 30px;
      font-size: 10px;
      margin-bottom: 14px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      border: 1px solid rgba(16, 185, 129, 0.2);
      width: fit-content;
    }

    .condition::before {
      content: "♻️";
      font-size: 11px;
    }

    .price {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -0.6px;
      margin-bottom: 18px;
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px dashed var(--border);
    }

    /* =====================================================
       ACTIONS
    ===================================================== */

    .actions {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      font-family: inherit;
      border: none;
      cursor: pointer;
    }

    .cart-btn {
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(13, 59, 46, 0.2);
    }

    .cart-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .cart-btn:hover::before { left: 100%; }

    .cart-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(13, 59, 46, 0.32);
      gap: 12px;
    }

    .remove-btn {
      background: rgba(249, 115, 98, 0.08);
      color: var(--coral-deep);
      border: 1.5px solid rgba(249, 115, 98, 0.22);
    }

    .remove-btn:hover {
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      color: #ffffff;
      border-color: transparent;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(249, 115, 98, 0.3);
      gap: 12px;
    }

    /* =====================================================
       EMPTY WISHLIST
    ===================================================== */

    .empty-wishlist {
      background:
        radial-gradient(circle at 50% 50%, rgba(249, 115, 98, 0.06) 0%, transparent 65%),
        var(--surface);
      padding: 80px 30px;
      border-radius: var(--radius-xl);
      text-align: center;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      border: 2px dashed var(--border);
      position: relative;
      overflow: hidden;
    }

    .empty-wishlist::before {
      content: "❤️";
      position: absolute;
      font-size: 220px;
      opacity: 0.04;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .empty-icon {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      color: var(--coral);
      margin: 0 auto 22px;
      box-shadow: 0 12px 32px rgba(249, 115, 98, 0.2);
      position: relative;
      z-index: 2;
    }

    .empty-wishlist h2 {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.6px;
      margin-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .empty-wishlist p {
      color: var(--text-muted);
      margin-bottom: 26px;
      font-size: 14.5px;
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.65;
      position: relative;
      z-index: 2;
    }

    .shop-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 15px 30px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      z-index: 2;
      overflow: hidden;
    }

    .shop-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .shop-btn:hover::before { left: 100%; }

    .shop-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    /* =====================================================
       CLEAR WISHLIST
    ===================================================== */

    .clear-container {
      text-align: center;
      margin-top: 34px;
      padding-top: 26px;
      border-top: 1px dashed var(--border);
      position: relative;
      z-index: 2;
    }

    .clear-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--coral-deep);
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      padding: 12px 24px;
      border-radius: var(--radius-sm);
      border: 1.5px solid rgba(249, 115, 98, 0.22);
      background: rgba(249, 115, 98, 0.04);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .clear-btn:hover {
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      color: #ffffff;
      border-color: transparent;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(249, 115, 98, 0.28);
      gap: 14px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1000px) {

      .wishlist-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .product-image {
        height: 260px;
      }

    }

    @media (max-width: 750px) {

      .wishlist-container {
        width: 94%;
        margin: 32px auto 60px;
      }

      .wishlist-header h1 {
        font-size: 34px;
      }

      .wishlist-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
      }

      .product-image {
        height: 220px;
      }

      .card-content {
        padding: 14px 13px 14px;
      }

      .card-content h3 {
        font-size: 15px;
      }

      .price {
        font-size: 19px;
      }

    }

    @media (max-width: 500px) {

      .wishlist-container {
        width: 94%;
        margin: 24px auto 60px;
      }

      .wishlist-header {
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
      }

      .wishlist-header h1 {
        font-size: 26px;
        letter-spacing: -1px;
      }

      .header-eyebrow {
        font-size: 10px;
        padding: 6px 12px;
        letter-spacing: 1.5px;
      }

      .wishlist-header p {
        font-size: 13px;
      }

      .wishlist-count {
        width: 100%;
        justify-content: center;
        padding: 11px 18px;
        font-size: 12px;
      }

      .wishlist-grid {
        grid-template-columns: 1fr;
      }

      .product-image {
        height: 300px;
      }

      .card-content h3 {
        font-size: 16px;
      }

      .price {
        font-size: 20px;
      }

      .btn {
        padding: 11px 14px;
        font-size: 12px;
      }

      .empty-wishlist {
        padding: 55px 22px;
      }

      .empty-icon {
        width: 72px;
        height: 72px;
        font-size: 30px;
      }

      .empty-wishlist h2 {
        font-size: 22px;
      }

      .shop-btn {
        width: 100%;
        justify-content: center;
        padding: 13px 22px;
        font-size: 12.5px;
      }

    }

  </style>
</head>

<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="wishlist-container">


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="wishlist-header" data-reveal="down">

      <div class="header-text">

        <span class="header-eyebrow">
          Saved Items
        </span>

        <h1>
          My <em>Wishlist.</em>
        </h1>

        <p>
          Your favourite picks, saved for later. Move them to your cart
          when you're ready or remove them anytime.
        </p>

      </div>


      <span class="wishlist-count">

        <i class="fas fa-heart"></i>

        <%= wishlist ? wishlist.length : 0 %>
        <%= (wishlist && wishlist.length === 1) ? "Item" : "Items" %>

      </span>

    </div>


    <!-- =================================================
         EMPTY WISHLIST
    ================================================== -->

    <% if (!wishlist || wishlist.length === 0) { %>


      <div class="empty-wishlist" data-reveal="zoom-up">

        <div class="empty-icon">
          <i class="fas fa-heart"></i>
        </div>

        <h2>
          Your Wishlist is Empty
        </h2>

        <p>
          Save your favourite clothes here and buy them later — tap the
          heart on any product to add it to your wishlist.
        </p>

        <a href="/products" class="shop-btn">
          <i class="fas fa-shopping-bag"></i>
          Continue Shopping
        </a>

      </div>


    <!-- =================================================
         WISHLIST PRODUCTS
    ================================================== -->

    <% } else { %>


      <div class="wishlist-grid">

        <% wishlist.forEach((product, index) => { %>


          <div
            class="card"
            data-reveal="zoom-up"
            data-delay="<%= Math.min(index * 70, 400) %>"
          >


            <!-- =============================================
                 PRODUCT IMAGE
            ============================================== -->

            <div class="product-image">

              <% if (product.images && product.images.length > 0) { %>

                <img
                  src="<%= typeof product.images[0] === 'string'
                    ? product.images[0]
                    : product.images[0].url %>"
                  alt="<%= product.name %>"
                  loading="lazy"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                >

                <div
                  class="image-placeholder"
                  style="display:none;"
                >
                  <i class="fas fa-tshirt"></i>
                  <span style="font-size:12px;opacity:0.6;">No Image</span>
                </div>

              <% } else { %>

                <div class="image-placeholder">
                  <i class="fas fa-tshirt"></i>
                  <span style="font-size:12px;opacity:0.6;">No Image</span>
                </div>

              <% } %>

            </div>


            <!-- =============================================
                 PRODUCT DETAILS
            ============================================== -->

            <div class="card-content">

              <h3>
                <%= product.name %>
              </h3>


              <div class="category">

                <i class="fas fa-tag"></i>

                <%= product.category || "Clothing" %>

              </div>


              <% if (product.condition) { %>

                <span class="condition">

                  <%= String(product.condition).replace(/_/g, " ") %>

                </span>

              <% } %>


              <div class="price">
                ₹<%= Number(product.price || 0).toLocaleString("en-IN") %>
              </div>


              <!-- =========================================
                   ACTIONS
              ========================================= -->

              <div class="actions">

                <a
                  href="/wishlist/move-to-cart/<%= product._id %>"
                  class="btn cart-btn"
                >
                  <i class="fas fa-shopping-cart"></i>
                  Move to Cart
                </a>

                <a
                  href="/wishlist/remove/<%= product._id %>"
                  class="btn remove-btn"
                  onclick="return confirm('Remove this product from wishlist?')"
                >
                  <i class="fas fa-trash-alt"></i>
                  Remove
                </a>

              </div>


            </div>

          </div>

        <% }) %>


      </div>


      <!-- =================================================
           CLEAR WISHLIST
      ================================================== -->

      <div class="clear-container">

        <a
          href="/wishlist/clear"
          class="clear-btn"
          onclick="return confirm('Are you sure you want to clear your wishlist?')"
        >
          <i class="fas fa-trash-alt"></i>
          Clear Entire Wishlist
        </a>

      </div>


    <% } %>


  </main>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ===================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    console.log("Reciclaja — Wishlist page loaded ❤️");

  </script>

</body>

</html>