<!-- =========================================================
     RECICLAJA - GLOBAL HEAD PARTIAL
========================================================= -->

<!-- Character Encoding -->
<meta charset="UTF-8">


<!-- Responsive Design -->
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>


<!-- Website Title -->
<title>
  <%= typeof title !== 'undefined' ? title + ' | Reciclaja' : 'Reciclaja - New & Pre-Loved Clothes' %>
</title>


<!-- =========================================================
     FAVICON
     Browser tab me Reciclaja ka logo show hoga
========================================================= -->

<link
  rel="icon"
  type="image/png"
  href="/image/logo/logo3.png"
>

<link
  rel="shortcut icon"
  type="image/png"
  href="/image/logo/logo3.png"
>

<link
  rel="apple-touch-icon"
  href="/image/logo/logo3.png"
>


<!-- =========================================================
     SEO
========================================================= -->

<meta
  name="description"
  content="Reciclaja is a marketplace for new and pre-loved clothes. Buy, sell and recycle clothes easily."
>

<meta
  name="keywords"
  content="Reciclaja, clothes, pre-loved clothes, second hand clothes, buy clothes, sell clothes, recycle clothes"
>

<meta
  name="author"
  content="Reciclaja"
>


<!-- =========================================================
     THEME COLOR
========================================================= -->

<meta
  name="theme-color"
  content="#111111"
>


<!-- =========================================================
     FONT AWESOME
========================================================= -->

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>


<!-- =========================================================
     GOOGLE FONT
========================================================= -->

<link
  rel="preconnect"
  href="https://fonts.googleapis.com"
>

<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
>

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
>


<!-- =========================================================
     GLOBAL CSS
     
     Agar tumhari CSS file public/css/style.css me hai
========================================================= -->

<link
  rel="stylesheet"
  href="/css/style.css"
>