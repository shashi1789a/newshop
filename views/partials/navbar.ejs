<!-- =========================================================
     RECICLAJA NAVBAR
========================================================= -->

<!-- TOP PROMO BAR -->
<div class="top-banner">
  <div class="container">
    <span>
      <i class="fas fa-bolt"></i>
      Super Sale is Live — Get 50% Off on Selected Products
    </span>

    <a href="/products/shop">
      Shop Now
      <i class="fas fa-arrow-right"></i>
    </a>
  </div>
</div>


<!-- =========================================================
     MAIN HEADER
========================================================= -->

<header class="main-header">

  <div class="container header-inner">

    <!-- LOGO -->
    <a href="/" class="logo">

      <img
        src="/image/logo/logo1.png"
        alt="Reciclaja"
        class="logo-image"
      />

    </a>


    <!-- SEARCH -->
    <form
      action="/products/shop"
      method="GET"
      class="search-wrap"
    >

      <i class="fas fa-search search-icon"></i>

      <input
        type="search"
        name="search"
        placeholder="Search clothes, brands and more..."
        autocomplete="off"
      />

      <button
        type="submit"
        aria-label="Search"
      >
        Search
      </button>

    </form>


    <!-- RIGHT SIDE -->
    <div class="nav-actions">

      <!-- WISHLIST -->
      <% if (typeof user !== "undefined" && user) { %>

        <a
          href="/wishlist"
          class="nav-action"
          title="Wishlist"
        >
          <i class="far fa-heart"></i>
          <span>Wishlist</span>
        </a>


        <!-- CART -->
        <a
          href="/cart"
          class="nav-action cart-action"
          title="Shopping Cart"
        >

          <i class="fas fa-shopping-bag"></i>

          <span>Cart</span>

          <% if (
            user.cart &&
            user.cart.length > 0
          ) { %>

            <span class="cart-badge">
              <%= user.cart.length %>
            </span>

          <% } %>

        </a>

      <% } else { %>

        <!-- GUEST WISHLIST -->
        <a
          href="/auth/login"
          class="nav-action"
          title="Wishlist"
        >
          <i class="far fa-heart"></i>
          <span>Wishlist</span>
        </a>


        <!-- GUEST CART -->
        <a
          href="/auth/login"
          class="nav-action"
          title="Cart"
        >
          <i class="fas fa-shopping-bag"></i>
          <span>Cart</span>
        </a>

      <% } %>


      <!-- ACCOUNT -->
      <div class="account-wrapper">

        <% if (typeof user !== "undefined" && user) { %>

          <button
            type="button"
            class="account-button"
            onclick="toggleAccountMenu()"
          >

            <i class="far fa-user-circle"></i>

            <span>
              <%= user.name || "Account" %>
            </span>

            <i class="fas fa-chevron-down"></i>

          </button>


          <!-- ACCOUNT DROPDOWN -->

          <div
            class="account-dropdown"
            id="accountDropdown"
          >

            <div class="account-header">

              <div class="account-avatar">
                <i class="fas fa-user"></i>
              </div>

              <div>
                <strong>
                  <%= user.name || "User" %>
                </strong>

                <small>
                  <%= user.email %>
                </small>
              </div>

            </div>


            <div class="dropdown-divider"></div>


            <a href="/profile">
              <i class="far fa-user"></i>
              My Profile
            </a>


            <a href="/orders/userOrders">
              <i class="fas fa-box"></i>
              My Orders
            </a>


            <a href="/wishlist">
              <i class="far fa-heart"></i>
              My Wishlist
            </a>


            <a href="/cart">
              <i class="fas fa-shopping-cart"></i>
              My Cart
            </a>


            <div class="dropdown-divider"></div>


            <!-- SELLER -->
            <% if (
              user.role === "seller" ||
              user.role === "admin"
            ) { %>

              <a href="/owner">
                <i class="fas fa-store"></i>
                Seller Dashboard
              </a>

            <% } %>


            <a href="/old-clothes/upload">
              <i class="fas fa-tshirt"></i>
              Sell Pre-Loved Clothes
            </a>


            <div class="dropdown-divider"></div>


            <a
              href="/auth/logout"
              class="logout-link"
            >
              <i class="fas fa-sign-out-alt"></i>
              Logout
            </a>

          </div>

        <% } else { %>

          <!-- GUEST ACCOUNT -->

          <a
            href="/auth/login"
            class="login-button"
          >
            <i class="far fa-user"></i>
            Login
          </a>

          <a
            href="/auth/register"
            class="register-button"
          >
            Register
          </a>

        <% } %>

      </div>

    </div>

  </div>

</header>


<!-- =========================================================
     CATEGORY NAVIGATION
========================================================= -->

<nav class="category-bar">

  <div class="container category-inner">

    <a
      href="/products/shop"
      class="category-all"
    >
      <i class="fas fa-bars"></i>
      All Categories
    </a>


    <a href="/products/shop">
      New Clothes
    </a>


    <a href="/old-clothes">
      Pre-Loved
    </a>


    <a href="/products/shop?category=tshirts">
      T-Shirts
    </a>


    <a href="/products/shop?category=shirts">
      Shirts
    </a>


    <a href="/products/shop?category=jeans">
      Jeans
    </a>


    <a href="/products/shop?category=dresses">
      Dresses
    </a>


    <a href="/products/shop?category=jackets">
      Jackets
    </a>


    <a href="/products/shop?category=hoodies">
      Hoodies
    </a>


    <a href="/products/shop?category=kidswear">
      Kids Wear
    </a>


    <a href="/aboutus">
      About Us
    </a>


    <a href="/contact">
      Contact
    </a>

  </div>

</nav>


<!-- =========================================================
     RECICLAJA NAVBAR CSS — Redesigned
========================================================= -->

<style>

/* =========================================================
   TOKENS
========================================================= */

:root {
  --forest: #0d3b2e;
  --forest-2: #14523f;
  --forest-3: #1e6b52;
  --forest-soft: #2d8a6a;
  --forest-deep: #072a20;

  --emerald: #10b981;
  --emerald-soft: #34d399;

  --mango: #f59e0b;
  --mango-soft: #fbbf24;
  --mango-deep: #d97706;

  --coral: #f97362;
  --coral-soft: #fb9585;
  --coral-deep: #e05a44;

  --bg: #fbfaf7;
  --surface: #ffffff;
  --surface-2: #f7f4ee;

  --text: #10261d;
  --text-muted: #556b5f;
  --text-light: #8a9a90;

  --border: #e6e0d4;
  --border-soft: #f0ebe0;

  --radius: 12px;
  --radius-sm: 10px;

  --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
  --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
  --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
  --shadow-mango: 0 12px 32px rgba(245, 158, 11, 0.28);
}

* {
  box-sizing: border-box;
}


/* =========================================================
   MAIN HEADER
========================================================= */

.main-header {
  background: #ffffff;
  border-bottom: 1px solid var(--border-soft);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 1px 0 rgba(13, 59, 46, 0.02);
}

.container {
  width: 100%;
  max-width: 1280px;
  margin: auto;
  padding: 0 24px;
}


/* =========================================================
   TOP BANNER
========================================================= */

.top-banner {
  background:
    radial-gradient(circle at 15% 50%, rgba(245, 158, 11, 0.18) 0%, transparent 40%),
    radial-gradient(circle at 85% 50%, rgba(16, 185, 129, 0.15) 0%, transparent 40%),
    linear-gradient(100deg, var(--forest) 0%, var(--forest-2) 50%, var(--forest-3) 100%);

  color: #ffffff;
  padding: 10px 0;
  font-size: 13.5px;
  font-weight: 500;
  position: relative;
  overflow: hidden;
}

.top-banner::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(251, 191, 36, 0.18),
    transparent
  );
  animation: bannerShimmer 5s infinite;
  pointer-events: none;
}

@keyframes bannerShimmer {
  0% { left: -100%; }
  100% { left: 200%; }
}

.top-banner .container {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  position: relative;
  z-index: 2;
  flex-wrap: wrap;
}

.top-banner i {
  color: var(--mango-soft);
}

.top-banner span i {
  margin-right: 4px;
}

.top-banner a {
  color: var(--mango-soft);
  font-weight: 800;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 30px;
  background: rgba(251, 191, 36, 0.12);
  border: 1px solid rgba(251, 191, 36, 0.25);
  transition: all 0.3s ease;
  font-size: 12px;
  letter-spacing: 0.3px;
}

.top-banner a:hover {
  background: rgba(251, 191, 36, 0.25);
  transform: translateX(3px);
  gap: 10px;
}


/* =========================================================
   HEADER LAYOUT
========================================================= */

.header-inner {
  min-height: 82px;
  display: flex;
  align-items: center;
  gap: 24px;
}


/* =========================================================
   LOGO
========================================================= */

.logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 8px 12px;
  border-radius: 12px;
  transition: all 0.3s ease;
  position: relative;
}

.logo:hover {
  background: var(--surface-2);
}

.logo-image {
  width: auto;
  height: 60px;
  max-width: 200px;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.logo:hover .logo-image {
  transform: scale(1.04);
}


/* =========================================================
   SEARCH
========================================================= */

.search-wrap {
  flex: 1;
  max-width: 640px;
  height: 48px;
  display: flex;
  align-items: center;
  background: var(--surface-2);
  border: 2px solid transparent;
  border-radius: 26px;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.search-wrap:focus-within {
  background: #ffffff;
  border-color: var(--mango);
  box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.12);
}

.search-icon {
  margin-left: 18px;
  color: var(--text-light);
  font-size: 15px;
  transition: color 0.3s ease;
}

.search-wrap:focus-within .search-icon {
  color: var(--mango-deep);
}

.search-wrap input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: 0 14px;
  font-size: 14px;
  color: var(--text);
  font-family: inherit;
}

.search-wrap input::placeholder {
  color: var(--text-light);
}

.search-wrap button {
  height: 100%;
  border: none;
  padding: 0 26px;
  background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%);
  color: var(--forest);
  font-weight: 800;
  font-size: 13px;
  letter-spacing: 0.3px;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  margin: 4px;
  border-radius: 22px;
}

.search-wrap button::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.4),
    transparent
  );
  transition: left 0.5s ease;
}

.search-wrap button:hover::before {
  left: 100%;
}

.search-wrap button:hover {
  box-shadow: 0 6px 18px rgba(245, 158, 11, 0.35);
}


/* =========================================================
   NAV ACTIONS
========================================================= */

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-left: auto;
}

.nav-action {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  padding: 10px 14px;
  border-radius: 12px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-action i {
  font-size: 19px;
  transition: transform 0.3s ease;
}

.nav-action:hover {
  background: var(--surface-2);
  color: var(--forest);
}

.nav-action:hover i {
  color: var(--mango-deep);
  transform: scale(1.1) translateY(-1px);
}

.cart-action:hover {
  background: rgba(245, 158, 11, 0.08);
}


/* CART BADGE */

.cart-badge {
  position: absolute;
  top: 2px;
  right: 6px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
  color: #ffffff;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 8px rgba(249, 115, 98, 0.4);
  border: 2px solid #ffffff;
  animation: badgePop 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes badgePop {
  0% { transform: scale(0.5); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}


/* =========================================================
   ACCOUNT
========================================================= */

.account-wrapper {
  position: relative;
}

.account-button {
  border: none;
  background: transparent;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  padding: 10px 14px;
  border-radius: 12px;
  transition: all 0.3s ease;
  font-family: inherit;
}

.account-button:hover {
  background: var(--surface-2);
  color: var(--forest);
}

.account-button > i:first-child {
  font-size: 22px;
  color: var(--forest-3);
  transition: transform 0.3s ease;
}

.account-button:hover > i:first-child {
  transform: scale(1.08);
}

.account-button > i:last-child {
  font-size: 10px;
  color: var(--text-light);
  transition: transform 0.3s ease;
}

.account-button[aria-expanded="true"] > i:last-child,
.account-dropdown.show ~ .account-button > i:last-child {
  transform: rotate(180deg);
}


/* Login / Register buttons */

.login-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
  color: #ffffff;
  padding: 11px 20px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.2px;
  box-shadow: 0 6px 18px rgba(13, 59, 46, 0.22);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(13, 59, 46, 0.32);
  gap: 10px;
}

.register-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--forest);
  border: 2px solid var(--forest);
  padding: 9px 18px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 700;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: #ffffff;
}

.register-button:hover {
  background: var(--forest);
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(13, 59, 46, 0.22);
}


/* =========================================================
   ACCOUNT DROPDOWN
========================================================= */

.account-dropdown {
  display: none;
  position: absolute;
  right: 0;
  top: calc(100% + 14px);
  width: 280px;
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow:
    0 20px 48px rgba(13, 59, 46, 0.15),
    0 4px 12px rgba(13, 59, 46, 0.05);
  overflow: hidden;
  transform-origin: top right;
  z-index: 100;
}

.account-dropdown.show {
  display: block;
  animation: dropdownIn 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes dropdownIn {
  0% {
    opacity: 0;
    transform: scale(0.94) translateY(-8px);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}


.account-dropdown::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(
    90deg,
    var(--mango) 0%,
    var(--coral) 50%,
    var(--emerald) 100%
  );
}


/* Account header */

.account-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px 16px 14px;
  background:
    radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.06) 0%, transparent 60%),
    linear-gradient(135deg, var(--surface-2) 0%, #ffffff 100%);
}

.account-avatar {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 16px;
  flex-shrink: 0;
  box-shadow: 0 6px 16px rgba(245, 158, 11, 0.28);
}

.account-header strong {
  display: block;
  font-size: 14px;
  color: var(--forest);
  font-weight: 800;
  margin-bottom: 2px;
  letter-spacing: -0.2px;
}

.account-header small {
  display: block;
  color: var(--text-light);
  font-size: 11.5px;
  max-width: 175px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* Dropdown links */

.account-dropdown a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 18px;
  color: var(--text);
  font-size: 13.5px;
  font-weight: 600;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.account-dropdown a i {
  width: 18px;
  font-size: 14px;
  color: var(--text-light);
  transition: all 0.25s ease;
  text-align: center;
}

.account-dropdown a::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 0;
  background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
  border-radius: 0 3px 3px 0;
  transition: height 0.3s ease;
}

.account-dropdown a:hover {
  background: var(--surface-2);
  color: var(--forest);
  padding-left: 22px;
}

.account-dropdown a:hover::before {
  height: 60%;
}

.account-dropdown a:hover i {
  color: var(--mango-deep);
  transform: scale(1.1);
}


.dropdown-divider {
  height: 1px;
  background: var(--border-soft);
  margin: 4px 12px;
}


.logout-link {
  color: var(--coral-deep) !important;
}

.logout-link i {
  color: var(--coral-deep) !important;
}

.logout-link:hover {
  background: rgba(249, 115, 98, 0.08) !important;
  color: var(--coral-deep) !important;
}

.logout-link:hover::before {
  background: var(--coral-deep) !important;
}

.logout-link:hover i {
  color: var(--coral-deep) !important;
}


/* =========================================================
   CATEGORY BAR
========================================================= */

.category-bar {
  background: #ffffff;
  border-bottom: 1px solid var(--border-soft);
  overflow-x: auto;
  white-space: nowrap;
  position: sticky;
  top: 82px;
  z-index: 999;
  scrollbar-width: none;
}

.category-bar::-webkit-scrollbar {
  display: none;
}

.category-inner {
  display: flex;
  align-items: center;
  gap: 4px;
  min-height: 50px;
}


.category-inner a {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 600;
  padding: 10px 14px;
  border-radius: 10px;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  white-space: nowrap;
}


.category-inner a::after {
  content: "";
  position: absolute;
  bottom: 4px;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
  border-radius: 2px;
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}


.category-inner a:hover {
  color: var(--forest);
  background: var(--surface-2);
}


.category-inner a:hover::after {
  width: 40%;
}


/* Category "All" pill */

.category-all {
  background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%) !important;
  color: #ffffff !important;
  padding: 10px 16px !important;
  border-radius: 12px !important;
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700 !important;
  box-shadow: 0 4px 12px rgba(13, 59, 46, 0.2);
  transition: all 0.3s ease !important;
  margin-right: 8px;
}

.category-all::after {
  display: none !important;
}

.category-all:hover {
  background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%) !important;
  color: var(--forest) !important;
  transform: translateY(-1px);
  box-shadow: 0 8px 20px rgba(245, 158, 11, 0.35);
}

.category-all i {
  font-size: 13px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .nav-action span {
    display: none;
  }

  .account-button span {
    display: none;
  }

  .header-inner {
    gap: 14px;
  }

  .nav-actions {
    gap: 4px;
  }

  .nav-action {
    padding: 10px 12px;
  }

}


@media (max-width: 850px) {

  .header-inner {
    flex-wrap: wrap;
    padding-top: 12px;
    padding-bottom: 12px;
    gap: 12px;
  }

  .logo-image {
    height: 50px;
  }

  .search-wrap {
    order: 3;
    flex-basis: 100%;
    max-width: none;
    height: 44px;
  }

  .search-wrap button {
    padding: 0 20px;
    font-size: 12px;
  }

  .category-inner {
    gap: 0;
  }

