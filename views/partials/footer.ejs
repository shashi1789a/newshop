<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reciclaja — Footer</title>
</head>
<body>

<!-- =========================================================
     RECICLAJA FOOTER — Premium Redesign
========================================================= -->

<footer class="reciclaja-footer">

  <!-- Decorative glow orbs -->
  <div class="footer-glow footer-glow-1"></div>
  <div class="footer-glow footer-glow-2"></div>

  <div class="footer-main">

    <div class="footer-container">

      <!-- =====================================================
           BRAND
      ====================================================== -->

      <div class="footer-column footer-brand">

        <a href="/" class="footer-logo">

          <img
            src="/image/logo/logo1.png"
            alt="Reciclaja"
          >

        </a>

        <p class="footer-description">
          Where new fashion meets pre-loved treasures.
          Shop smart, sell responsibly, and give clothes
          a second life with Reciclaja.
        </p>

        <!-- Sustainability badge -->
        <div class="brand-badge">
          <i class="fas fa-leaf"></i>
          <span>100% Sustainable Fashion</span>
        </div>

        <div class="footer-social">

          <a href="#" aria-label="Instagram" class="social-instagram">
            <i class="fab fa-instagram"></i>
          </a>

          <a href="#" aria-label="Facebook" class="social-facebook">
            <i class="fab fa-facebook-f"></i>
          </a>

          <a href="#" aria-label="Twitter" class="social-twitter">
            <i class="fab fa-twitter"></i>
          </a>

          <a href="#" aria-label="Pinterest" class="social-pinterest">
            <i class="fab fa-pinterest-p"></i>
          </a>

        </div>

      </div>


      <!-- =====================================================
           SHOP
      ====================================================== -->

      <div class="footer-column">

        <h4>
          <span class="h4-icon"><i class="fas fa-shopping-bag"></i></span>
          Shop
        </h4>

        <ul>

          <li>
            <a href="/products/shop">
              New Clothes
            </a>
          </li>

          <li>
            <a href="/old-clothes">
              Pre-Loved Clothes
            </a>
          </li>

          <li>
            <a href="/products/shop?category=tshirts">
              T-Shirts
            </a>
          </li>

          <li>
            <a href="/products/shop?category=shirts">
              Shirts
            </a>
          </li>

          <li>
            <a href="/products/shop?category=jeans">
              Jeans
            </a>
          </li>

          <li>
            <a href="/products/shop?category=dresses">
              Dresses
            </a>
          </li>

          <li>
            <a href="/products/shop?category=jackets">
              Jackets
            </a>
          </li>

          <li>
            <a href="/products/shop?category=hoodies">
              Hoodies
            </a>
          </li>

          <li>
            <a href="/products/shop?category=kidswear">
              Kids Wear
            </a>
          </li>

        </ul>

      </div>


      <!-- =====================================================
           ACCOUNT
      ====================================================== -->

      <div class="footer-column">

        <h4>
          <span class="h4-icon"><i class="far fa-user"></i></span>
          My Account
        </h4>

        <ul>

          <li>
            <a href="/profile">
              <i class="far fa-user"></i>
              My Profile
            </a>
          </li>

          <li>
            <a href="/orders/userOrders">
              <i class="fas fa-box"></i>
              My Orders
            </a>
          </li>

          <li>
            <a href="/wishlist">
              <i class="far fa-heart"></i>
              My Wishlist
            </a>
          </li>

          <li>
            <a href="/cart">
              <i class="fas fa-shopping-bag"></i>
              My Cart
            </a>
          </li>

          <li>
            <a href="/auth/login">
              <i class="fas fa-sign-in-alt"></i>
              Login
            </a>
          </li>

          <li>
            <a href="/auth/register">
              <i class="fas fa-user-plus"></i>
              Create Account
            </a>
          </li>

        </ul>

      </div>


      <!-- =====================================================
           SELL WITH US
      ====================================================== -->

      <div class="footer-column">

        <h4>
          <span class="h4-icon"><i class="fas fa-store"></i></span>
          Sell With Us
        </h4>

        <ul>

          <li>
            <a href="/old-clothes/upload">
              <i class="fas fa-tshirt"></i>
              Sell Pre-Loved Clothes
            </a>
          </li>

          <li>
            <a href="/products/create">
              <i class="fas fa-plus-circle"></i>
              Sell New Clothes
            </a>
          </li>

          <li>
            <a href="/owner">
              <i class="fas fa-store"></i>
              Seller Dashboard
            </a>
          </li>

        </ul>


        <h4 class="footer-sub-heading">
          <span class="h4-icon"><i class="fas fa-life-ring"></i></span>
          Help & Support
        </h4>

        <ul>

          <li>
            <a href="/aboutus">
              <i class="fas fa-info-circle"></i>
              About Us
            </a>
          </li>

          <li>
            <a href="/contact">
              <i class="fas fa-headset"></i>
              Contact Us
            </a>
          </li>

        </ul>

      </div>


      <!-- =====================================================
           NEWSLETTER
      ====================================================== -->

      <div class="footer-column newsletter-column">

        <h4>
          <span class="h4-icon"><i class="far fa-envelope"></i></span>
          Join Reciclaja
        </h4>

        <p>
          Get updates about new arrivals, pre-loved
          collections, exclusive offers and sustainable fashion.
        </p>


        <form
          class="newsletter-form"
          action="#"
          method="POST"
        >

          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            required
          >

          <button
            type="submit"
            aria-label="Subscribe"
          >

            <i class="fas fa-arrow-right"></i>

          </button>

        </form>


        <!-- SUSTAINABILITY FEATURE -->

        <div class="footer-feature">

          <div class="feature-icon">

            <i class="fas fa-recycle"></i>

          </div>

          <div>

            <strong>
              Fashion With A Purpose
            </strong>

            <span>
              Buy better. Wear longer. Reuse responsibly.
            </span>

          </div>

        </div>


        <!-- PAYMENT -->

        <div class="secure-payment">

          <span>
            <i class="fas fa-lock"></i>
            Secure & Safe Payments
          </span>

          <div class="payment-icons">

            <i class="fab fa-cc-visa"></i>

            <i class="fab fa-cc-mastercard"></i>

            <i class="fab fa-cc-amex"></i>

            <i class="fas fa-credit-card"></i>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- =========================================================
       BOTTOM BAR
  ========================================================== -->

  <div class="footer-bottom">

    <div class="footer-bottom-inner">

      <p>
        © <%= new Date().getFullYear() %>
        <strong>Reciclaja</strong>. All rights reserved.
      </p>


      <div class="footer-legal">

        <a href="#">
          Privacy Policy
        </a>

        <a href="#">
          Terms & Conditions
        </a>

        <a href="#">
          Shipping Policy
        </a>

        <a href="#">
          Return Policy
        </a>

      </div>

    </div>

  </div>

</footer>


<!-- =========================================================
     RECICLAJA FOOTER CSS — Premium Redesign
========================================================= -->

<style>

/* =========================================================
   ROOT TOKENS
========================================================= */

.reciclaja-footer {

  /* Brand palette */
  --forest: #0d3b2e;
  --forest-2: #14523f;
  --forest-3: #1e6b52;
  --forest-deep: #072a20;

  --emerald: #10b981;
  --emerald-soft: #34d399;

  --mango: #f59e0b;
  --mango-soft: #fbbf24;
  --mango-deep: #d97706;

  --coral: #f97362;
  --coral-soft: #fb9585;

  /* Surfaces */
  --text-primary: #ffffff;
  --text-secondary: #b8d4c8;
  --text-muted: #7a9b8c;

  --border-line: rgba(255, 255, 255, 0.08);
  --border-soft: rgba(255, 255, 255, 0.05);

  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(16, 185, 129, 0.08) 0%,
      transparent 40%
    ),
    radial-gradient(
      circle at 85% 90%,
      rgba(245, 158, 11, 0.08) 0%,
      transparent 40%
    ),
    linear-gradient(
      160deg,
      #072a20 0%,
      #0d3b2e 35%,
      #0a2e24 100%
    );

  color: var(--text-secondary);

  margin-top: 80px;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    'Segoe UI',
    Roboto,
    Helvetica,
    Arial,
    sans-serif;

  position: relative;

  overflow: hidden;

}


/* =========================================================
   DECORATIVE GLOW ORBS
========================================================= */

.footer-glow {

  position: absolute;

  border-radius: 50%;

  pointer-events: none;

  filter: blur(80px);

  opacity: 0.4;

}


.footer-glow-1 {

  width: 400px;
  height: 400px;

  top: -150px;
  left: -150px;

  background:
    radial-gradient(
      circle,
      rgba(16, 185, 129, 0.4) 0%,
      transparent 70%
    );

}


.footer-glow-2 {

  width: 350px;
  height: 350px;

  bottom: -120px;
  right: -100px;

  background:
    radial-gradient(
      circle,
      rgba(245, 158, 11, 0.35) 0%,
      transparent 70%
    );

}


/* =========================================================
   MAIN
========================================================= */

.footer-main {

  position: relative;

  z-index: 2;

}


/* Top gradient accent line */

.footer-main::before {

  content: "";

  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 3px;

  background:
    linear-gradient(
      90deg,
      transparent 0%,
      var(--emerald) 20%,
      var(--mango) 50%,
      var(--coral) 80%,
      transparent 100%
    );

  opacity: 0.8;

}


.footer-container {

  width: 100%;

  max-width: 1280px;

  margin: auto;

  padding: 70px 24px 55px;

  display: grid;

  grid-template-columns:
    1.6fr
    1fr
    1fr
    1fr
    1.5fr;

  gap: 44px;

  position: relative;

}


/* =========================================================
   LOGO
========================================================= */

.footer-logo {

  display: inline-flex;

  align-items: center;

  margin-bottom: 22px;

  padding: 10px 16px;

  background: rgba(255, 255, 255, 0.04);

  border: 1px solid var(--border-line);

  border-radius: 14px;

  backdrop-filter: blur(10px);

  transition: all 0.3s ease;

}


.footer-logo:hover {

  background: rgba(255, 255, 255, 0.07);

  border-color: rgba(245, 158, 11, 0.3);

  transform: translateY(-2px);

}


.footer-logo img {

  width: auto;

  height: 48px;

  max-width: 180px;

  object-fit: contain;

  filter: brightness(1.05);

}


.footer-description {

  color: var(--text-secondary);

  font-size: 13px;

  line-height: 1.75;

  max-width: 300px;

  margin: 0 0 20px;

}


/* =========================================================
   BRAND BADGE
========================================================= */

.brand-badge {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 8px 14px;

  background: rgba(16, 185, 129, 0.12);

  border: 1px solid rgba(16, 185, 129, 0.25);

  border-radius: 30px;

  margin-bottom: 22px;

  font-size: 11px;

  font-weight: 700;

  color: var(--emerald-soft);

  letter-spacing: 0.5px;

}


.brand-badge i {

  font-size: 12px;

  color: var(--emerald-soft);

}


/* =========================================================
   SOCIAL
========================================================= */

.footer-social {

  display: flex;

  gap: 10px;

  flex-wrap: wrap;

}


.footer-social a {

  width: 40px;

  height: 40px;

  border-radius: 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: rgba(255, 255, 255, 0.05);

  border: 1px solid var(--border-line);

  color: #ffffff;

  text-decoration: none;

  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

  font-size: 15px;

}


.footer-social a:hover {

  transform: translateY(-4px) scale(1.05);

  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);

}


.social-instagram:hover {

  background:
    linear-gradient(
      135deg,
      #f58529 0%,
      #dd2a7b 50%,
      #8134af 100%
    );

  border-color: transparent;

  color: #ffffff;

}


.social-facebook:hover {

  background: #1877f2;

  border-color: transparent;

  color: #ffffff;

}


.social-twitter:hover {

  background: #1da1f2;

  border-color: transparent;

  color: #ffffff;

}


.social-pinterest:hover {

  background: #e60023;

  border-color: transparent;

  color: #ffffff;

}


/* =========================================================
   HEADINGS
========================================================= */

.footer-column h4 {

  color: var(--text-primary);

  font-size: 14px;

  font-weight: 800;

  margin: 0 0 22px;

  letter-spacing: 0.3px;

  display: flex;

  align-items: center;

  gap: 10px;

  text-transform: uppercase;

}


.h4-icon {

  width: 28px;

  height: 28px;

  border-radius: 8px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  background:
    linear-gradient(
      135deg,
      rgba(245, 158, 11, 0.18) 0%,
      rgba(249, 115, 98, 0.12) 100%
    );

  color: var(--mango-soft);

  font-size: 12px;

  flex-shrink: 0;

}


.footer-sub-heading {

  margin-top: 30px !important;

}


/* =========================================================
   LIST
========================================================= */

.footer-column ul {

  list-style: none;

  margin: 0;

  padding: 0;

}


.footer-column ul li {

  margin-bottom: 11px;

}


.footer-column ul li a {

  color: var(--text-secondary);

  text-decoration: none;

  font-size: 13px;

  display: inline-flex;

  align-items: center;

  gap: 10px;

  transition: all 0.25s ease;

  padding: 2px 0;

  position: relative;

}


.footer-column ul li a::before {

  content: "";

  position: absolute;

  left: -12px;

  top: 50%;

  transform: translateY(-50%);

  width: 4px;

  height: 4px;

  border-radius: 50%;

  background: var(--mango);

  opacity: 0;

  transition: all 0.25s ease;

}


.footer-column ul li a:hover {

  color: var(--mango-soft);

  transform: translateX(6px);

}


.footer-column ul li a:hover::before {

  opacity: 1;

  left: -8px;

}


.footer-column ul li a i {

  width: 16px;

  font-size: 12px;

  color: var(--text-muted);

  transition: color 0.25s ease;

}


.footer-column ul li a:hover i {

  color: var(--mango-soft);

}


/* =========================================================
   NEWSLETTER
========================================================= */

.newsletter-column > p {

  color: var(--text-secondary);

  font-size: 13px;

  line-height: 1.7;

  margin: 0 0 20px;

}


.newsletter-form {

  height: 50px;

  display: flex;

  border: 1px solid var(--border-line);

  border-radius: 12px;

  overflow: hidden;

  background: rgba(0, 0, 0, 0.25);

  margin-bottom: 24px;

  transition: all 0.3s ease;

  position: relative;

}


.newsletter-form:focus-within {

  border-color: var(--mango);

  box-shadow:
    0 0 0 4px rgba(245, 158, 11, 0.1),
    0 8px 24px rgba(245, 158, 11, 0.15);

}


.newsletter-form input {

  flex: 1;

  min-width: 0;

  border: none;

  outline: none;

  background: transparent;

  color: #ffffff;

  padding: 0 16px;

  font-size: 13px;

  font-family: inherit;

}


.newsletter-form input::placeholder {

  color: var(--text-muted);

}


.newsletter-form button {

  width: 54px;

  border: none;

  background:
    linear-gradient(
      135deg,
      var(--mango) 0%,
      var(--mango-soft) 100%
    );

  color: var(--forest-deep);

  cursor: pointer;

  transition: all 0.25s ease;

  font-size: 14px;

  display: flex;

  align-items: center;

  justify-content: center;

}


.newsletter-form button:hover {

  background:
    linear-gradient(
      135deg,
      var(--mango-soft) 0%,
      var(--coral-soft) 100%
    );

  transform: scale(1.05);

}


/* =========================================================
   RECYCLE FEATURE
========================================================= */

.footer-feature {

  display: flex;

  align-items: center;

  gap: 12px;

  background:
    linear-gradient(
      135deg,
      rgba(16, 185, 129, 0.08) 0%,
      rgba(13, 59, 46, 0.15) 100%
    );

  border: 1px solid rgba(16, 185, 129, 0.2);

  border-radius: 14px;

  padding: 14px;

  transition: all 0.3s ease;

}


.footer-feature:hover {

  border-color: rgba(16, 185, 129, 0.4);

  transform: translateY(-2px);

  box-shadow: 0 8px 24px rgba(16, 185, 129, 0.15);

}


.feature-icon {

  width: 42px;

  height: 42px;

  flex-shrink: 0;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      var(--emerald) 0%,
      var(--forest-3) 100%
    );

  display: flex;

  align-items: center;

  justify-content: center;

  color: #ffffff;

  font-size: 16px;

  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);

}


.footer-feature strong {

  display: block;

  color: var(--text-primary);

  font-size: 12px;

  margin-bottom: 4px;

  font-weight: 700;

  letter-spacing: 0.2px;

}


.footer-feature span {

  display: block;

  color: var(--text-muted);

  font-size: 10.5px;

  line-height: 1.5;

}


/* =========================================================
   PAYMENT
========================================================= */

.secure-payment {

  margin-top: 20px;

}


.secure-payment > span {

  display: flex;

  align-items: center;

  gap: 6px;

  color: var(--text-secondary);

  font-size: 11.5px;

  margin-bottom: 12px;

  font-weight: 500;

}


.secure-payment > span i {

  color: var(--mango-soft);

  font-size: 12px;

}


.payment-icons {

  display: flex;

  align-items: center;

  gap: 12px;

  flex-wrap: wrap;

}


.payment-icons i {

  color: var(--text-secondary);

  font-size: 24px;

  opacity: 0.7;

  transition: all 0.25s ease;

  cursor: pointer;

}


.payment-icons i:hover {

  opacity: 1;

  color: var(--mango-soft);

  transform: translateY(-2px);

}


/* =========================================================
   BOTTOM
========================================================= */

.footer-bottom {

  border-top: 1px solid var(--border-line);

  background: rgba(0, 0, 0, 0.15);

  position: relative;

  z-index: 2;

}


.footer-bottom-inner {

  max-width: 1280px;

  margin: auto;

  padding: 22px 24px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

}


.footer-bottom p {

  margin: 0;

  color: var(--text-muted);

  font-size: 12px;

  letter-spacing: 0.2px;

}


.footer-bottom p strong {

  color: var(--mango-soft);

  font-weight: 700;

  letter-spacing: 0.5px;

}


.footer-legal {

  display: flex;

  align-items: center;

  gap: 24px;

  flex-wrap: wrap;

}


.footer-legal a {

  color: var(--text-muted);

  text-decoration: none;

  font-size: 12px;

  transition: all 0.25s ease;

  position: relative;

  padding: 2px 0;

}


.footer-legal a::after {

  content: "";

  position: absolute;

  bottom: 0;

  left: 0;

  width: 0;

  height: 1px;

  background: var(--mango-soft);

  transition: width 0.3s ease;

}


.footer-legal a:hover {

  color: var(--mango-soft);

}


.footer-legal a:hover::after {

  width: 100%;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

  .footer-container {

    grid-template-columns:
      1.5fr
      1fr
      1fr
      1fr;

    gap: 36px;

  }

  .newsletter-column {

    grid-column: 1 / -1;

    max-width: 640px;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .footer-container {

    grid-template-columns: 1fr;

    padding: 50px 20px 40px;

    gap: 36px;

  }


  .footer-brand {

    text-align: center;

  }


  .footer-brand .footer-logo {

    justify-content: center;

  }


  .footer-description {

    max-width: 460px;

    margin-left: auto;

    margin-right: auto;

  }


  .brand-badge {

    margin-left: auto;

    margin-right: auto;

  }


  .footer-social {

    justify-content: center;

  }


  .footer-column h4 {

    justify-content: flex-start;

  }


  .newsletter-column {

    grid-column: auto;

    max-width: none;

  }


  .footer-bottom-inner {

    flex-direction: column;

    text-align: center;

    padding: 22px 15px;

  }


  .footer-legal {

    justify-content: center;

    gap: 14px 20px;

  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 400px) {

  .footer-container {

    padding: 40px 15px 32px;

  }


  .footer-logo img {

    height: 42px;

  }


  .footer-social a {

    width: 36px;

    height: 36px;

    font-size: 14px;

  }


  .footer-legal {

    flex-direction: column;

    gap: 10px;

  }


  .payment-icons i {

    font-size: 20px;

  }

}

</style>

</body>
</html>