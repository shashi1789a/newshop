<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <%- include('../partials/head') %>

  <title>Reciclaja | New & Pre-Loved Fashion</title>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
        Roboto, Helvetica, Arial, sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a {
      text-decoration: none;
      color: inherit;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    button {
      font-family: inherit;
      cursor: pointer;
    }

    img {
      display: block;
      max-width: 100%;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="left"] { transform: translateX(-40px); }
    [data-reveal="right"] { transform: translateX(40px); }
    [data-reveal="zoom"] { transform: scale(0.9); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       CONTAINER
    ===================================================== */

    .container {
      width: 92%;
      max-width: 1280px;
      margin: auto;
    }

    /* =====================================================
       SALE BANNER
    ===================================================== */

    .sale-banner {
      background: linear-gradient(
        100deg,
        var(--forest) 0%,
        var(--forest-3) 40%,
        var(--forest-soft) 70%,
        var(--emerald) 100%
      );

      color: #ffffff;
      padding: 12px 20px;
      text-align: center;
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.6px;
      position: relative;
      overflow: hidden;
    }

    .sale-banner::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.25),
        transparent
      );
      animation: shimmer 4s infinite;
    }

    @keyframes shimmer {
      0% { left: -100%; }
      100% { left: 200%; }
    }

    .sale-banner span {
      color: var(--mango-soft);
      font-weight: 800;
      letter-spacing: 1px;
    }

    /* =====================================================
       HERO
    ===================================================== */

    .hero {
      margin: 32px 0 40px;
      min-height: 460px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      position: relative;

      background:
        radial-gradient(circle at 80% 20%, rgba(245, 158, 11, 0.15) 0%, transparent 45%),
        radial-gradient(circle at 20% 90%, rgba(16, 185, 129, 0.12) 0%, transparent 50%),
        linear-gradient(135deg, #fff7e8 0%, #fef0db 35%, #e8f5ee 100%);

      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      box-shadow: var(--shadow-lg);
    }

    .hero-content {
      padding: 60px 56px;
      position: relative;
      z-index: 2;
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      color: var(--forest-3);
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 22px;
      border: 1px solid rgba(13, 59, 46, 0.08);
    }

    .hero-label::before {
      content: "♻️";
      font-size: 13px;
    }

    .hero h1 {
      font-family: var(--font-serif);
      font-size: 60px;
      line-height: 1.02;
      color: var(--forest);
      margin-bottom: 20px;
      font-weight: 500;
      letter-spacing: -2px;
    }

    .hero h1 span {
      font-style: italic;
      background: linear-gradient(
        120deg,
        var(--mango-deep) 0%,
        var(--coral) 60%,
        var(--mango) 100%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
      display: inline-block;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 16px;
      max-width: 470px;
      margin-bottom: 32px;
      line-height: 1.7;
    }

    .hero-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .hero-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 15px 30px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.3px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .hero-btn.primary {
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      box-shadow: 0 8px 24px rgba(13, 59, 46, 0.25);
    }

    .hero-btn.primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(13, 59, 46, 0.35);
    }

    .hero-btn.primary::after {
      content: "→";
      transition: transform 0.3s ease;
      margin-left: 2px;
    }

    .hero-btn.primary:hover::after {
      transform: translateX(4px);
    }

    .hero-btn.secondary {
      background: #ffffff;
      color: var(--forest);
      border: 2px solid var(--forest);
      box-shadow: var(--shadow-sm);
    }

    .hero-btn.secondary:hover {
      background: var(--forest);
      color: #ffffff;
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(13, 59, 46, 0.2);
    }

    .hero-fashion {
      position: relative;
      height: 100%;
      min-height: 460px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-fashion::before {
      content: "";
      position: absolute;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      background: linear-gradient(145deg, var(--mango-soft) 0%, var(--coral-soft) 100%);
      opacity: 0.55;
      filter: blur(40px);
      animation: pulse 5s ease-in-out infinite;
    }

    .hero-fashion::after {
      content: "";
      position: absolute;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: linear-gradient(145deg, var(--emerald-soft) 0%, var(--forest-soft) 100%);
      opacity: 0.4;
      filter: blur(50px);
      top: 15%;
      right: 5%;
      animation: pulse 7s ease-in-out infinite reverse;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.5; }
      50% { transform: scale(1.1); opacity: 0.7; }
    }

    .hero-fashion-icon {
      font-size: 150px;
      color: var(--forest);
      position: relative;
      z-index: 2;
      animation: float 6s ease-in-out infinite;
      filter: drop-shadow(0 20px 30px rgba(13, 59, 46, 0.15));
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-16px); }
    }

    /* =====================================================
       CATEGORY
    ===================================================== */

    .category-section {
      margin: 56px 0;
    }

    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 26px;
    }

    .section-title h2 {
      font-family: var(--font-serif);
      font-size: 34px;
      color: var(--forest);
      font-weight: 500;
      letter-spacing: -0.8px;
      line-height: 1.15;
      position: relative;
      padding-left: 20px;
    }

    .section-title h2::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 5px;
      height: 70%;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 4px;
    }

    .section-title a {
      color: var(--forest-3);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.3px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 30px;
      background: rgba(16, 185, 129, 0.08);
      transition: all 0.3s ease;
    }

    .section-title a:hover {
      background: var(--forest);
      color: #ffffff;
      gap: 10px;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .category-card {
      background: #ffffff;
      border: 2px solid transparent;
      border-radius: var(--radius);
      padding: 28px 18px;
      text-align: center;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
    }

    .category-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .category-card:hover::before {
      transform: scaleX(1);
    }

    .category-card:hover {
      transform: translateY(-8px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .category-icon {
      width: 68px;
      height: 68px;
      margin: 0 auto 16px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      color: var(--forest);
      background: linear-gradient(145deg, var(--mint) 0%, var(--mint-2) 100%);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }

    .category-card:nth-child(2) .category-icon {
      background: linear-gradient(145deg, var(--blush) 0%, var(--blush-2) 100%);
      color: var(--coral);
    }

    .category-card:nth-child(3) .category-icon {
      background: linear-gradient(145deg, #eef4ff 0%, #dbe7ff 100%);
      color: #4f6df5;
    }

    .category-card:nth-child(4) .category-icon {
      background: linear-gradient(145deg, #fff5e0 0%, #ffe8b8 100%);
      color: var(--mango-deep);
    }

    .category-card:nth-child(5) .category-icon {
      background: linear-gradient(145deg, #e8f4ff 0%, #d0e6ff 100%);
      color: #2b7de0;
    }

    .category-card:nth-child(6) .category-icon {
      background: linear-gradient(145deg, #ffe8f0 0%, #ffd0e0 100%);
      color: #e05a8a;
    }

    .category-card:nth-child(7) .category-icon {
      background: linear-gradient(145deg, #f0e8ff 0%, #e0d0ff 100%);
      color: #7c5ce0;
    }

    .category-card:nth-child(8) .category-icon {
      background: linear-gradient(145deg, #e8f5ee 0%, #d0ebdc 100%);
      color: var(--forest-3);
    }

    .category-card:hover .category-icon {
      transform: rotate(-8deg) scale(1.1);
    }

    .category-card h3 {
      font-size: 14.5px;
      color: var(--forest);
      margin-bottom: 4px;
      font-weight: 700;
      letter-spacing: -0.2px;
    }

    .category-card p {
      color: var(--text-light);
      font-size: 12px;
      line-height: 1.5;
    }

    /* =====================================================
       SERVICE STRIP
    ===================================================== */

    .service-strip {
      background: linear-gradient(120deg, var(--forest) 0%, var(--forest-2) 50%, var(--forest-3) 100%);
      border-radius: var(--radius-lg);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      margin: 48px 0;
      overflow: hidden;
      box-shadow: var(--shadow-md);
      position: relative;
    }

    .service-strip::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.6), transparent);
    }

    .service {
      padding: 26px 22px;
      display: flex;
      align-items: center;
      gap: 15px;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .service::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .service:hover::before { opacity: 1; }

    .service:last-child { border-right: none; }

    .service i {
      font-size: 22px;
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: linear-gradient(145deg, rgba(251, 191, 36, 0.18) 0%, rgba(245, 158, 11, 0.08) 100%);
      color: var(--mango-soft);
      flex-shrink: 0;
      position: relative;
      z-index: 2;
    }

    .service div { position: relative; z-index: 2; }

    .service h4 {
      font-size: 13px;
      color: #ffffff;
      margin-bottom: 3px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }

    .service p {
      font-size: 11.5px;
      color: #b8d4c8;
      line-height: 1.5;
    }

    /* =====================================================
       COLLECTION BANNER
    ===================================================== */

    .collection-banner {
      background:
        radial-gradient(circle at 85% 30%, rgba(251, 191, 36, 0.22) 0%, transparent 45%),
        radial-gradient(circle at 15% 80%, rgba(16, 185, 129, 0.18) 0%, transparent 45%),
        linear-gradient(120deg, var(--forest) 0%, var(--forest-2) 60%, var(--forest-3) 100%);

      color: #ffffff;
      border-radius: var(--radius-lg);
      padding: 52px 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 48px 0;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
    }

    .collection-banner::before {
      content: "";
      position: absolute;
      top: -50%;
      right: -10%;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      border: 1px solid rgba(251, 191, 36, 0.12);
      pointer-events: none;
    }

    .collection-banner::after {
      content: "";
      position: absolute;
      bottom: -40%;
      right: 10%;
      width: 380px;
      height: 380px;
      border-radius: 50%;
      border: 1px solid rgba(16, 185, 129, 0.12);
      pointer-events: none;
    }

    .collection-content {
      position: relative;
      z-index: 2;
      max-width: 560px;
    }

    .collection-content h2 {
      font-family: var(--font-serif);
      font-size: 38px;
      margin-bottom: 14px;
      font-weight: 500;
      letter-spacing: -1px;
      line-height: 1.15;
    }

    .collection-content h2 em {
      font-style: italic;
      color: var(--mango-soft);
    }

    .collection-content p {
      color: #b8d4c8;
      font-size: 14.5px;
      margin-bottom: 26px;
      line-height: 1.7;
    }

    .collection-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%);
      color: var(--forest);
      padding: 15px 30px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.3px;
      transition: all 0.3s ease;
      box-shadow: 0 8px 24px rgba(245, 158, 11, 0.35);
    }

    .collection-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(245, 158, 11, 0.5);
      gap: 12px;
    }

    .collection-btn::after { content: "→"; }

    .collection-icon {
      font-size: 110px;
      color: var(--mango-soft);
      opacity: 0.9;
      position: relative;
      z-index: 2;
      margin-right: 10px;
      filter: drop-shadow(0 10px 30px rgba(245, 158, 11, 0.3));
      animation: float 7s ease-in-out infinite;
    }

    /* =====================================================
       PRODUCTS
    ===================================================== */

    .products-section {
      margin: 56px 0;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .product-card {
      background: #ffffff;
      border: 2px solid var(--border-soft);
      border-radius: var(--radius);
      overflow: hidden;
      position: relative;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
    }

    .product-card:hover {
      transform: translateY(-8px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .product-image {
      height: 250px;
      background: linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .product-card:hover .product-image img {
      transform: scale(1.08);
    }

    .product-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 60px;
      color: #c7d6cd;
    }

    .condition-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 6px 13px;
      border-radius: 30px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      z-index: 2;
      box-shadow: 0 4px 12px rgba(13, 59, 46, 0.25);
    }

    .product-info {
      padding: 20px 18px 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .product-type {
      color: var(--coral);
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      margin-bottom: 8px;
    }

    .product-name {
      color: var(--forest);
      font-size: 15.5px;
      font-weight: 700;
      margin-bottom: 10px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.4;
      letter-spacing: -0.2px;
    }

    .product-price {
      font-size: 20px;
      font-weight: 800;
      color: var(--forest);
      letter-spacing: -0.3px;
    }

    .product-old-price {
      font-size: 13px;
      color: var(--text-light);
      text-decoration: line-through;
      margin-left: 8px;
      font-weight: 500;
    }

    .product-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px dashed var(--border);
    }

    .view-product {
      color: var(--forest-3);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.25s ease;
    }

    .view-product::after {
      content: "→";
      transition: transform 0.25s ease;
    }

    .view-product:hover { color: var(--coral); }

    .view-product:hover::after { transform: translateX(4px); }

    .cart-button {
      border: none;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(13, 59, 46, 0.15);
    }

    .cart-button:hover {
      background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%);
      color: var(--forest);
      transform: scale(1.1) rotate(-5deg);
      box-shadow: 0 8px 20px rgba(245, 158, 11, 0.35);
    }

    /* =====================================================
       PRELOVED
    ===================================================== */

    .preloved {
      background:
        radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.1) 0%, transparent 40%),
        linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      border-radius: var(--radius-lg);
      padding: 48px 40px;
      margin: 56px 0;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(16, 185, 129, 0.15);
    }

    .preloved::before {
      content: "♻️";
      position: absolute;
      font-size: 180px;
      opacity: 0.06;
      right: -20px;
      bottom: -40px;
      transform: rotate(-15deg);
      pointer-events: none;
    }

    .preloved .section-title {
      position: relative;
      z-index: 2;
      border-bottom: 2px solid rgba(13, 59, 46, 0.08);
      padding-bottom: 20px;
      margin-bottom: 28px;
    }

    .preloved .section-title h2 { color: var(--forest); }

    .preloved .section-title h2::before {
      background: linear-gradient(180deg, var(--emerald) 0%, var(--forest-3) 100%);
    }

    .preloved .section-title a {
      background: rgba(16, 185, 129, 0.15);
      color: var(--forest-3);
    }

    .preloved .section-title a:hover {
      background: var(--forest);
      color: #ffffff;
    }

    .preloved-badge {
      color: var(--forest-3);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      display: inline-block;
      margin-bottom: 6px;
    }

    .preloved .product-card {
      background: #ffffff;
      border-color: rgba(16, 185, 129, 0.15);
    }

    .preloved .product-card:hover {
      border-color: var(--emerald);
      box-shadow: 0 20px 48px rgba(16, 185, 129, 0.15);
    }

    .preloved .condition-badge {
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
    }

    .preloved .product-type { color: var(--emerald); }

    .preloved .cart-button {
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
    }

    /* =====================================================
       SELL SECTION
    ===================================================== */

    .sell-section {
      background:
        radial-gradient(circle at 20% 20%, rgba(245, 158, 11, 0.18) 0%, transparent 45%),
        linear-gradient(120deg, #fff4e0 0%, #ffe8d0 50%, #ffdcc4 100%);
      border-radius: var(--radius-lg);
      padding: 56px 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 56px 0;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(245, 158, 11, 0.15);
    }

    .sell-section::before {
      content: "";
      position: absolute;
      top: -60px;
      left: -60px;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--mango-soft) 0%, var(--coral-soft) 100%);
      opacity: 0.25;
      filter: blur(40px);
    }

    .sell-section > div:first-child {
      position: relative;
      z-index: 2;
      max-width: 620px;
    }

    .sell-section h2 {
      color: var(--forest);
      font-family: var(--font-serif);
      font-size: 36px;
      margin-bottom: 14px;
      font-weight: 500;
      letter-spacing: -1px;
      line-height: 1.15;
    }

    .sell-section p {
      color: var(--text-muted);
      font-size: 15px;
      max-width: 560px;
      margin-bottom: 26px;
      line-height: 1.7;
    }

    .sell-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 15px 30px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.3px;
      transition: all 0.3s ease;
      box-shadow: 0 8px 24px rgba(13, 59, 46, 0.25);
    }

    .sell-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(13, 59, 46, 0.35);
      gap: 12px;
    }

    .sell-btn::after { content: "→"; }

    .sell-icon {
      font-size: 110px;
      color: var(--coral);
      opacity: 0.35;
      position: relative;
      z-index: 2;
      animation: float 8s ease-in-out infinite;
    }

    /* =====================================================
       EMPTY PRODUCTS
    ===================================================== */

    .empty-products {
      background: #ffffff;
      border: 2px dashed var(--border);
      padding: 60px 40px;
      text-align: center;
      border-radius: var(--radius);
      color: var(--text-light);
      grid-column: 1 / -1;
    }

    .empty-products i {
      font-size: 46px;
      margin-bottom: 16px;
      color: var(--mint-2);
      display: block;
    }

    .empty-products p {
      font-size: 14.5px;
      font-weight: 500;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1024px) {

      .hero h1 { font-size: 48px; }
      .hero-content { padding: 52px 44px; }
      .hero-fashion-icon { font-size: 120px; }

      .product-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .collection-content h2 { font-size: 32px; }
      .sell-section h2 { font-size: 30px; }

    }

    @media (max-width: 820px) {

      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-content { padding: 48px 36px; }
      .hero h1 { font-size: 42px; }
      .hero-fashion { display: none; }

      .product-grid { grid-template-columns: repeat(2, 1fr); }

      .service-strip { grid-template-columns: repeat(2, 1fr); }

      .service:nth-child(2) { border-right: none; }

      .service:nth-child(1),
      .service:nth-child(2) { border-bottom: 1px solid rgba(255, 255, 255, 0.08); }

      .collection-icon,
      .sell-icon { display: none; }

      .collection-banner { padding: 42px 36px; }
      .sell-section { padding: 42px 36px; }
      .preloved { padding: 38px 28px; }

      .category-grid { grid-template-columns: repeat(2, 1fr); }

      .section-title h2 { font-size: 28px; }

    }

    @media (max-width: 560px) {

      .container { width: 92%; }

      .hero {
        margin: 24px 0 32px;
        border-radius: 18px;
      }

      .hero-content { padding: 36px 24px; }
      .hero h1 { font-size: 32px; letter-spacing: -1px; }
      .hero p { font-size: 14px; }

      .hero-label {
        font-size: 10px;
        padding: 6px 12px;
        letter-spacing: 1px;
      }

      .hero-btn { padding: 13px 22px; font-size: 12px; }

      .section-title { margin-bottom: 18px; }

      .section-title h2 {
        font-size: 22px;
        padding-left: 14px;
      }

      .section-title h2::before { width: 4px; }

      .section-title a { font-size: 11px; padding: 6px 12px; }

      .category-grid { gap: 12px; }

      .category-card { padding: 20px 14px; border-radius: 12px; }

      .category-icon {
        width: 52px;
        height: 52px;
        font-size: 20px;
        border-radius: 15px;
        margin-bottom: 12px;
      }

      .category-card h3 { font-size: 12.5px; }
      .category-card p { font-size: 10.5px; }

      .product-grid { gap: 12px; }

      .product-image { height: 170px; }
      .product-info { padding: 14px 13px 13px; }
      .product-name { font-size: 13.5px; }
      .product-price { font-size: 16px; }
      .view-product { font-size: 11px; }

      .cart-button {
        width: 36px;
        height: 36px;
        font-size: 12px;
        border-radius: 10px;
      }

      .service-strip {
        grid-template-columns: 1fr;
        margin: 32px 0;
        border-radius: 16px;
      }

      .service {
        border-right: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 20px 18px;
      }

      .service:last-child { border-bottom: none; }

      .collection-banner,
      .sell-section {
        padding: 32px 24px;
        margin: 36px 0;
        border-radius: 18px;
      }

      .collection-content h2,
      .sell-section h2 { font-size: 24px; }

      .collection-content p,
      .sell-section p { font-size: 13px; }

      .collection-btn,
      .sell-btn {
        padding: 13px 22px;
        font-size: 12px;
      }

      .preloved {
        padding: 28px 18px;
        margin: 36px 0;
        border-radius: 18px;
      }

      .sale-banner {
        font-size: 11px;
        padding: 10px 14px;
      }

      .empty-products { padding: 40px 20px; }

      .empty-products i { font-size: 36px; }

    }

  </style>

</head>


<body>

  <!-- =====================================================
       SCROLL PROGRESS BAR
  ====================================================== -->

  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       SALE BANNER
  ====================================================== -->

  <div class="sale-banner">

    ✦
    <span>Reciclaja</span>
    — New & Pre-Loved Fashion at Better Prices

  </div>


  <main>

    <div class="container">


      <!-- =====================================================
           HERO
      ====================================================== -->

      <section class="hero">

        <div class="hero-content">

          <span class="hero-label" data-reveal="down">
            Fashion with a purpose
          </span>

          <h1 data-reveal="up" data-delay="80">
            Wear More.<br>
            <span>Waste Less.</span>
          </h1>

          <p data-reveal="up" data-delay="160">
            Discover new fashion, quality pre-loved
            clothes and sustainable styles — all in
            one marketplace.
          </p>

          <div class="hero-buttons" data-reveal="up" data-delay="240">

            <a href="/shop" class="hero-btn primary">
              Shop Collection
            </a>

            <a href="/products/create" class="hero-btn secondary">
              Sell Your Clothes
            </a>

          </div>

        </div>


        <div class="hero-fashion">

          <div class="hero-fashion-icon">

            <i class="fas fa-tshirt"></i>

          </div>

        </div>

      </section>


      <!-- =====================================================
           SHOP BY CATEGORY
      ====================================================== -->

      <section class="category-section">

        <div class="section-title" data-reveal="up">

          <h2>
            Shop by Category
          </h2>

          <a href="/shop">
            View All
          </a>

        </div>


        <div class="category-grid">

          <% const categories = [
            { href: '/shop?productType=NEW', icon: 'fas fa-tshirt', title: 'New Clothes', desc: 'Fresh styles & latest fashion' },
            { href: '/shop?productType=USED', icon: 'fas fa-recycle', title: 'Pre-Loved Clothes', desc: 'Quality clothes, better prices' },
            { href: '/shop?productType=USED', icon: 'fas fa-sync-alt', title: 'Reused & Recycled', desc: 'Give fashion another life' },
            { href: '/shop?category=Premium', icon: 'fas fa-crown', title: 'Premium Collection', desc: 'Curated quality pieces' },
            { href: '/shop?gender=MEN', icon: 'fas fa-male', title: 'Men', desc: 'Shirts, jeans & more' },
            { href: '/shop?gender=WOMEN', icon: 'fas fa-female', title: 'Women', desc: 'Dresses, sarees & more' },
            { href: '/shop?gender=KIDS', icon: 'fas fa-child', title: 'Kids', desc: 'Comfortable kidswear' },
            { href: '/shop?category=Shoes', icon: 'fas fa-shoe-prints', title: 'Shoes', desc: 'New & pre-loved footwear' }
          ]; %>

          <% categories.forEach((cat, i) => { %>

            <a
              href="<%= cat.href %>"
              class="category-card"
              data-reveal="zoom-up"
              data-delay="<%= i * 60 %>"
            >

              <div class="category-icon">
                <i class="<%= cat.icon %>"></i>
              </div>

              <h3><%= cat.title %></h3>
              <p><%= cat.desc %></p>

            </a>

          <% }) %>

        </div>

      </section>


      <!-- =====================================================
           SERVICES
      ====================================================== -->

      <section class="service-strip" data-reveal="zoom-up">

        <div class="service">
          <i class="fas fa-shield-alt"></i>
          <div>
            <h4>Verified Products</h4>
            <p>Quality checked listings</p>
          </div>
        </div>

        <div class="service">
          <i class="fas fa-truck"></i>
          <div>
            <h4>Easy Delivery</h4>
            <p>Reliable doorstep delivery</p>
          </div>
        </div>

        <div class="service">
          <i class="fas fa-recycle"></i>
          <div>
            <h4>Sustainable Fashion</h4>
            <p>Reduce textile waste</p>
          </div>
        </div>

        <div class="service">
          <i class="fas fa-lock"></i>
          <div>
            <h4>Secure Payments</h4>
            <p>Safe checkout experience</p>
          </div>
        </div>

      </section>


      <!-- =====================================================
           NEW COLLECTION
      ====================================================== -->

      <section class="collection-banner" data-reveal="zoom-up">

        <div class="collection-content">

          <h2>
            Fresh Styles. <em>New Stories.</em>
          </h2>

          <p>
            Explore our latest collection of
            new clothes and fashion essentials —
            carefully selected for the season ahead.
          </p>

          <a href="/shop?productType=NEW" class="collection-btn">
            Shop New Clothes
          </a>

        </div>


        <div class="collection-icon">
          <i class="fas fa-tshirt"></i>
        </div>

      </section>


      <!-- =====================================================
           NEW ARRIVALS
      ====================================================== -->

      <section class="products-section">

        <div class="section-title" data-reveal="up">

          <h2>
            New Arrivals
          </h2>

          <a href="/shop">
            See All
          </a>

        </div>


        <% if (products && products.length > 0) { %>

          <div class="product-grid">

            <% products.slice(0, 8).forEach((product, i) => { %>

              <article
                class="product-card"
                data-reveal="zoom-up"
                data-delay="<%= Math.min(i * 70, 400) %>"
              >

                <div class="product-image">

                  <% if (
                    product.images &&
                    product.images.length > 0 &&
                    product.images[0] &&
                    product.images[0].url
                  ) { %>

                    <img
                      src="<%= product.images[0].url %>"
                      alt="<%= product.name %>"
                      loading="lazy"
                    >

                  <% } else { %>

                    <div class="product-placeholder">
                      <i class="fas fa-tshirt"></i>
                    </div>

                  <% } %>

                  <span class="condition-badge">
                    <%= product.condition || product.productType || "Fashion" %>
                  </span>

                </div>


                <div class="product-info">

                  <div class="product-type">
                    <%= product.productType || "Fashion" %>
                  </div>

                  <div class="product-name">
                    <%= product.name %>
                  </div>

                  <div class="product-price">

                    ₹<%= product.price %>

                    <% if (product.originalPrice && product.originalPrice > product.price) { %>

                      <span class="product-old-price">
                        ₹<%= product.originalPrice %>
                      </span>

                    <% } %>

                  </div>

                  <div class="product-bottom">

                    <a href="/products/view/<%= product._id %>" class="view-product">
                      View Product
                    </a>

                    <button
                      type="button"
                      class="cart-button"
                      onclick="addToCart('<%= product._id %>')"
                      title="Add to Cart"
                    >
                      <i class="fas fa-shopping-cart"></i>
                    </button>

                  </div>

                </div>

              </article>

            <% }) %>

          </div>

        <% } else { %>

          <div class="empty-products">

            <i class="fas fa-tshirt"></i>

            <p>No products available right now.</p>

          </div>

        <% } %>

      </section>


      <!-- =====================================================
           PRE-LOVED PRODUCTS
      ====================================================== -->

      <section class="preloved" data-reveal="zoom-up">

        <div class="section-title">

          <div>

            <span class="preloved-badge">
              ♻️ Sustainable Choice
            </span>

            <h2>
              Pre-Loved Picks
            </h2>

          </div>

          <a href="/shop?productType=USED">
            Explore Pre-Loved
          </a>

        </div>


        <div class="product-grid">

          <% if (products && products.length > 0) { %>

            <%
              const prelovedProducts = products
                .filter(product =>
                  product.productType === "USED" ||
                  product.productType === "old-clothes" ||
                  product.productType === "second-hand" ||
                  product.condition === "USED" ||
                  product.condition === "PRE_LOVED"
                )
                .slice(0, 4);
            %>

            <% if (prelovedProducts.length > 0) { %>

              <% prelovedProducts.forEach(product => { %>

                <article class="product-card">

                  <div class="product-image">

                    <% if (
                      product.images &&
                      product.images.length > 0 &&
                      product.images[0] &&
                      product.images[0].url
                    ) { %>

                      <img
                        src="<%= product.images[0].url %>"
                        alt="<%= product.name %>"
                        loading="lazy"
                      >

                    <% } else { %>

                      <div class="product-placeholder">
                        <i class="fas fa-recycle"></i>
                      </div>

                    <% } %>

                    <span class="condition-badge">
                      Pre-Loved
                    </span>

                  </div>


                  <div class="product-info">

                    <div class="product-type">
                      <%= product.category || "Pre-Loved" %>
                    </div>

                    <div class="product-name">
                      <%= product.name %>
                    </div>

                    <div class="product-price">
                      ₹<%= product.price %>
                    </div>

                    <div class="product-bottom">

                      <a href="/products/view/<%= product._id %>" class="view-product">
                        View Product
                      </a>

                      <button
                        type="button"
                        class="cart-button"
                        onclick="addToCart('<%= product._id %>')"
                        title="Add to Cart"
                      >
                        <i class="fas fa-shopping-cart"></i>
                      </button>

                    </div>

                  </div>

                </article>

              <% }) %>

            <% } else { %>

              <div class="empty-products">

                <i class="fas fa-recycle"></i>

                <p>No pre-loved products available right now.</p>

              </div>

            <% } %>

          <% } else { %>

            <div class="empty-products">

              <i class="fas fa-recycle"></i>

              <p>No pre-loved products available right now.</p>

            </div>

          <% } %>

        </div>

      </section>


      <!-- =====================================================
           SELL YOUR CLOTHES
      ====================================================== -->

      <section class="sell-section" data-reveal="zoom-up">

        <div>

          <h2>
            Have Clothes You Don't Wear?
          </h2>

          <p>
            Turn your unused clothes into money.
            List your pre-loved clothes on Reciclaja
            and give them a new home instead of letting
            them sit unused.
          </p>

          <a href="/products/create" class="sell-btn">
            Start Selling
          </a>

        </div>

        <div class="sell-icon">
          <i class="fas fa-recycle"></i>
        </div>

      </section>


    </div>

  </main>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       ADD TO CART
    ===================================================== */

    async function addToCart(productId) {

      try {

        const response = await fetch(
          `/cart/add/${productId}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            }
          }
        );

        let data = {};

        try {
          data = await response.json();
        } catch (jsonError) {
          console.log("Response is not JSON");
        }

        if (response.ok) {
          alert(data.message || "Product added to cart!");
          return;
        }

        if (response.status === 401 || response.status === 403) {
          window.location.href = "/auth/login";
          return;
        }

        alert(data.message || "Unable to add product to cart.");

      } catch (error) {

        console.error("Add to Cart Error:", error);
        alert("Something went wrong while adding product to cart.");

      }

    }


    console.log("Reciclaja — Homepage loaded ♻️");

  </script>

</body>

</html>