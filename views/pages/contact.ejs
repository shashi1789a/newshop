<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us — Reciclaja | New & Pre-Loved Fashion</title>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.2);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(50px); }
    [data-reveal="down"] { transform: translateY(-50px); }
    [data-reveal="left"] { transform: translateX(-60px); }
    [data-reveal="right"] { transform: translateX(60px); }
    [data-reveal="zoom"] { transform: scale(0.88); }
    [data-reveal="zoom-up"] { transform: scale(0.92) translateY(40px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       HERO BANNER
    ===================================================== */

    .contact-hero {
      background:
        radial-gradient(circle at 20% 20%, rgba(245, 158, 11, 0.15) 0%, transparent 45%),
        radial-gradient(circle at 80% 80%, rgba(16, 185, 129, 0.15) 0%, transparent 45%),
        linear-gradient(135deg, var(--forest) 0%, var(--forest-2) 50%, var(--forest-3) 100%);
      padding: 80px 0 100px;
      position: relative;
      overflow: hidden;
      color: #ffffff;
      text-align: center;
    }

    .contact-hero::before {
      content: "";
      position: absolute;
      top: -50%;
      left: -10%;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      border: 1px solid rgba(251, 191, 36, 0.12);
      pointer-events: none;
    }

    .contact-hero::after {
      content: "";
      position: absolute;
      bottom: -40%;
      right: -5%;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      border: 1px solid rgba(16, 185, 129, 0.15);
      pointer-events: none;
    }

    .contact-hero-container {
      width: 90%;
      max-width: 900px;
      margin: auto;
      position: relative;
      z-index: 2;
    }

    .contact-hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(251, 191, 36, 0.15);
      border: 1px solid rgba(251, 191, 36, 0.3);
      color: var(--mango-soft);
      padding: 9px 20px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2.5px;
      margin-bottom: 24px;
    }

    .contact-hero-eyebrow i { font-size: 12px; }

    .contact-hero h1 {
      font-family: var(--font-serif);
      font-size: 62px;
      font-weight: 500;
      letter-spacing: -2px;
      line-height: 1.05;
      margin-bottom: 20px;
      color: #ffffff;
    }

    .contact-hero h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-soft) 0%, var(--coral-soft) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .contact-hero p {
      font-size: 16.5px;
      color: #b8d4c8;
      max-width: 620px;
      margin: 0 auto;
      line-height: 1.7;
    }

    /* Floating decorations */

    .contact-hero-float {
      position: absolute;
      color: var(--mango-soft);
      opacity: 0.1;
      pointer-events: none;
      animation: floatY 8s ease-in-out infinite;
    }

    .contact-hero-float.f1 { top: 20%; left: 8%; font-size: 72px; animation-delay: 0s; }
    .contact-hero-float.f2 { top: 65%; right: 10%; font-size: 60px; animation-delay: 2s; }
    .contact-hero-float.f3 { bottom: 12%; left: 15%; font-size: 48px; animation-delay: 4s; }

    @keyframes floatY {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-22px) rotate(8deg); }
    }

    /* =====================================================
       MAIN SECTION
    ===================================================== */

    .contact-section {
      padding: 70px 0 80px;
      position: relative;
    }

    .contact-container {
      width: 90%;
      max-width: 1280px;
      margin: auto;
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 40px;
      align-items: start;
    }

    /* =====================================================
       LEFT — INFO COLUMN
    ===================================================== */

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .contact-info-header h2 {
      font-family: var(--font-serif);
      font-size: 36px;
      font-weight: 500;
      color: var(--forest);
      letter-spacing: -1px;
      line-height: 1.15;
      margin-bottom: 14px;
    }

    .contact-info-header h2 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .contact-info-header p {
      font-size: 15px;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 10px;
    }

    /* Info cards */

    .info-card {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      background: #ffffff;
      padding: 22px 24px;
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      border: 2px solid transparent;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .info-card::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.4s ease;
    }

    .info-card:hover::before { transform: scaleY(1); }

    .info-card:hover {
      transform: translateX(6px);
      border-color: var(--mango);
      box-shadow: var(--shadow-mango);
    }

    .info-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      color: #ffffff;
      flex-shrink: 0;
      transition: transform 0.35s ease;
    }

    .info-card:hover .info-icon { transform: scale(1.08) rotate(-6deg); }

    .info-card.i1 .info-icon {
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .info-card.i2 .info-icon {
      background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
      box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
    }

    .info-card.i3 .info-icon {
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      box-shadow: 0 8px 20px rgba(249, 115, 98, 0.3);
    }

    .info-card.i4 .info-icon {
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.25);
    }

    .info-card-content h4 {
      font-size: 15px;
      font-weight: 800;
      color: var(--forest);
      margin-bottom: 5px;
      letter-spacing: -0.2px;
    }

    .info-card-content p {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 6px;
    }

    .info-card-content a {
      font-size: 13px;
      font-weight: 700;
      color: var(--forest-3);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .info-card-content a:hover {
      color: var(--coral);
      gap: 10px;
    }

    .info-card-content a::after {
      content: "→";
      transition: transform 0.25s ease;
    }

    /* Response time badge */

    .response-badge {
      background:
        radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.12) 0%, transparent 50%),
        linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      border-radius: var(--radius);
      padding: 22px 26px;
      border: 1px solid rgba(16, 185, 129, 0.18);
      display: flex;
      align-items: center;
      gap: 16px;
      position: relative;
      overflow: hidden;
    }

    .response-badge::before {
      content: "⚡";
      position: absolute;
      font-size: 130px;
      opacity: 0.07;
      right: -20px;
      bottom: -30px;
      pointer-events: none;
    }

    .response-badge-icon {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.25);
      position: relative;
      z-index: 2;
    }

    .response-badge-text {
      position: relative;
      z-index: 2;
    }

    .response-badge-text strong {
      display: block;
      font-size: 14px;
      color: var(--forest);
      font-weight: 800;
      margin-bottom: 3px;
      letter-spacing: -0.2px;
    }

    .response-badge-text span {
      display: block;
      font-size: 12.5px;
      color: var(--forest-3);
      line-height: 1.5;
      font-weight: 500;
    }

    /* Social links */

    .contact-social-label {
      font-size: 11px;
      font-weight: 800;
      color: var(--text-light);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-top: 8px;
      margin-bottom: 4px;
    }

    .contact-social {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .contact-social a {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: #ffffff;
      color: var(--forest);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      box-shadow: var(--shadow-sm);
      border: 2px solid transparent;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .contact-social a:hover {
      transform: translateY(-5px) scale(1.05);
      color: #ffffff;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    }

    .contact-social a:nth-child(1):hover { background: #1877f2; border-color: #1877f2; }
    .contact-social a:nth-child(2):hover { background: #1da1f2; border-color: #1da1f2; }
    .contact-social a:nth-child(3):hover {
      background: linear-gradient(135deg, #f58529 0%, #dd2a7b 50%, #8134af 100%);
      border-color: transparent;
    }
    .contact-social a:nth-child(4):hover { background: #e60023; border-color: #e60023; }

    /* =====================================================
       RIGHT — FORM CARD
    ===================================================== */

    .contact-form-card {
      background: #ffffff;
      border-radius: var(--radius-lg);
      padding: 40px 40px 36px;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border-soft);
      position: relative;
      overflow: hidden;
    }

    .contact-form-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
    }

    .contact-form-card::after {
      content: "✉️";
      position: absolute;
      font-size: 140px;
      opacity: 0.04;
      right: -20px;
      bottom: -30px;
      transform: rotate(-15deg);
      pointer-events: none;
    }

    .form-header {
      margin-bottom: 28px;
      position: relative;
      z-index: 2;
    }

    .form-header h3 {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.6px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .form-header h3 i {
      font-size: 18px;
      width: 42px;
      height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, var(--blush) 0%, var(--blush-2) 100%);
      border-radius: 12px;
      color: var(--coral);
    }

    .form-header p {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Error message */

    #error_message {
      color: var(--coral-deep);
      background: rgba(249, 115, 98, 0.08);
      border: 1px solid rgba(249, 115, 98, 0.25);
      border-radius: var(--radius-sm);
      padding: 0;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 0;
      max-height: 0;
      overflow: hidden;
      transition: all 0.35s ease;
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #error_message:not(:empty) {
      padding: 12px 16px;
      margin-bottom: 18px;
      max-height: 120px;
    }

    #error_message::before {
      content: "⚠";
      font-size: 14px;
      flex-shrink: 0;
    }

    /* Form fields */

    .form-group {
      margin-bottom: 20px;
      position: relative;
      z-index: 2;
    }

    .form-group label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--forest);
      margin-bottom: 8px;
      letter-spacing: 0.2px;
      text-transform: uppercase;
    }

    .form-group label i {
      font-size: 11px;
      color: var(--mango-deep);
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--surface-2);
      color: var(--text);
      font-family: inherit;
      font-size: 14px;
      line-height: 1.5;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      resize: vertical;
      outline: none;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--text-light);
      font-weight: 400;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-color: var(--mango);
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.12);
      transform: translateY(-1px);
    }

    .form-group textarea {
      min-height: 130px;
      resize: vertical;
    }

    /* Two-column row */

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    /* Submit button */

    .submit-btn {
      width: 100%;
      padding: 16px 30px;
      border: none;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      font-family: inherit;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.6px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.28);
      position: relative;
      overflow: hidden;
      margin-top: 4px;
      z-index: 2;
    }

    .submit-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(251, 191, 36, 0.3),
        transparent
      );
      transition: left 0.6s ease;
    }

    .submit-btn:hover::before {
      left: 100%;
    }

    .submit-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    .submit-btn i {
      transition: transform 0.3s ease;
    }

    .submit-btn:hover i {
      transform: translateX(4px);
    }

    /* Form footer note */

    .form-note {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px dashed var(--border);
      font-size: 12.5px;
      color: var(--text-light);
      display: flex;
      align-items: center;
      gap: 10px;
      position: relative;
      z-index: 2;
    }

    .form-note i {
      color: var(--emerald);
      font-size: 14px;
    }

    /* =====================================================
       FAQ SECTION
    ===================================================== */

    .faq-section {
      padding: 20px 0 80px;
    }

    .faq-container {
      width: 90%;
      max-width: 1280px;
      margin: auto;
    }

    .faq-header {
      text-align: center;
      margin-bottom: 44px;
    }

    .faq-header h2 {
      font-family: var(--font-serif);
      font-size: 40px;
      font-weight: 500;
      color: var(--forest);
      letter-spacing: -1.2px;
      line-height: 1.15;
      margin-bottom: 12px;
    }

    .faq-header h2 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .faq-header p {
      font-size: 15px;
      color: var(--text-muted);
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.7;
    }

    .faq-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .faq-item {
      background: #ffffff;
      border-radius: var(--radius);
      padding: 28px 26px;
      box-shadow: var(--shadow-sm);
      border: 2px solid transparent;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .faq-item::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .faq-item:hover::before { transform: scaleX(1); }

    .faq-item:hover {
      transform: translateY(-6px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .faq-item h4 {
      font-size: 15.5px;
      font-weight: 800;
      color: var(--forest);
      margin-bottom: 10px;
      letter-spacing: -0.2px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }

    .faq-item h4 i {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, var(--mint) 0%, var(--mint-2) 100%);
      color: var(--forest-3);
      border-radius: 10px;
      font-size: 13px;
    }

    .faq-item p {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.7;
      padding-left: 44px;
      margin: 0;
    }

    /* =====================================================
       MAP / LOCATION BANNER
    ===================================================== */

    .location-banner {
      background:
        radial-gradient(circle at 85% 30%, rgba(251, 191, 36, 0.25) 0%, transparent 45%),
        radial-gradient(circle at 15% 80%, rgba(16, 185, 129, 0.2) 0%, transparent 45%),
        linear-gradient(120deg, var(--forest) 0%, var(--forest-2) 60%, var(--forest-3) 100%);
      border-radius: var(--radius-xl);
      padding: 48px 48px;
      color: #ffffff;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      flex-wrap: wrap;
    }

    .location-banner::before {
      content: "";
      position: absolute;
      top: -50%;
      right: -10%;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      border: 1px solid rgba(251, 191, 36, 0.15);
      pointer-events: none;
    }

    .location-banner-content {
      position: relative;
      z-index: 2;
      max-width: 620px;
    }

    .location-banner-content h3 {
      font-family: var(--font-serif);
      font-size: 32px;
      font-weight: 500;
      letter-spacing: -0.8px;
      margin-bottom: 12px;
      color: #ffffff;
      line-height: 1.2;
    }

    .location-banner-content h3 em {
      font-style: italic;
      color: var(--mango-soft);
    }

    .location-banner-content p {
      font-size: 14.5px;
      color: #b8d4c8;
      line-height: 1.7;
      margin-bottom: 22px;
    }

    .location-banner-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%);
      color: var(--forest);
      padding: 14px 28px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.3px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 8px 24px rgba(245, 158, 11, 0.35);
    }

    .location-banner-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(245, 158, 11, 0.5);
      gap: 14px;
    }

    .location-banner-icon {
      font-size: 100px;
      color: var(--mango-soft);
      opacity: 0.35;
      position: relative;
      z-index: 2;
      animation: floatY 8s ease-in-out infinite;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media screen and (max-width: 1024px) {

      .contact-hero h1 { font-size: 52px; }

      .contact-container {
        grid-template-columns: 1fr;
        gap: 48px;
      }

      .contact-form-card { padding: 36px 32px 32px; }

    }

    @media screen and (max-width: 768px) {

      .contact-hero { padding: 60px 0 80px; }

      .contact-hero h1 { font-size: 40px; letter-spacing: -1.3px; }

      .contact-hero p { font-size: 15px; }

      .contact-hero-float { display: none; }

      .contact-section { padding: 50px 0 60px; }

      .contact-info-header h2 { font-size: 28px; }

      .faq-header h2 { font-size: 30px; }

      .faq-grid { grid-template-columns: 1fr; }

      .form-row { grid-template-columns: 1fr; gap: 0; }

      .form-header h3 { font-size: 24px; }

      .location-banner { padding: 36px 30px; }

      .location-banner-content h3 { font-size: 26px; }

      .location-banner-icon { display: none; }

    }

    @media screen and (max-width: 560px) {

      .contact-hero { padding: 50px 0 70px; }

      .contact-hero h1 { font-size: 32px; letter-spacing: -1px; }

      .contact-hero-eyebrow { font-size: 10px; padding: 7px 14px; letter-spacing: 1.8px; }

      .contact-hero p { font-size: 13.5px; }

      .contact-info-header h2 { font-size: 24px; }

      .info-card { padding: 18px 20px; gap: 14px; }

      .info-icon { width: 46px; height: 46px; font-size: 17px; }

      .info-card-content h4 { font-size: 14px; }

      .info-card-content p { font-size: 12.5px; }

      .response-badge { padding: 18px 20px; gap: 14px; }

      .response-badge-icon { width: 44px; height: 44px; font-size: 17px; }

      .response-badge-text strong { font-size: 13px; }

      .response-badge-text span { font-size: 11.5px; }

      .contact-social a { width: 42px; height: 42px; font-size: 15px; }

      .contact-form-card { padding: 28px 22px 26px; border-radius: 20px; }

      .form-header h3 { font-size: 21px; }

      .form-header h3 i { width: 36px; height: 36px; font-size: 15px; }

      .form-header p { font-size: 13px; }

      .form-group input,
      .form-group textarea { padding: 12px 14px; font-size: 13.5px; }

      .submit-btn { padding: 14px 22px; font-size: 13px; }

      .form-note { font-size: 11.5px; }

      .faq-header h2 { font-size: 24px; }

      .faq-header p { font-size: 13.5px; }

      .faq-item { padding: 22px 20px; }

      .faq-item h4 { font-size: 14px; gap: 10px; }

      .faq-item h4 i { width: 28px; height: 28px; font-size: 12px; }

      .faq-item p { font-size: 12.5px; padding-left: 38px; }

      .location-banner { padding: 28px 22px; border-radius: 20px; }

      .location-banner-content h3 { font-size: 22px; }

      .location-banner-content p { font-size: 13px; }

      .location-banner-btn { padding: 12px 22px; font-size: 12.5px; width: 100%; justify-content: center; }

    }

  </style>

  <%- include('../partials/head') %>

</head>

<body>

  <!-- SCROLL PROGRESS -->

  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- NAVBAR -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       HERO BANNER
  ====================================================== -->

  <section class="contact-hero">

    <i class="fas fa-envelope contact-hero-float f1"></i>
    <i class="fas fa-comments contact-hero-float f2"></i>
    <i class="fas fa-paper-plane contact-hero-float f3"></i>

    <div class="contact-hero-container">

      <span class="contact-hero-eyebrow" data-reveal="down">
        <i class="fas fa-headset"></i>
        We'd Love to Hear From You
      </span>

      <h1 data-reveal="up" data-delay="100">
        Let's <em>talk.</em>
      </h1>

      <p data-reveal="up" data-delay="200">
        Questions about an order? Suggestions for a feature? Want to partner
        with us? Drop us a line — our friendly team replies within 24 hours.
      </p>

    </div>

  </section>


  <!-- =====================================================
       MAIN CONTACT SECTION
  ====================================================== -->

  <section class="contact-section">

    <div class="contact-container">

      <!-- =====================================================
           LEFT — INFO COLUMN
      ====================================================== -->

      <div class="contact-info">

        <div class="contact-info-header">

          <h2 data-reveal="left">
            Reach us, <em>anytime.</em>
          </h2>

          <p data-reveal="left" data-delay="80">
            Whether you need help with an order, want to sell with us, or
            just want to say hello — we're here for you.
          </p>

        </div>


        <!-- Info Cards -->

        <div class="info-card i1" data-reveal="left" data-delay="0">
          <div class="info-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <div class="info-card-content">
            <h4>Email Us</h4>
            <p>Our inbox is checked throughout the day.</p>
            <a href="mailto:hello@reciclaja.com">hello@reciclaja.com</a>
          </div>
        </div>

        <div class="info-card i2" data-reveal="left" data-delay="80">
          <div class="info-icon">
            <i class="fas fa-phone-alt"></i>
          </div>
          <div class="info-card-content">
            <h4>Call Us</h4>
            <p>Mon – Sat, 9 AM to 6 PM IST</p>
            <a href="tel:+919876543210">+91 98765 43210</a>
          </div>
        </div>

        <div class="info-card i3" data-reveal="left" data-delay="160">
          <div class="info-icon">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <div class="info-card-content">
            <h4>Visit Us</h4>
            <p>Reciclaja HQ, 3rd Floor, Green Tower<br>Bandra West, Mumbai — 400050</p>
            <a href="#">Get Directions</a>
          </div>
        </div>

        <div class="info-card i4" data-reveal="left" data-delay="240">
          <div class="info-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="info-card-content">
            <h4>Working Hours</h4>
            <p>Monday – Saturday: 9:00 AM – 6:00 PM<br>Sunday: Closed</p>
          </div>
        </div>


        <!-- Response Badge -->

        <div class="response-badge" data-reveal="zoom-up" data-delay="0">
          <div class="response-badge-icon">
            <i class="fas fa-bolt"></i>
          </div>
          <div class="response-badge-text">
            <strong>Fast Response Promise</strong>
            <span>We reply to every message within 24 hours — usually much faster.</span>
          </div>
        </div>


        <!-- Social -->

        <div class="contact-social-label" data-reveal="up">
          Follow Us
        </div>

        <div class="contact-social" data-reveal="up" data-delay="80">

          <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
          <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="#" aria-label="Pinterest"><i class="fab fa-pinterest-p"></i></a>

        </div>

      </div>


      <!-- =====================================================
           RIGHT — FORM CARD
      ====================================================== -->

      <div class="contact-form-card" data-reveal="right" data-delay="200">

        <div class="form-header">
          <h3>
            <i class="fas fa-paper-plane"></i>
            Send a Message
          </h3>
          <p>Fill in the details below and we'll get back to you shortly.</p>
        </div>

        <div id="error_message"></div>

        <form
          id="myform"
          action="/contact"
          method="POST"
          onsubmit="return validate();"
        >

          <div class="form-row">

            <div class="form-group">
              <label for="name">
                <i class="fas fa-user"></i>
                Your Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="e.g. Aarav Mehta"
                autocomplete="name"
              />
            </div>

            <div class="form-group">
              <label for="phone">
                <i class="fas fa-phone"></i>
                Phone
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="10-digit number"
                autocomplete="tel"
              />
            </div>

          </div>

          <div class="form-group">
            <label for="email">
              <i class="fas fa-envelope"></i>
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="subject">
              <i class="fas fa-tag"></i>
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="What's this about?"
            />
          </div>

          <div class="form-group">
            <label for="message">
              <i class="fas fa-comment-dots"></i>
              Your Message
            </label>
            <textarea
              id="message"
              name="message"
              placeholder="Tell us what's on your mind..."
              rows="5"
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">
            Send Message
            <i class="fas fa-arrow-right"></i>
          </button>

          <div class="form-note">
            <i class="fas fa-shield-alt"></i>
            <span>Your information is kept private and never shared.</span>
          </div>

        </form>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FAQ SECTION
  ====================================================== -->

  <section class="faq-section">

    <div class="faq-container">

      <div class="faq-header">

        <h2 data-reveal="up">
          Frequently asked <em>questions.</em>
        </h2>

        <p data-reveal="up" data-delay="80">
          Quick answers to the things people ask us the most. Can't find
          what you're looking for? Send us a message above.
        </p>

      </div>

      <div class="faq-grid">

        <div class="faq-item" data-reveal="zoom-up" data-delay="0">
          <h4>
            <i class="fas fa-truck"></i>
            How long does delivery take?
          </h4>
          <p>
            Standard delivery takes 3–5 business days across India. Metro
            cities usually receive orders within 2–3 days. All shipments
            are tracked and carbon-neutral.
          </p>
        </div>

        <div class="faq-item" data-reveal="zoom-up" data-delay="80">
          <h4>
            <i class="fas fa-undo-alt"></i>
            What's your return policy?
          </h4>
          <p>
            You can return any item within 7 days of delivery if it doesn't
            match the description. Pre-loved items are quality-checked, but
            we still offer hassle-free returns.
          </p>
        </div>

        <div class="faq-item" data-reveal="zoom-up" data-delay="160">
          <h4>
            <i class="fas fa-tag"></i>
            How do I sell my clothes?
          </h4>
          <p>
            Head to the "Sell" section, upload photos and details, set your
            price, and publish. Once someone buys, we handle the shipping
            and payment — you just get paid.
          </p>
        </div>

        <div class="faq-item" data-reveal="zoom-up" data-delay="240">
          <h4>
            <i class="fas fa-shield-alt"></i>
            Are pre-loved items verified?
          </h4>
          <p>
            Yes — every pre-loved listing is reviewed for quality, hygiene,
            and authenticity before it goes live. You can shop with total
            confidence on Reciclaja.
          </p>
        </div>

        <div class="faq-item" data-reveal="zoom-up" data-delay="320">
          <h4>
            <i class="fas fa-lock"></i>
            Is my payment secure?
          </h4>
          <p>
            Absolutely. All payments go through encrypted, PCI-compliant
            gateways. We never store your card details on our servers.
          </p>
        </div>

        <div class="faq-item" data-reveal="zoom-up" data-delay="400">
          <h4>
            <i class="fas fa-leaf"></i>
            How is Reciclaja sustainable?
          </h4>
          <p>
            Every purchase keeps clothing out of landfills, our packaging
            is plastic-free, and we plant a tree for every item sold. It's
            fashion that gives back.
          </p>
        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       LOCATION BANNER
  ====================================================== -->

  <section class="faq-container" style="padding-bottom: 80px;">

    <div class="location-banner" data-reveal="zoom-up">

      <div class="location-banner-content">

        <h3>
          Prefer to visit our <em>studio?</em>
        </h3>

        <p>
          Come say hello at our Mumbai HQ. Try on pre-loved pieces in person,
          drop off items you'd like to sell, and meet the team behind
          Reciclaja.
        </p>

        <a href="#" class="location-banner-btn">
          <i class="fas fa-map-marked-alt"></i>
          Get Directions
        </a>

      </div>

      <i class="fas fa-map-marked-alt location-banner-icon"></i>

    </div>

  </section>


  <!-- FOOTER -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPTS
  ====================================================== -->

  <script>

    /* =====================================================
       1. SCROLL PROGRESS BAR
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       2. SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       3. FORM VALIDATION
    ===================================================== */

    function validate() {

      var name = document.getElementById("name").value.trim();
      var phone = document.getElementById("phone").value.trim();
      var email = document.getElementById("email").value.trim();
      var subject = document.getElementById("subject").value.trim();
      var message = document.getElementById("message").value.trim();
      var error_message = document.getElementById("error_message");

      error_message.innerHTML = "";

      if (name.length < 3) {
        error_message.innerHTML = "Please enter a valid name (at least 3 characters).";
        focusField('name');
        return false;
      }

      if (phone.length !== 10 || isNaN(phone)) {
        error_message.innerHTML = "Please enter a valid 10-digit phone number.";
        focusField('phone');
        return false;
      }

      if (email.indexOf("@") === -1 || email.length < 6) {
        error_message.innerHTML = "Please enter a valid email address.";
        focusField('email');
        return false;
      }

      if (subject.length < 2) {
        error_message.innerHTML = "Please enter a subject.";
        focusField('subject');
        return false;
      }

      if (message.length < 5) {
        error_message.innerHTML = "Please write a message (at least 5 characters).";
        focusField('message');
        return false;
      }

      return true;

    }

    function focusField(id) {
      var el = document.getElementById(id);
      if (el) {
        el.focus();
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }


    /* =====================================================
       4. HERO PARALLAX
    ===================================================== */

    const heroFloats = document.querySelectorAll('.contact-hero-float');
    const heroSection = document.querySelector('.contact-hero');

    if (
      heroSection && heroFloats.length &&
      window.matchMedia('(prefers-reduced-motion: no-preference)').matches
    ) {

      let ticking = false;

      window.addEventListener('scroll', () => {

        if (!ticking) {
          window.requestAnimationFrame(() => {
            const rect = heroSection.getBoundingClientRect();
            const scrolled = Math.max(0, -rect.top);

            heroFloats.forEach((el, i) => {
              const speed = 0.15 + (i * 0.08);
              el.style.transform =
                `translateY(${scrolled * speed}px) rotate(${scrolled * 0.05}deg)`;
            });

            ticking = false;
          });

          ticking = true;
        }

      }, { passive: true });

    }


    /* =====================================================
       5. SMOOTH FOCUS EFFECTS ON INPUTS
    ===================================================== */

    document.querySelectorAll('.form-group input, .form-group textarea').forEach(field => {

      field.addEventListener('focus', () => {
        field.parentElement.style.transform = 'translateY(-2px)';
      });

      field.addEventListener('blur', () => {
        field.parentElement.style.transform = 'translateY(0)';
      });

    });


    console.log("Reciclaja — Contact page loaded | ✉️ We reply within 24 hours");

  </script>

</body>
</html>