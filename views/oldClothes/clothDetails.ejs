<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= cloth.title %> | Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    button { font-family: inherit; cursor: pointer; }
    img { display: block; max-width: 100%; }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(50px); }
    [data-reveal="left"] { transform: translateX(-50px); }
    [data-reveal="right"] { transform: translateX(50px); }
    [data-reveal="zoom"] { transform: scale(0.9); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(40px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 10% 10%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 90% 90%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       CONTAINER
    ===================================================== */

    .container {
      width: min(1240px, 92%);
      margin: auto;
    }

    /* =====================================================
       BREADCRUMB
    ===================================================== */

    .breadcrumb {
      padding: 28px 0 22px;
      color: var(--text-light);
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .breadcrumb a {
      color: var(--text-muted);
      font-weight: 600;
      transition: all 0.25s ease;
      position: relative;
    }

    .breadcrumb a::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 1.5px;
      background: var(--mango);
      transition: width 0.3s ease;
    }

    .breadcrumb a:hover {
      color: var(--forest);
    }

    .breadcrumb a:hover::after {
      width: 100%;
    }

    .breadcrumb-sep {
      color: var(--text-light);
      opacity: 0.6;
    }

    .breadcrumb span {
      color: var(--forest);
      font-weight: 700;
    }

    /* =====================================================
       PRODUCT SECTION
    ===================================================== */

    .product-section {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 44px;
      background: var(--surface);
      border-radius: var(--radius-xl);
      padding: 36px;
      box-shadow: 0 20px 60px rgba(13, 59, 46, 0.08);
      border: 1px solid var(--border-soft);
      position: relative;
      overflow: hidden;
    }

    .product-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
    }

    /* =====================================================
       GALLERY
    ===================================================== */

    .gallery {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 16px;
    }

    .thumbnails {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .thumbnail {
      width: 90px;
      height: 90px;
      border-radius: 14px;
      object-fit: cover;
      cursor: pointer;
      border: 2px solid transparent;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      background: var(--surface-2);
    }

    .thumbnail:hover {
      border-color: var(--mango);
      transform: translateY(-2px);
      box-shadow: var(--shadow-mango);
    }

    .thumbnail.active {
      border-color: var(--forest);
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.18);
    }

    .main-image-wrapper {
      height: 580px;
      background:
        radial-gradient(circle at 30% 30%, rgba(245, 158, 11, 0.04) 0%, transparent 50%),
        radial-gradient(circle at 70% 70%, rgba(16, 185, 129, 0.04) 0%, transparent 50%),
        linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      border-radius: var(--radius-lg);
      overflow: hidden;
      position: relative;
      border: 1px solid var(--border-soft);
    }

    .main-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      cursor: zoom-in;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .main-image-wrapper:hover .main-image {
      transform: scale(1.04);
    }

    /* Zoom hint */

    .zoom-hint {
      position: absolute;
      bottom: 18px;
      right: 18px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      color: var(--forest);
      padding: 8px 14px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.4px;
      display: flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--border);
      opacity: 0;
      transform: translateY(8px);
      transition: all 0.3s ease;
      pointer-events: none;
      z-index: 2;
    }

    .main-image-wrapper:hover .zoom-hint {
      opacity: 1;
      transform: translateY(0);
    }

    .zoom-hint i {
      color: var(--mango-deep);
    }

    /* Condition badge */

    .condition-badge {
      position: absolute;
      top: 20px;
      left: 20px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.3);
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .condition-badge::before {
      content: "♻️";
      font-size: 12px;
    }

    /* =====================================================
       PRODUCT INFO
    ===================================================== */

    .product-info {
      padding: 4px 4px;
      display: flex;
      flex-direction: column;
    }

    .category {
      color: var(--mango-deep);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .category::before {
      content: "";
      width: 24px;
      height: 2px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 2px;
    }

    .product-title {
      font-family: var(--font-serif);
      font-size: 36px;
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -1.2px;
      margin-bottom: 12px;
      color: var(--forest);
    }

    .brand {
      color: var(--text-muted);
      font-size: 14px;
      margin-bottom: 20px;
    }

    .brand strong {
      color: var(--forest);
      font-weight: 700;
    }

    /* Rating */

    .rating-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px dashed var(--border);
    }

    .stars {
      color: var(--mango);
      font-size: 18px;
      letter-spacing: 2px;
    }

    .rating-text {
      font-size: 13px;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Price */

    .price-box {
      background:
        radial-gradient(circle at 90% 20%, rgba(245, 158, 11, 0.08) 0%, transparent 60%),
        linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      border: 1px solid rgba(245, 158, 11, 0.15);
      border-radius: var(--radius);
      padding: 22px 24px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }

    .price-box::after {
      content: "🏷️";
      position: absolute;
      font-size: 90px;
      opacity: 0.08;
      right: -10px;
      bottom: -30px;
      transform: rotate(-12deg);
      pointer-events: none;
    }

    .price {
      font-family: var(--font-serif);
      font-size: 40px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -1.5px;
      line-height: 1;
      position: relative;
      z-index: 2;
    }

    .price-label {
      font-size: 11.5px;
      color: var(--mango-deep);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 800;
      margin-top: 6px;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       QUICK DETAILS
    ===================================================== */

    .quick-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 26px;
    }

    .quick-item {
      background: var(--surface-2);
      border: 1px solid var(--border-soft);
      padding: 14px 16px;
      border-radius: var(--radius-sm);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .quick-item::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 3px;
      height: 100%;
      background: linear-gradient(180deg, var(--mango) 0%, var(--emerald) 100%);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.35s ease;
    }

    .quick-item:hover::before {
      transform: scaleY(1);
    }

    .quick-item:hover {
      background: #ffffff;
      border-color: var(--mango);
      transform: translateX(3px);
      box-shadow: var(--shadow-mango);
    }

    .quick-item span {
      display: block;
      font-size: 10.5px;
      color: var(--text-light);
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
    }

    .quick-item strong {
      font-size: 14px;
      color: var(--forest);
      font-weight: 700;
      letter-spacing: -0.1px;
    }

    /* =====================================================
       ACTIONS
    ===================================================== */

    .actions {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
    }

    .buy-btn {
      flex: 1;
      border: none;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 17px 24px;
      border-radius: var(--radius-sm);
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
    }

    .buy-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(251, 191, 36, 0.35),
        transparent
      );
      transition: left 0.6s ease;
    }

    .buy-btn:hover::before { left: 100%; }

    .buy-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    .buy-btn i {
      transition: transform 0.3s ease;
    }

    .buy-btn:hover i {
      transform: translateX(4px);
    }

    .wishlist-btn {
      width: 58px;
      border: 2px solid var(--border);
      background: #ffffff;
      border-radius: var(--radius-sm);
      font-size: 22px;
      cursor: pointer;
      color: var(--text-light);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .wishlist-btn:hover {
      border-color: var(--coral);
      color: var(--coral);
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(249, 115, 98, 0.2);
    }

    .wishlist-btn.active {
      border-color: var(--coral);
      color: var(--coral-deep);
      background: rgba(249, 115, 98, 0.06);
    }

    /* =====================================================
       SELLER CARD
    ===================================================== */

    .seller-card {
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      background:
        radial-gradient(circle at 90% 20%, rgba(16, 185, 129, 0.06) 0%, transparent 60%),
        linear-gradient(135deg, var(--surface-2) 0%, #ffffff 100%);
      transition: all 0.3s ease;
    }

    .seller-card:hover {
      border-color: var(--emerald);
      box-shadow: var(--shadow-glow);
    }

    .seller-avatar {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 20px;
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.28);
      transition: transform 0.35s ease;
    }

    .seller-card:hover .seller-avatar {
      transform: scale(1.08) rotate(-5deg);
    }

    .seller-info {
      flex: 1;
    }

    .seller-info small {
      display: block;
      color: var(--text-light);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 700;
      margin-bottom: 3px;
    }

    .seller-info strong {
      font-size: 14.5px;
      color: var(--forest);
      font-weight: 800;
      letter-spacing: -0.2px;
    }

    .seller-link {
      color: var(--forest-3);
      font-size: 12.5px;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 30px;
      background: rgba(16, 185, 129, 0.08);
      transition: all 0.3s ease;
      letter-spacing: 0.3px;
    }

    .seller-link::after {
      content: "→";
      transition: transform 0.3s ease;
    }

    .seller-link:hover {
      background: var(--forest);
      color: #ffffff;
      gap: 10px;
    }

    .seller-link:hover::after {
      transform: translateX(2px);
    }

    /* =====================================================
       DETAILS SECTION
    ===================================================== */

    .details-section {
      margin-top: 32px;
      background: var(--surface);
      padding: 40px 36px;
      border-radius: var(--radius-xl);
      box-shadow: 0 16px 48px rgba(13, 59, 46, 0.06);
      border: 1px solid var(--border-soft);
    }

    .section-title {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.6px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .section-title::before {
      content: "";
      width: 5px;
      height: 26px;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 4px;
    }

    .description {
      color: var(--text-muted);
      line-height: 1.85;
      white-space: pre-line;
      margin-bottom: 32px;
      font-size: 14.5px;
    }

    /* Spec grid */

    .spec-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--surface-2);
    }

    .spec {
      padding: 20px 22px;
      border-right: 1px solid var(--border-soft);
      border-bottom: 1px solid var(--border-soft);
      background: #ffffff;
      transition: all 0.3s ease;
      position: relative;
    }

    .spec:hover {
      background: var(--surface-2);
    }

    .spec:hover::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 3px;
      height: 100%;
      background: linear-gradient(180deg, var(--mango) 0%, var(--emerald) 100%);
    }

    .spec:nth-child(3n) { border-right: none; }

    .spec-label {
      display: block;
      color: var(--text-light);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .spec-value {
      font-weight: 700;
      font-size: 14.5px;
      color: var(--forest);
      letter-spacing: -0.1px;
    }

    /* =====================================================
       CONDITION SECTION
    ===================================================== */

    .condition-section {
      margin-top: 28px;
      padding: 26px 28px;
      background:
        radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.08) 0%, transparent 50%),
        linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      border-radius: var(--radius);
      border: 1px solid rgba(16, 185, 129, 0.15);
      position: relative;
      overflow: hidden;
    }

    .condition-section::before {
      content: "✨";
      position: absolute;
      font-size: 130px;
      opacity: 0.06;
      right: -20px;
      bottom: -30px;
      pointer-events: none;
    }

    .condition-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      position: relative;
      z-index: 2;
      gap: 12px;
      flex-wrap: wrap;
    }

    .condition-title {
      font-weight: 800;
      font-size: 15px;
      color: var(--forest);
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: -0.2px;
    }

    .condition-title i {
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border-radius: 10px;
      color: var(--emerald);
      font-size: 14px;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.18);
    }

    .damage-value {
      font-weight: 800;
      color: var(--forest-3);
      font-size: 14px;
      padding: 6px 14px;
      background: #ffffff;
      border-radius: 30px;
      border: 1px solid rgba(16, 185, 129, 0.2);
      letter-spacing: 0.3px;
    }

    .progress {
      width: 100%;
      height: 11px;
      background: rgba(255, 255, 255, 0.7);
      border-radius: 20px;
      overflow: hidden;
      position: relative;
      z-index: 2;
      box-shadow: inset 0 1px 3px rgba(13, 59, 46, 0.08);
    }

    .progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--forest-3) 100%);
      border-radius: 20px;
      position: relative;
      overflow: hidden;
      animation: progressGrow 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes progressGrow {
      0% { width: 0 !important; }
    }

    .progress-bar::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.5),
        transparent
      );
      animation: progressShimmer 2.5s linear infinite;
    }

    @keyframes progressShimmer {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }

    /* =====================================================
       REVIEWS SECTION
    ===================================================== */

    .reviews-section {
      margin-top: 32px;
      background: var(--surface);
      padding: 40px 36px;
      border-radius: var(--radius-xl);
      box-shadow: 0 16px 48px rgba(13, 59, 46, 0.06);
      border: 1px solid var(--border-soft);
    }

    .review {
      padding: 22px 0;
      border-bottom: 1px dashed var(--border);
      transition: all 0.3s ease;
    }

    .review:last-child { border-bottom: none; padding-bottom: 0; }
    .review:first-of-type { padding-top: 0; }

    .review:hover .review-user {
      color: var(--forest-3);
    }

    .review-top {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .review-user {
      font-weight: 800;
      font-size: 14.5px;
      color: var(--forest);
      display: flex;
      align-items: center;
      gap: 10px;
      transition: color 0.3s ease;
    }

    .review-user::before {
      content: "";
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
      display: inline-flex;
      box-shadow: 0 4px 10px rgba(245, 158, 11, 0.25);
    }

    .review-date {
      color: var(--text-light);
      font-size: 12px;
      font-weight: 500;
    }

    .review-stars {
      color: var(--mango);
      font-size: 15px;
      letter-spacing: 2px;
      margin-top: 5px;
    }

    .review-comment {
      color: var(--text-muted);
      font-size: 14px;
      margin-top: 8px;
      line-height: 1.7;
      padding-left: 42px;
    }

    /* Empty reviews */

    .empty-reviews {
      padding: 44px 30px;
      text-align: center;
      color: var(--text-muted);
      background:
        radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.05) 0%, transparent 70%),
        var(--surface-2);
      border-radius: var(--radius);
      border: 2px dashed var(--border);
    }

    .empty-reviews i {
      font-size: 34px;
      color: var(--mango-soft);
      margin-bottom: 12px;
      display: block;
    }

    .empty-reviews p {
      font-size: 14px;
      font-weight: 500;
    }

    /* =====================================================
       RELATED SECTION
    ===================================================== */

    .related-section {
      margin: 40px 0 70px;
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .related-card {
      background: var(--surface);
      border-radius: var(--radius);
      overflow: hidden;
      border: 2px solid var(--border-soft);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .related-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
      z-index: 3;
    }

    .related-card:hover::before {
      transform: scaleX(1);
    }

    .related-card:hover {
      transform: translateY(-8px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .related-image {
      width: 100%;
      height: 240px;
      object-fit: cover;
      background: var(--surface-2);
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .related-card:hover .related-image {
      transform: scale(1.06);
    }

    .related-info {
      padding: 16px 18px 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .related-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--forest);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 6px;
      letter-spacing: -0.2px;
    }

    .related-price {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 18px;
      color: var(--forest);
      letter-spacing: -0.4px;
      margin-top: auto;
    }

    /* =====================================================
       IMAGE MODAL
    ===================================================== */

    .image-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(7, 42, 32, 0.95);
      backdrop-filter: blur(8px);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      padding: 30px;
      animation: modalFade 0.3s ease;
    }

    .image-modal.show {
      display: flex;
    }

    @keyframes modalFade {
      0% { opacity: 0; }
      100% { opacity: 1; }
    }

    .modal-image {
      max-width: 90%;
      max-height: 90%;
      object-fit: contain;
      border-radius: 16px;
      animation: modalZoom 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    }

    @keyframes modalZoom {
      0% { transform: scale(0.9); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .close-modal {
      position: absolute;
      top: 24px;
      right: 32px;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: white;
      font-size: 26px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      backdrop-filter: blur(8px);
      line-height: 1;
    }

    .close-modal:hover {
      background: var(--coral);
      border-color: var(--coral);
      transform: rotate(90deg) scale(1.05);
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1024px) {

      .product-section {
        grid-template-columns: 1fr;
        padding: 28px;
        gap: 32px;
      }

      .main-image-wrapper { height: 520px; }

      .related-grid { grid-template-columns: repeat(3, 1fr); }

      .product-title { font-size: 32px; }

    }

    @media (max-width: 768px) {

      .breadcrumb {
        padding: 20px 0 16px;
        font-size: 12px;
      }

      .product-section,
      .details-section,
      .reviews-section {
        padding: 22px;
        border-radius: var(--radius-lg);
      }

      .gallery { grid-template-columns: 1fr; gap: 14px; }

      .thumbnails {
        order: 2;
        flex-direction: row;
        overflow-x: auto;
        padding-bottom: 6px;
        gap: 10px;
        scrollbar-width: none;
      }

      .thumbnails::-webkit-scrollbar { display: none; }

      .thumbnail {
        min-width: 72px;
        width: 72px;
        height: 72px;
        border-radius: 12px;
      }

      .main-image-wrapper { height: 420px; }

      .product-title { font-size: 27px; letter-spacing: -0.8px; }

      .price { font-size: 34px; }

      .section-title { font-size: 22px; }

      .spec-grid { grid-template-columns: 1fr 1fr; }

      .spec:nth-child(3n) { border-right: 1px solid var(--border-soft); }
      .spec:nth-child(2n) { border-right: none; }

      .related-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }

      .related-image { height: 200px; }

      .details-section, .reviews-section { padding: 26px 22px; }

    }

    @media (max-width: 500px) {

      .container { width: 94%; }

      .product-section,
      .details-section,
      .reviews-section {
        padding: 18px;
        border-radius: var(--radius);
      }

      .main-image-wrapper { height: 340px; }

      .product-title { font-size: 22px; }

      .price { font-size: 28px; }

      .price-box { padding: 18px 18px; }

      .quick-details { grid-template-columns: 1fr; }

      .spec-grid { grid-template-columns: 1fr; }

      .spec,
      .spec:nth-child(2n),
      .spec:nth-child(3n) {
        border-right: none;
      }

      .related-grid { grid-template-columns: 1fr; }

      .related-image { height: 260px; }

      .actions { flex-direction: row; }

      .buy-btn { padding: 15px 18px; font-size: 13px; }

      .wishlist-btn { width: 52px; font-size: 20px; }

      .section-title { font-size: 20px; }

      .review-comment { padding-left: 0; margin-top: 10px; }

      .close-modal {
        top: 16px;
        right: 16px;
        width: 42px;
        height: 42px;
        font-size: 22px;
      }

      .image-modal { padding: 16px; }

    }

  </style>
</head>

<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- ================= NAVBAR ================= -->

  <%- include('../partials/navbar') %>


  <main class="container">


    <!-- ================= BREADCRUMB ================= -->

    <div class="breadcrumb" data-reveal="down">

      <a href="/">
        <i class="fas fa-home" style="font-size:11px;"></i>
        Home
      </a>

      <span class="breadcrumb-sep">/</span>

      <a href="/old-clothes">
        Pre-Loved
      </a>

      <span class="breadcrumb-sep">/</span>

      <span><%= cloth.title %></span>

    </div>


    <!-- ================= PRODUCT SECTION ================= -->

    <section class="product-section">


      <!-- ================= GALLERY ================= -->

      <div class="gallery" data-reveal="left">

        <div class="thumbnails">

          <% if (cloth.images && cloth.images.length > 0) { %>

            <% cloth.images.forEach((image, index) => { %>

              <img
                src="<%= image.url %>"
                alt="<%= cloth.title %>"
                class="thumbnail <%= index === 0 ? 'active' : '' %>"
                onclick="changeImage(this, '<%= image.url %>')"
                loading="lazy"
              >

            <% }) %>

          <% } %>

        </div>


        <div class="main-image-wrapper">

          <% if (cloth.condition) { %>
            <div class="condition-badge">
              <%= cloth.condition.replace(/_/g, ' ') %>
            </div>
          <% } %>

          <% if (cloth.images && cloth.images.length > 0) { %>

            <img
              id="mainImage"
              src="<%= cloth.images[0].url %>"
              alt="<%= cloth.title %>"
              class="main-image"
              onclick="openImageModal(this.src)"
            >

            <div class="zoom-hint">
              <i class="fas fa-search-plus"></i>
              Click to zoom
            </div>

          <% } else { %>

            <div style="
              height:100%;
              display:flex;
              flex-direction:column;
              gap:10px;
              align-items:center;
              justify-content:center;
              color:#8a9a90;
            ">
              <i class="fas fa-image" style="font-size:42px;opacity:0.4;"></i>
              <span style="font-size:13px;font-weight:600;">No Image Available</span>
            </div>

          <% } %>

        </div>

      </div>


      <!-- ================= PRODUCT INFO ================= -->

      <div class="product-info" data-reveal="right">


        <div class="category">
          <%= cloth.category || 'Clothing' %>
        </div>


        <h1 class="product-title">
          <%= cloth.title %>
        </h1>


        <div class="brand">
          Brand:
          <strong>
            <%= cloth.brand || 'Local' %>
          </strong>
        </div>


        <!-- Rating -->

        <div class="rating-row">

          <div class="stars">

            <% 
              const rating = Number(cloth.rating || 0);
              const roundedRating = Math.round(rating);
            %>

            <% for (let i = 1; i <= 5; i++) { %>
              <%= i <= roundedRating ? '★' : '☆' %>
            <% } %>

          </div>

          <span class="rating-text">
            <%= rating.toFixed(1) %>
            (<%= cloth.reviews ? cloth.reviews.length : 0 %> reviews)
          </span>

        </div>


        <!-- Price -->

        <div class="price-box">

          <div class="price">
            ₹<%= Number(cloth.recommendedSellingPrice || 0).toLocaleString('en-IN') %>
          </div>

          <div class="price-label">
            Final selling price
          </div>

        </div>


        <!-- Quick Details -->

        <div class="quick-details">

          <div class="quick-item">
            <span>Size</span>
            <strong>
              <%= cloth.size || 'Not specified' %>
            </strong>
          </div>

          <div class="quick-item">
            <span>Gender</span>
            <strong>
              <%= cloth.gender || 'Unisex' %>
            </strong>
          </div>

          <div class="quick-item">
            <span>Fabric</span>
            <strong>
              <%= cloth.fabricType || 'Not specified' %>
            </strong>
          </div>

          <div class="quick-item">
            <span>Color</span>
            <strong>
              <%= cloth.color || 'Not specified' %>
            </strong>
          </div>

        </div>


        <!-- Actions -->

        <div class="actions">

          <button
            type="button"
            class="buy-btn"
            onclick="buyProduct('<%= cloth._id %>')"
          >
            <i class="fas fa-shopping-bag"></i>
            Buy Now
          </button>

          <button
            type="button"
            class="wishlist-btn"
            onclick="toggleWishlist(this)"
            aria-label="Add to wishlist"
          >
            <i class="far fa-heart"></i>
          </button>

        </div>


        <!-- Seller -->

        <div class="seller-card">

          <div class="seller-avatar">
            <%= (
              cloth.seller &&
              cloth.seller.fullname
            )
              ? cloth.seller.fullname.charAt(0).toUpperCase()
              : 'S'
            %>
          </div>

          <div class="seller-info">

            <small>Sold by</small>

            <strong>
              <%= cloth.seller && cloth.seller.fullname
                ? cloth.seller.fullname
                : 'Reciclaja Seller'
              %>
            </strong>

          </div>

          <a
            href="/old-clothes"
            class="seller-link"
          >
            View Store
          </a>

        </div>

      </div>

    </section>


    <!-- ================= DETAILS ================= -->

    <section class="details-section" data-reveal="up">

      <h2 class="section-title">
        Product Details
      </h2>

      <div class="description">
        <%= cloth.description %>
      </div>


      <div class="spec-grid">

        <div class="spec">
          <span class="spec-label">Category</span>
          <span class="spec-value">
            <%= cloth.category || 'N/A' %>
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Brand</span>
          <span class="spec-value">
            <%= cloth.brand || 'Local' %>
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Size</span>
          <span class="spec-value">
            <%= cloth.size || 'Not specified' %>
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Gender</span>
          <span class="spec-value">
            <%= cloth.gender || 'Unisex' %>
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Fabric Type</span>
          <span class="spec-value">
            <%= cloth.fabricType || 'N/A' %>
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Color</span>
          <span class="spec-value">
            <%= cloth.color || 'N/A' %>
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Weight</span>
          <span class="spec-value">
            <%= cloth.weight || 0 %> kg
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Age of Cloth</span>
          <span class="spec-value">
            <%= cloth.ageOfCloth || 0 %> years
          </span>
        </div>

        <div class="spec">
          <span class="spec-label">Original Price</span>
          <span class="spec-value">
            ₹<%= Number(cloth.originalPrice || 0).toLocaleString('en-IN') %>
          </span>
        </div>

      </div>


      <!-- ================= CONDITION ================= -->

      <div class="condition-section">

        <div class="condition-header">

          <span class="condition-title">
            <i class="fas fa-shield-alt"></i>
            Condition Rating
          </span>

          <span class="damage-value">
            <%= cloth.damageLevel || 0 %>% damage
          </span>

        </div>

        <div class="progress">

          <div
            class="progress-bar"
            style="width:<%= Math.min(Number(cloth.damageLevel || 0), 100) %>%"
          ></div>

        </div>

      </div>

    </section>


    <!-- ================= REVIEWS ================= -->

    <section class="reviews-section" data-reveal="up">

      <h2 class="section-title">
        Customer Reviews
      </h2>

      <% if (cloth.reviews && cloth.reviews.length > 0) { %>

        <% cloth.reviews.forEach(review => { %>

          <div class="review">

            <div class="review-top">

              <div>

                <div class="review-user">
                  <%= review.user && review.user.fullname
                    ? review.user.fullname
                    : 'Customer'
                  %>
                </div>

                <div class="review-stars">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <%= i <= review.rating ? '★' : '☆' %>
                  <% } %>
                </div>

              </div>

              <div class="review-date">
                <i class="far fa-clock" style="font-size:11px;margin-right:4px;"></i>
                <%= review.createdAt
                  ? new Date(review.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
                  : ''
                %>
              </div>

            </div>

            <div class="review-comment">
              <%= review.comment %>
            </div>

          </div>

        <% }) %>

      <% } else { %>

        <div class="empty-reviews">
          <i class="far fa-comment-dots"></i>
          <p>No reviews yet. Be the first to review this product.</p>
        </div>

      <% } %>

    </section>


    <!-- ================= RELATED PRODUCTS ================= -->

    <% if (relatedClothes && relatedClothes.length > 0) { %>

      <section class="related-section">

        <h2 class="section-title" data-reveal="up">
          You May Also Like
        </h2>

        <div class="related-grid">

          <% relatedClothes.forEach((item, index) => { %>

            <a
              href="/old-clothes/<%= item._id %>"
              class="related-card"
              data-reveal="zoom-up"
              data-delay="<%= index * 90 %>"
            >

              <% if (item.images && item.images.length > 0) { %>

                <img
                  src="<%= item.images[0].url %>"
                  alt="<%= item.title %>"
                  class="related-image"
                  loading="lazy"
                >

              <% } else { %>

                <div
                  class="related-image"
                  style="
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    color:#8a9a90;
                  "
                >
                  <i class="fas fa-image" style="font-size:32px;opacity:0.4;"></i>
                </div>

              <% } %>

              <div class="related-info">

                <div class="related-title">
                  <%= item.title %>
                </div>

                <div class="related-price">
                  ₹<%= Number(
                    item.recommendedSellingPrice || 0
                  ).toLocaleString('en-IN') %>
                </div>

              </div>

            </a>

          <% }) %>

        </div>

      </section>

    <% } %>

  </main>


  <!-- ================= IMAGE MODAL ================= -->

  <div
    class="image-modal"
    id="imageModal"
    onclick="closeImageModal()"
  >

    <button class="close-modal" onclick="closeImageModal()" aria-label="Close">
      &times;
    </button>

    <img
      id="modalImage"
      class="modal-image"
      alt="Product image"
      onclick="event.stopPropagation()"
    >

  </div>


  <!-- ================= JAVASCRIPT ================= -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       CHANGE MAIN IMAGE
    ===================================================== */

    function changeImage(element, imageUrl) {

      const mainImage = document.getElementById("mainImage");
      if (!mainImage) return;

      // Fade out/in effect
      mainImage.style.opacity = "0";
      mainImage.style.transform = "scale(0.98)";

      setTimeout(() => {
        mainImage.src = imageUrl;
        mainImage.style.opacity = "1";
        mainImage.style.transform = "scale(1)";
      }, 150);

      document
        .querySelectorAll(".thumbnail")
        .forEach(img => img.classList.remove("active"));

      element.classList.add("active");
    }


    /* =====================================================
       IMAGE MODAL
    ===================================================== */

    function openImageModal(imageUrl) {

      const modal = document.getElementById("imageModal");
      const modalImage = document.getElementById("modalImage");

      modalImage.src = imageUrl;
      modal.classList.add("show");
      document.body.style.overflow = "hidden";
    }


    function closeImageModal() {

      const modal = document.getElementById("imageModal");
      modal.classList.remove("show");
      document.body.style.overflow = "";
    }


    document.addEventListener("keydown", function(event) {
      if (event.key === "Escape") closeImageModal();
    });


    /* =====================================================
       WISHLIST
    ===================================================== */

    function toggleWishlist(button) {

      const active = button.classList.toggle("active");

      const icon = button.querySelector("i");

      if (active) {
        icon.classList.remove("far");
        icon.classList.add("fas");
        button.style.color = "";
      } else {
        icon.classList.remove("fas");
        icon.classList.add("far");
      }

      // Small pop animation
      button.style.transform = "scale(0.9)";
      setTimeout(() => {
        button.style.transform = "scale(1)";
      }, 120);
    }


    /* =====================================================
       BUY NOW
    ===================================================== */

    function buyProduct(productId) {
      window.location.href = "/orders/create/" + productId;
    }


    console.log("Reciclaja — Old Clothes product page loaded ♻️");

  </script>

</body>
</html>