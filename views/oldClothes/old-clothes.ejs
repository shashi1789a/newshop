<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Pre-Loved Clothes — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       PAGE CONTAINER
    ===================================================== */

    .page-container {
      width: 92%;
      max-width: 1400px;
      margin: 45px auto 80px;
    }

    /* =====================================================
       PAGE HEADER
    ===================================================== */

    .page-header {
      margin-bottom: 34px;
      position: relative;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .page-header::after {
      content: "";
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 90px;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 3px;
    }

    .page-header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      border: 1px solid rgba(13, 59, 46, 0.08);
      color: var(--forest-3);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }

    .page-header-eyebrow::before {
      content: "♻️";
      font-size: 12px;
    }

    .page-header h1 {
      font-family: var(--font-serif);
      font-size: 42px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 10px;
    }

    .page-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 15px;
      max-width: 620px;
      line-height: 1.65;
    }

    /* =====================================================
       ERROR MESSAGE
    ===================================================== */

    .error-message {
      background: rgba(249, 115, 98, 0.08);
      border: 1px solid rgba(249, 115, 98, 0.28);
      border-left: 4px solid var(--coral);
      color: var(--coral-deep);
      padding: 16px 20px;
      border-radius: var(--radius-sm);
      margin-bottom: 28px;
      font-size: 13.5px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .error-message::before {
      content: "⚠";
      font-size: 16px;
      flex-shrink: 0;
    }

    /* =====================================================
       EMPTY STATE
    ===================================================== */

    .empty-message {
      background:
        radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.06) 0%, transparent 65%),
        #ffffff;
      padding: 80px 30px;
      text-align: center;
      border-radius: var(--radius-xl);
      border: 2px dashed var(--border);
      position: relative;
      overflow: hidden;
    }

    .empty-message::before {
      content: "♻️";
      position: absolute;
      font-size: 220px;
      opacity: 0.04;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .empty-icon {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
      color: var(--coral);
      margin: 0 auto 22px;
      box-shadow: 0 12px 32px rgba(249, 115, 98, 0.2);
      position: relative;
      z-index: 2;
    }

    .empty-message h2 {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.6px;
      margin-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .empty-message p {
      color: var(--text-muted);
      font-size: 14.5px;
      max-width: 440px;
      margin: 0 auto;
      line-height: 1.65;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       PRODUCT GRID
    ===================================================== */

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }

    /* =====================================================
       PRODUCT CARD
    ===================================================== */

    .product-card {
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 2px solid var(--border-soft);
      text-decoration: none;
      color: inherit;
      box-shadow: var(--shadow-sm);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      animation: cardIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    @keyframes cardIn {
      0% { opacity: 0; transform: translateY(24px) scale(0.96); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .product-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 5;
    }

    .product-card:hover::before {
      transform: scaleX(1);
    }

    .product-card:hover {
      transform: translateY(-8px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    /* =====================================================
       IMAGE CONTAINER
    ===================================================== */

    .image-container {
      width: 100%;
      height: 300px;
      background: linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      position: relative;
      overflow: hidden;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .product-card:hover .product-image {
      transform: scale(1.08);
    }

    .no-image {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
      justify-content: center;
      color: var(--text-light);
      font-size: 13px;
      font-weight: 600;
    }

    .no-image::before {
      content: "👕";
      font-size: 44px;
      opacity: 0.4;
    }

    /* =====================================================
       BADGES
    ===================================================== */

    .badge {
      position: absolute;
      top: 14px;
      padding: 7px 12px;
      border-radius: 30px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      backdrop-filter: blur(8px);
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.3s ease;
    }

    .condition-badge {
      left: 14px;
      background: rgba(13, 59, 46, 0.92);
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(13, 59, 46, 0.3);
    }

    .condition-badge::before {
      content: "♻️";
      font-size: 11px;
    }

    .category-badge {
      right: 14px;
      background: rgba(255, 255, 255, 0.94);
      color: var(--forest);
      box-shadow: 0 6px 16px rgba(13, 59, 46, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }

    /* Wishlist heart (floating) */

    .wishlist-heart {
      position: absolute;
      bottom: 14px;
      right: 14px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      color: var(--text-muted);
      box-shadow: 0 6px 16px rgba(13, 59, 46, 0.15);
      border: none;
      cursor: pointer;
      opacity: 0;
      transform: translateY(8px);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 4;
    }

    .product-card:hover .wishlist-heart {
      opacity: 1;
      transform: translateY(0);
    }

    .wishlist-heart:hover {
      background: var(--coral);
      color: #ffffff;
      transform: scale(1.1);
    }

    /* =====================================================
       CARD CONTENT
    ===================================================== */

    .card-content {
      padding: 20px 20px 22px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .card-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 600;
      line-height: 1.25;
      letter-spacing: -0.4px;
      margin-bottom: 8px;
      color: var(--forest);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 0.3s ease;
    }

    .product-card:hover .card-title {
      color: var(--forest-3);
    }

    .description {
      color: var(--text-muted);
      font-size: 13px;
      line-height: 1.55;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* =====================================================
       PRICE ROW
    ===================================================== */

    .price-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--border);
    }

    .price {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -0.8px;
      line-height: 1;
    }

    .estimated {
      font-size: 10.5px;
      color: var(--text-light);
      text-align: right;
      line-height: 1.4;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .estimated strong {
      display: block;
      color: var(--text-muted);
      font-weight: 800;
    }

    /* =====================================================
       SMALL DETAILS
    ===================================================== */

    .small-details {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }

    .small-detail {
      background: var(--surface-2);
      padding: 6px 11px;
      border-radius: 8px;
      font-size: 10.5px;
      font-weight: 700;
      color: var(--text-muted);
      border: 1px solid var(--border-soft);
      letter-spacing: 0.2px;
      text-transform: uppercase;
      transition: all 0.3s ease;
    }

    .small-detail:hover {
      background: var(--mint);
      border-color: var(--mint-2);
      color: var(--forest-3);
    }

    .small-detail strong {
      color: var(--forest);
      font-weight: 800;
    }

    /* =====================================================
       VIEW DETAILS
    ===================================================== */

    .view-details {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12.5px;
      font-weight: 800;
      color: var(--forest);
      padding-top: 14px;
      border-top: 1px solid var(--border-soft);
      margin-top: auto;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      gap: 10px;
      transition: color 0.3s ease;
    }

    .view-details span {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      flex-shrink: 0;
    }

    .product-card:hover .view-details {
      color: var(--mango-deep);
    }

    .product-card:hover .view-details span {
      background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%);
      color: var(--forest);
      transform: translateX(4px) rotate(-8deg);
      box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 900px) {

      .page-container {
        width: 94%;
        margin-top: 35px;
      }

      .page-header h1 {
        font-size: 34px;
      }

      .product-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
      }

      .image-container {
        height: 260px;
      }

      .card-title {
        font-size: 18px;
      }

      .price {
        font-size: 23px;
      }

    }

    @media (max-width: 600px) {

      .page-container {
        width: 94%;
        margin: 25px auto 60px;
      }

      .page-header {
        margin-bottom: 24px;
        padding-bottom: 20px;
      }

      .page-header h1 {
        font-size: 28px;
        letter-spacing: -1px;
      }

      .page-header p {
        font-size: 13.5px;
      }

      .product-grid {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .image-container {
        height: 210px;
      }

      .card-content {
        padding: 14px 14px 16px;
      }

      .card-title {
        font-size: 15px;
        margin-bottom: 6px;
      }

      .description {
        font-size: 11.5px;
        margin-bottom: 12px;
        -webkit-line-clamp: 1;
      }

      .price {
        font-size: 19px;
      }

      .estimated {
        font-size: 9.5px;
      }

      .small-details {
        gap: 5px;
        margin-bottom: 12px;
      }

      .small-detail {
        font-size: 9px;
        padding: 4px 8px;
      }

      .view-details {
        font-size: 10.5px;
        padding-top: 11px;
      }

      .view-details span {
        width: 26px;
        height: 26px;
        font-size: 11px;
      }

      .badge {
        font-size: 8.5px;
        padding: 5px 9px;
        top: 10px;
      }

      .condition-badge { left: 10px; }
      .category-badge { right: 10px; }

      .wishlist-heart {
        width: 34px;
        height: 34px;
        font-size: 14px;
        bottom: 10px;
        right: 10px;
      }

    }

    @media (max-width: 400px) {

      .product-grid {
        grid-template-columns: 1fr;
      }

      .image-container {
        height: 280px;
      }

    }

  </style>

</head>


<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="page-container">


    <!-- ===================================================
         PAGE HEADER
    ==================================================== -->

    <div class="page-header" data-reveal="down">

      <span class="page-header-eyebrow">
        Sustainable Marketplace
      </span>

      <h1>
        Pre-Loved <em>Clothes</em>
      </h1>

      <p>
        Discover quality pre-loved clothes at affordable prices —
        each piece hand-checked, unique, and ready for a new chapter.
      </p>

    </div>


    <!-- ===================================================
         ERROR
    ==================================================== -->

    <% if (
      typeof error !== "undefined" &&
      error
    ) { %>

      <div class="error-message" data-reveal="up">
        <%= error %>
      </div>

    <% } %>


    <!-- ===================================================
         EMPTY
    ==================================================== -->

    <% if (
      !cloths ||
      cloths.length === 0
    ) { %>

      <div class="empty-message" data-reveal="zoom-up">

        <div class="empty-icon">
          <i class="fas fa-tshirt"></i>
        </div>

        <h2>
          No Pre-Loved Clothes Right Now
        </h2>

        <p>
          Our shelves are empty at the moment. Check back soon —
          new pieces are added every day by sellers across India.
        </p>

      </div>


    <% } else { %>


      <!-- =================================================
           PRODUCT GRID
      ================================================== -->

      <div class="product-grid">


        <% cloths.forEach((cloth, index) => { %>


          <!-- =================================================
               PRODUCT CARD
          ================================================== -->

          <a
            href="/old-clothes/<%= cloth._id %>"
            class="product-card"
            data-reveal="zoom-up"
            data-delay="<%= Math.min(index * 80, 500) %>"
          >


            <!-- ===============================================
                 IMAGE
            ================================================ -->

            <div class="image-container">


              <% if (
                cloth.images &&
                cloth.images.length > 0 &&
                cloth.images[0].url
              ) { %>


                <img
                  src="<%= cloth.images[0].url %>"
                  alt="<%= cloth.title || 'Pre-Loved Cloth' %>"
                  class="product-image"
                  loading="lazy"
                >


              <% } else { %>


                <div class="no-image">
                  No Image Available
                </div>


              <% } %>


              <!-- CONDITION -->

              <% if (cloth.condition) { %>

                <span
                  class="badge condition-badge"
                >
                  <%= cloth.condition
                    .replace(/_/g, " ") %>
                </span>

              <% } %>


              <!-- CATEGORY -->

              <% if (cloth.category) { %>

                <span
                  class="badge category-badge"
                >
                  <%= cloth.category %>
                </span>

              <% } %>


              <!-- WISHLIST HEART -->

              <button
                type="button"
                class="wishlist-heart"
                aria-label="Add to wishlist"
                onclick="event.preventDefault(); event.stopPropagation(); toggleCardWishlist(this);"
              >
                <i class="far fa-heart"></i>
              </button>


            </div>


            <!-- ===============================================
                 CONTENT
            ================================================ -->

            <div class="card-content">


              <!-- TITLE -->

              <h2 class="card-title">

                <%= cloth.title ||
                    "Untitled Cloth" %>

              </h2>


              <!-- DESCRIPTION -->

              <% if (cloth.description) { %>

                <p class="description">

                  <%= cloth.description %>

                </p>

              <% } %>


              <!-- =============================================
                   PRICE
              ============================================== -->

              <div class="price-row">


                <div class="price">

                  ₹<%= Number(
                    cloth.recommendedSellingPrice || 0
                  ).toLocaleString("en-IN") %>

                </div>


                <% if (
                  cloth.estimatedMarketValue
                ) { %>

                  <div class="estimated">

                    Est. value

                    <strong>
                      ₹<%= Number(
                        cloth.estimatedMarketValue
                      ).toLocaleString("en-IN") %>
                    </strong>

                  </div>

                <% } %>


              </div>


              <!-- =============================================
                   IMPORTANT DETAILS ONLY
              ============================================== -->

              <div class="small-details">


                <% if (cloth.brand) { %>

                  <div class="small-detail">

                    <%= cloth.brand %>

                  </div>

                <% } %>


                <% if (cloth.size) { %>

                  <div class="small-detail">

                    Size <%= cloth.size %>

                  </div>

                <% } %>


                <% if (cloth.gender) { %>

                  <div class="small-detail">

                    <%= cloth.gender %>

                  </div>

                <% } %>


                <% if (cloth.fabricType) { %>

                  <div class="small-detail">

                    <%= cloth.fabricType %>

                  </div>

                <% } %>


              </div>


              <!-- =============================================
                   VIEW DETAILS
              ============================================== -->

              <div class="view-details">

                View Details

                <span>
                  <i class="fas fa-arrow-right"></i>
                </span>

              </div>


            </div>


          </a>


        <% }) %>


      </div>


    <% } %>


  </main>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       CARD WISHLIST TOGGLE (UI only)
    ===================================================== */

    function toggleCardWishlist(button) {

      const icon = button.querySelector("i");
      const active = button.dataset.active === "true";

      if (active) {
        icon.classList.remove("fas");
        icon.classList.add("far");
        button.style.background = "";
        button.style.color = "";
        button.dataset.active = "false";
      } else {
        icon.classList.remove("far");
        icon.classList.add("fas");
        button.style.background = "linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%)";
        button.style.color = "#ffffff";
        button.dataset.active = "true";
      }

      // Pop animation
      button.style.transform = "scale(0.85)";
      setTimeout(() => {
        button.style.transform = "";
      }, 150);

      /*
        IMPORTANT:
        This is currently a UI-only toggle.
        Connect this function to your wishlist API
        after the backend route is ready.
      */

    }


    console.log("Reciclaja — Pre-Loved Clothes listing loaded ♻️");

  </script>

</body>

