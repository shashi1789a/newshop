<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head') %>
</head>
<body>

<h1>Old Clothes</h1>

<div class="product-grid">

<% cloths.forEach(cloth => { %>

<div class="card">

  <h3><%= cloth.title %></h3>

  <p>₹ <%= cloth.estimatedPrice %></p>

  <a href="/old-clothes/<%= cloth._id %>">
    View Details
  </a>

</div>

<% }) %>

</div>

</body>
</html>