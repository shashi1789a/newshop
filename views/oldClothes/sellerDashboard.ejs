<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Seller Dashboard — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    button { font-family: inherit; cursor: pointer; }
    img { display: block; max-width: 100%; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="left"] { transform: translateX(-40px); }
    [data-reveal="right"] { transform: translateX(40px); }
    [data-reveal="zoom"] { transform: scale(0.9); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       SELLER DASHBOARD LAYOUT
    ===================================================== */

    .seller-dashboard {
      width: 92%;
      max-width: 1400px;
      margin: 45px auto 80px;
    }

    /* =====================================================
       DASHBOARD HEADER
    ===================================================== */

    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 24px;
      margin-bottom: 40px;
      padding-bottom: 26px;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
      position: relative;
    }

    .dashboard-header::after {
      content: "";
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 90px;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 3px;
    }

    .dashboard-header-text {
      flex: 1;
      min-width: 260px;
    }

    .dashboard-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      border: 1px solid rgba(13, 59, 46, 0.08);
      color: var(--forest-3);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .dashboard-eyebrow::before {
      content: "🏪";
      font-size: 12px;
    }

    .dashboard-header h1 {
      font-family: var(--font-serif);
      font-size: 42px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 8px;
    }

    .dashboard-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .dashboard-header p {
      color: var(--text-muted);
      font-size: 14.5px;
      max-width: 560px;
      line-height: 1.6;
    }

    .upload-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 15px 28px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      overflow: hidden;
      white-space: nowrap;
    }

    .upload-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(251, 191, 36, 0.35),
        transparent
      );
      transition: left 0.6s ease;
    }

    .upload-btn:hover::before {
      left: 100%;
    }

    .upload-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    /* =====================================================
       STATS GRID
    ===================================================== */

    .dashboard-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-bottom: 45px;
    }

    .stat-card {
      background: #ffffff;
      border: 2px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 28px 26px;
      position: relative;
      overflow: hidden;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: var(--shadow-sm);
    }

    .stat-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .stat-card:hover::before {
      transform: scaleX(1);
    }

    .stat-card:hover {
      transform: translateY(-6px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    .stat-card:nth-child(2)::before {
      background: linear-gradient(90deg, var(--emerald) 0%, var(--forest-3) 100%);
    }

    .stat-card-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: #ffffff;
      margin-bottom: 18px;
      transition: transform 0.35s ease;
      position: relative;
      z-index: 2;
    }

    .stat-card:hover .stat-card-icon {
      transform: scale(1.08) rotate(-6deg);
    }

    .stat-card:nth-child(1) .stat-card-icon {
      background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
      box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
    }

    .stat-card:nth-child(2) .stat-card-icon {
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .stat-card h2 {
      font-size: 11.5px;
      font-weight: 800;
      color: var(--text-light);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .stat-card p {
      font-family: var(--font-serif);
      font-size: 34px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -1.2px;
      line-height: 1.1;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       CLOTHS SECTION
    ===================================================== */

    .cloths-section {
      margin-top: 10px;
    }

    .cloths-section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 26px;
      flex-wrap: wrap;
    }

    .cloths-section h2 {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.6px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .cloths-section h2::before {
      content: "";
      width: 5px;
      height: 28px;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 4px;
    }

    .cloths-count {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-muted);
      padding: 7px 15px;
      background: var(--surface-2);
      border-radius: 30px;
      border: 1px solid var(--border-soft);
      letter-spacing: 0.3px;
    }

    /* =====================================================
       EMPTY STATE
    ===================================================== */

    .empty-box {
      background:
        radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.06) 0%, transparent 65%),
        #ffffff;
      padding: 70px 30px;
      text-align: center;
      border-radius: var(--radius-xl);
      border: 2px dashed var(--border);
      margin-bottom: 30px;
      position: relative;
      overflow: hidden;
    }

    .empty-box::before {
      content: "📦";
      position: absolute;
      font-size: 200px;
      opacity: 0.04;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .empty-icon {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      color: var(--coral);
      margin: 0 auto 22px;
      box-shadow: 0 12px 32px rgba(249, 115, 98, 0.2);
      position: relative;
      z-index: 2;
    }

    .empty-box h3 {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.5px;
      margin-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .empty-box p {
      color: var(--text-muted);
      font-size: 14px;
      max-width: 440px;
      margin: 0 auto 24px;
      line-height: 1.65;
      position: relative;
      z-index: 2;
    }

    .empty-box a {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 14px 28px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      z-index: 2;
    }

    .empty-box a:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    /* =====================================================
       CLOTH GRID
    ===================================================== */

    .cloth-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 22px;
    }

    .cloth-card {
      background: #ffffff;
      border: 2px solid var(--border-soft);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      display: flex;
      flex-direction: column;
      animation: cardIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    @keyframes cardIn {
      0% { opacity: 0; transform: translateY(24px) scale(0.96); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .cloth-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 5;
    }

    .cloth-card:hover::before {
      transform: scaleX(1);
    }

    .cloth-card:hover {
      transform: translateY(-8px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    /* =====================================================
       CLOTH IMAGE
    ===================================================== */

    .cloth-image-wrapper {
      position: relative;
      aspect-ratio: 4 / 3.6;
      background: linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      overflow: hidden;
    }

    .cloth-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cloth-card:hover img {
      transform: scale(1.07);
    }

    /* Condition badge */

    .cloth-condition-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      padding: 6px 12px;
      background: rgba(13, 59, 46, 0.92);
      backdrop-filter: blur(8px);
      color: #ffffff;
      border-radius: 30px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      box-shadow: 0 6px 16px rgba(13, 59, 46, 0.25);
    }

    .cloth-condition-badge::before {
      content: "♻️";
      font-size: 11px;
    }

    /* =====================================================
       CLOTH CONTENT
    ===================================================== */

    .cloth-content {
      padding: 20px 20px 22px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .cloth-content h3 {
      font-family: var(--font-serif);
      font-size: 19px;
      font-weight: 600;
      line-height: 1.25;
      letter-spacing: -0.4px;
      margin-bottom: 12px;
      color: var(--forest);
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Meta rows */

    .cloth-meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--border);
    }

    .cloth-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 12.5px;
      padding: 2px 0;
    }

    .cloth-meta-row .label {
      color: var(--text-light);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 10px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .cloth-meta-row .label i {
      color: var(--mango-deep);
      font-size: 10px;
    }

    .cloth-meta-row .value {
      color: var(--forest);
      font-weight: 700;
      font-size: 13px;
      text-align: right;
    }

    /* Price */

    .cloth-price-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .cloth-price-label {
      font-size: 10px;
      color: var(--text-light);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 800;
      margin-bottom: 5px;
    }

    .cloth-price {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -0.8px;
      line-height: 1;
      margin: 0;
    }

    /* =====================================================
       CARD BUTTONS
    ===================================================== */

    .card-buttons {
      display: flex;
      gap: 10px;
      margin-top: auto;
      padding-top: 6px;
    }

    .view-btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 13px 18px;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 6px 16px rgba(13, 59, 46, 0.2);
      position: relative;
      overflow: hidden;
    }

    .view-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.3), transparent);
      transition: left 0.6s ease;
    }

    .view-btn:hover::before {
      left: 100%;
    }

    .view-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(13, 59, 46, 0.3);
      gap: 10px;
    }

    .delete-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      background: #ffffff;
      color: var(--coral-deep);
      border: 2px solid var(--border);
      padding: 11px 16px;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      white-space: nowrap;
    }

    .delete-btn:hover {
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      color: #ffffff;
      border-color: var(--coral);
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(249, 115, 98, 0.3);
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 900px) {

      .seller-dashboard {
        width: 94%;
        margin-top: 35px;
      }

      .dashboard-header h1 {
        font-size: 34px;
      }

      .cloth-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 18px;
      }

      .stat-card p {
        font-size: 28px;
      }

      .cloths-section h2 {
        font-size: 24px;
      }

    }

    @media (max-width: 600px) {

      .seller-dashboard {
        width: 94%;
        margin: 25px auto 60px;
      }

      .dashboard-header {
        margin-bottom: 28px;
        padding-bottom: 20px;
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
      }

      .dashboard-header h1 {
        font-size: 27px;
        letter-spacing: -1px;
      }

      .dashboard-header p {
        font-size: 13px;
      }

      .upload-btn {
        justify-content: center;
        width: 100%;
        padding: 14px 22px;
      }

      .dashboard-stats {
        grid-template-columns: 1fr;
        gap: 14px;
        margin-bottom: 34px;
      }

      .stat-card {
        padding: 22px 20px;
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .stat-card-icon {
        width: 46px;
        height: 46px;
        font-size: 17px;
        margin-bottom: 0;
        flex-shrink: 0;
      }

      .stat-card h2 {
        font-size: 10.5px;
        margin-bottom: 6px;
      }

      .stat-card p {
        font-size: 24px;
      }

      .cloths-section-header {
        margin-bottom: 20px;
      }

      .cloths-section h2 {
        font-size: 21px;
      }

      .cloth-grid {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .cloth-content {
        padding: 14px 14px 16px;
      }

      .cloth-content h3 {
        font-size: 15px;
        margin-bottom: 10px;
      }

      .cloth-meta {
        gap: 6px;
        margin-bottom: 12px;
        padding-bottom: 12px;
      }

      .cloth-meta-row {
        font-size: 11px;
      }

      .cloth-meta-row .label {
        font-size: 9px;
      }

      .cloth-meta-row .value {
        font-size: 11.5px;
      }

      .cloth-price {
        font-size: 19px;
      }

      .cloth-price-label {
        font-size: 9px;
      }

      .cloth-price-row {
        margin-bottom: 12px;
      }

      .card-buttons {
        gap: 6px;
      }

      .view-btn,
      .delete-btn {
        padding: 10px 12px;
        font-size: 11px;
      }

      .empty-box {
        padding: 50px 22px;
      }

      .empty-icon {
        width: 72px;
        height: 72px;
        font-size: 30px;
      }

      .empty-box h3 {
        font-size: 19px;
      }

      .cloth-condition-badge {
        font-size: 9px;
        padding: 5px 9px;
        top: 10px;
        left: 10px;
      }

    }

    @media (max-width: 400px) {

      .cloth-grid {
        grid-template-columns: 1fr;
      }

    }

  </style>

</head>

<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       SELLER DASHBOARD
  ====================================================== -->

  <div class="seller-dashboard">


    <!-- ===================================================
         DASHBOARD HEADER
    ==================================================== -->

    <div class="dashboard-header" data-reveal="down">

      <div class="dashboard-header-text">

        <span class="dashboard-eyebrow">
          Seller Hub
        </span>

        <h1>
          Seller <em>Dashboard</em>
        </h1>

        <p>
          Manage your pre-loved listings, track your estimated value, and
          keep your closet moving — all in one place.
        </p>

      </div>


      <a href="/old-clothes/upload" class="upload-btn">
        <i class="fas fa-plus"></i>
        Upload Old Cloth
      </a>

    </div>


    <!-- ===================================================
         STATS
    ==================================================== -->

    <div class="dashboard-stats">

      <div class="stat-card" data-reveal="zoom-up" data-delay="0">

        <div class="stat-card-icon">
          <i class="fas fa-tshirt"></i>
        </div>

        <h2>Total Uploaded</h2>

        <p>
          <%= cloths.length %>
        </p>

      </div>


      <div class="stat-card" data-reveal="zoom-up" data-delay="120">

        <div class="stat-card-icon">
          <i class="fas fa-rupee-sign"></i>
        </div>

        <h2>Total Estimated Value</h2>

        <p>
          ₹<%= cloths
            .reduce((total, cloth) =>
              total + (cloth.estimatedPrice || 0), 0)
            .toLocaleString("en-IN") %>
        </p>

      </div>

    </div>


    <!-- ===================================================
         CLOTHS SECTION
    ==================================================== -->

    <div class="cloths-section">

      <div class="cloths-section-header" data-reveal="up">

        <h2>
          Your Uploaded Clothes
        </h2>

        <% if (cloths.length > 0) { %>

          <span class="cloths-count">
            <%= cloths.length %>
            <%= cloths.length === 1 ? "item" : "items" %>
          </span>

        <% } %>

      </div>


      <!-- =================================================
           EMPTY STATE
      ================================================== -->

      <% if (cloths.length === 0) { %>

        <div class="empty-box" data-reveal="zoom-up">

          <div class="empty-icon">
            <i class="fas fa-box-open"></i>
          </div>

          <h3>
            No Pre-Loved Clothes Yet
          </h3>

          <p>
            Your dashboard is empty. Upload your first pre-loved item and
            start giving fashion a second life.
          </p>

          <a href="/old-clothes/upload">
            <i class="fas fa-plus"></i>
            Upload Now
          </a>

        </div>

      <% } else { %>


        <!-- =================================================
             CLOTH GRID
        ================================================== -->

        <div class="cloth-grid">

          <% cloths.forEach((cloth, index) => { %>

            <div
              class="cloth-card"
              data-reveal="zoom-up"
              data-delay="<%= Math.min(index * 80, 500) %>"
            >


              <!-- IMAGE -->

              <div class="cloth-image-wrapper">

                <% if (cloth.images && cloth.images.length > 0 && cloth.images[0].url) { %>

                  <img
                    src="<%= cloth.images[0].url %>"
                    alt="<%= cloth.title %>"
                    loading="lazy"
                  >

                <% } else { %>

                  <img
                    src="/images/no-image.jpg"
                    alt="No image available"
                  >

                <% } %>


                <% if (cloth.condition) { %>

                  <span class="cloth-condition-badge">
                    <%= cloth.condition.replace(/_/g, " ") %>
                  </span>

                <% } %>

              </div>


              <!-- CONTENT -->

              <div class="cloth-content">

                <h3>
                  <%= cloth.title %>
                </h3>


                <div class="cloth-meta">

                  <% if (cloth.brand) { %>

                    <div class="cloth-meta-row">

                      <span class="label">
                        <i class="fas fa-crown"></i>
                        Brand
                      </span>

                      <span class="value">
                        <%= cloth.brand %>
                      </span>

                    </div>

                  <% } %>


                  <% if (cloth.fabricType) { %>

                    <div class="cloth-meta-row">

                      <span class="label">
                        <i class="fas fa-tshirt"></i>
                        Fabric
                      </span>

                      <span class="value">
                        <%= cloth.fabricType %>
                      </span>

                    </div>

                  <% } %>


                  <% if (cloth.weight) { %>

                    <div class="cloth-meta-row">

                      <span class="label">
                        <i class="fas fa-weight-hanging"></i>
                        Weight
                      </span>

                      <span class="value">
                        <%= cloth.weight %> kg
                      </span>

                    </div>

                  <% } %>

                </div>


                <div class="cloth-price-row">

                  <div>

                    <div class="cloth-price-label">
                      Estimated Value
                    </div>

                    <div class="cloth-price">
                      ₹<%= Number(
                        cloth.estimatedPrice || 0
                      ).toLocaleString("en-IN") %>
                    </div>

                  </div>

                </div>


                <div class="card-buttons">

                  <a
                    href="/old-clothes/<%= cloth._id %>"
                    class="view-btn"
                  >
                    <i class="fas fa-eye"></i>
                    View
                  </a>

                  <form
                    action="/old-clothes/<%= cloth._id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Delete this listing? This cannot be undone.');"
                  >
                    <button type="submit" class="delete-btn">
                      <i class="fas fa-trash-alt"></i>
                      Delete
                    </button>
                  </form>

                </div>

              </div>

            </div>

          <% }) %>

        </div>

      <% } %>

    </div>

  </div>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    console.log("Reciclaja — Seller Dashboard loaded 🏪");

  </script>

</body>

</html>