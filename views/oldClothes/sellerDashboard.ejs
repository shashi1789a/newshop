<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="seller-dashboard">

  <div class="dashboard-header">
    <h1>Seller Dashboard</h1>

    <a href="/old-clothes/upload" class="upload-btn">
      + Upload Old Cloth
    </a>
  </div>

  <div class="dashboard-stats">

    <div class="stat-card">
      <h2>Total Uploaded</h2>
      <p><%= cloths.length %></p>
    </div>

    <div class="stat-card">
      <h2>Total Estimated Value</h2>

      <p>
        ₹ 
        <%= cloths.reduce((total, cloth) => total + cloth.estimatedPrice, 0) %>
      </p>
    </div>

  </div>

  <div class="cloths-section">

    <h2>Your Uploaded Clothes</h2>

    <% if(cloths.length === 0){ %>

      <div class="empty-box">
        <h3>No old clothes uploaded yet</h3>

        <a href="/old-clothes/upload">
          Upload Now
        </a>
      </div>

    <% } %>

    <div class="cloth-grid">

      <% cloths.forEach(cloth => { %>

        <div class="cloth-card">

          <% if(cloth.images && cloth.images.length > 0){ %>

            <img
              src="data:image/jpeg;base64,<%= cloth.images[0].data.toString('base64') %>"
              alt="cloth-image"
            >

          <% } %>

          <div class="cloth-content">

            <h3><%= cloth.title %></h3>

            <p>
              <strong>Brand:</strong>
              <%= cloth.brand %>
            </p>

            <p>
              <strong>Condition:</strong>
              <%= cloth.condition %>
            </p>

            <p>
              <strong>Fabric:</strong>
              <%= cloth.fabricType %>
            </p>

            <p>
              <strong>Weight:</strong>
              <%= cloth.weight %> kg
            </p>

            <h2 class="price">
              ₹ <%= cloth.estimatedPrice %>
            </h2>

            <div class="card-buttons">

              <a href="/old-clothes/<%= cloth._id %>" class="view-btn">
                View
              </a>

              <form
                action="/old-clothes/<%= cloth._id %>?_method=DELETE"
                method="POST"
              >
                <button type="submit" class="delete-btn">
                  Delete
                </button>
              </form>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </div>

</div>

<%- include('../partials/footer') %>

</body>
</html>