  <!-- =====================================================
       LOADING OVERLAY
  ====================================================== -->

  <div
    class="loading-overlay"
    id="loadingOverlay"
  >

    <div class="loading-box">

      <div class="spinner"></div>

      <p id="loadingText">
        Uploading your listing...
      </p>

    </div>

  </div>


  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const form = document.getElementById("oldClothForm");
    const formAlert = document.getElementById("formAlert");
    const titleInput = document.getElementById("title");
    const descriptionInput = document.getElementById("description");
    const titleCount = document.getElementById("titleCount");
    const descriptionCount = document.getElementById("descriptionCount");
    const categoryInput = document.getElementById("category");
    const brandInput = document.getElementById("brand");
    const conditionInput = document.getElementById("condition");
    const ageInput = document.getElementById("ageOfCloth");
    const damageInput = document.getElementById("damageLevel");
    const damageValue = document.getElementById("damageValue");
    const originalPriceInput = document.getElementById("originalPrice");
    const imageInput = document.getElementById("imageInput");
    const uploadZone = document.getElementById("uploadZone");
    const browseButton = document.getElementById("browseButton");
    const imagePreviewGrid = document.getElementById("imagePreviewGrid");
    const estimateButton = document.getElementById("estimateButton");
    const estimatePlaceholder = document.getElementById("estimatePlaceholder");
    const estimateResult = document.getElementById("estimateResult");
    const submitButton = document.getElementById("submitButton");
    const loadingOverlay = document.getElementById("loadingOverlay");
    const loadingText = document.getElementById("loadingText");


    /* =====================================================
       IMAGE STATE
    ===================================================== */

    let selectedFiles = [];


    /* =====================================================
       UTILITY
    ===================================================== */

    function formatPrice(value) {
      return new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 0
      }).format(Number(value || 0));
    }


    function showAlert(message, type = "error") {
      formAlert.textContent = message;
      formAlert.className = `alert show ${type}`;
      window.scrollTo({ top: 0, behavior: "smooth" });
    }


    function hideAlert() {
      formAlert.className = "alert";
      formAlert.textContent = "";
    }


    function setLoading(visible, text = "Uploading your listing...") {
      loadingText.textContent = text;
      loadingOverlay.classList.toggle("show", visible);
    }


    /* =====================================================
       CHARACTER COUNTERS
    ===================================================== */

    titleInput.addEventListener("input", () => {
      titleCount.textContent = `${titleInput.value.length} / 150`;
    });

    descriptionInput.addEventListener("input", () => {
      descriptionCount.textContent = `${descriptionInput.value.length} / 3000`;
    });


    /* =====================================================
       DAMAGE RANGE
    ===================================================== */

    damageInput.addEventListener("input", () => {
      damageValue.textContent = `${damageInput.value}%`;
    });


    /* =====================================================
       IMAGE PICKER
    ===================================================== */

    browseButton.addEventListener("click", () => {
      imageInput.click();
    });

    imageInput.addEventListener("change", event => {
      addImages(Array.from(event.target.files));
      imageInput.value = "";
    });


    /* =====================================================
       DRAG & DROP
    ===================================================== */

    ["dragenter", "dragover"].forEach(eventName => {
      uploadZone.addEventListener(eventName, event => {
        event.preventDefault();
        uploadZone.classList.add("dragover");
      });
    });

    ["dragleave", "drop"].forEach(eventName => {
      uploadZone.addEventListener(eventName, event => {
        event.preventDefault();
        uploadZone.classList.remove("dragover");
      });
    });

    uploadZone.addEventListener("drop", event => {
      addImages(Array.from(event.dataTransfer.files));
    });


    /* =====================================================
       ADD IMAGES
    ===================================================== */

    function addImages(files) {

      hideAlert();

      if (selectedFiles.length + files.length > 5) {
        showAlert("You can upload a maximum of 5 images.");
        return;
      }

      const validFiles = [];

      for (const file of files) {

        if (!file.type.startsWith("image/")) {
          showAlert("Only image files are allowed.");
          continue;
        }

        if (file.size > 5 * 1024 * 1024) {
          showAlert(`${file.name} is larger than 5 MB.`);
          continue;
        }

        validFiles.push(file);
      }

      selectedFiles.push(...validFiles);
      renderImagePreviews();
    }


    /* =====================================================
       RENDER IMAGE PREVIEWS
    ===================================================== */

    function renderImagePreviews() {

      imagePreviewGrid.innerHTML = "";

      selectedFiles.forEach((file, index) => {

        const url = URL.createObjectURL(file);

        const wrapper = document.createElement("div");
        wrapper.className = "image-preview";

        wrapper.innerHTML = `
          <img src="${url}" alt="Cloth image ${index + 1}">
          <button
            type="button"
            class="remove-image"
            data-index="${index}"
            aria-label="Remove image"
          >×</button>
          ${index === 0 ? `<span class="primary-image-label">Main Photo</span>` : ""}
        `;

        wrapper.querySelector(".remove-image").addEventListener("click", () => {
          selectedFiles.splice(index, 1);
          renderImagePreviews();
        });

        imagePreviewGrid.appendChild(wrapper);
      });
    }


    /* =====================================================
       VALIDATION
    ===================================================== */

    function validateForm() {

      hideAlert();

      const requiredFields = [
        titleInput,
        descriptionInput,
        categoryInput,
        document.getElementById("fabricType"),
        document.getElementById("weight"),
        conditionInput,
        ageInput
      ];

      let valid = true;

      requiredFields.forEach(field => {
        field.classList.remove("invalid");
        if (!field.value.trim()) {
          field.classList.add("invalid");
          valid = false;
        }
      });

      if (!valid) {
        showAlert("Please fill in all required fields.");
        return false;
      }

      if (titleInput.value.trim().length < 3) {
        titleInput.classList.add("invalid");
        showAlert("Product title must contain at least 3 characters.");
        return false;
      }

      if (descriptionInput.value.trim().length < 10) {
        descriptionInput.classList.add("invalid");
        showAlert("Description must contain at least 10 characters.");
        return false;
      }

      const weight = Number(document.getElementById("weight").value);
      if (Number.isNaN(weight) || weight < 0) {
        showAlert("Please enter a valid cloth weight.");
        return false;
      }

      const age = Number(ageInput.value);
      if (Number.isNaN(age) || age < 0) {
        ageInput.classList.add("invalid");
        showAlert("Please enter a valid cloth age.");
        return false;
      }

      const damage = Number(damageInput.value);
      if (damage < 0 || damage > 100) {
        showAlert("Damage level must be between 0% and 100%.");
        return false;
      }

      const originalPrice = Number(originalPriceInput.value || 0);
      if (originalPrice < 0) {
        showAlert("Original price cannot be negative.");
        return false;
      }

      if (selectedFiles.length === 0) {
        showAlert("Please upload at least one cloth image.");
        return false;
      }

      return true;
    }


    /* =====================================================
       PRICE ESTIMATION
    ===================================================== */

    estimateButton.addEventListener("click", async () => {

      if (!categoryInput.value || !conditionInput.value || ageInput.value === "") {
        showAlert("Category, condition and cloth age are required for price estimation.");
        return;
      }

      const age = Number(ageInput.value);
      const damage = Number(damageInput.value || 0);
      const originalPrice = Number(originalPriceInput.value || 0);

      if (Number.isNaN(age) || age < 0) {
        showAlert("Please enter a valid cloth age.");
        return;
      }

      estimateButton.classList.add("loading");
      estimateButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Calculating...';

      try {

        const response = await fetch("/old-clothes/estimate-price", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({
            category: categoryInput.value,
            brand: brandInput.value.trim(),
            condition: conditionInput.value,
            ageOfCloth: age,
            damageLevel: damage,
            originalPrice: originalPrice
          })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || "Unable to calculate price.");
        }

        const price = result.data;

        if (!price) {
          throw new Error("Price data was not returned by the server.");
        }

        document.getElementById("recommendedPrice").textContent = formatPrice(price.recommendedSellingPrice);
        document.getElementById("estimatedValue").textContent = formatPrice(price.estimatedMarketValue);
        document.getElementById("minimumPrice").textContent = formatPrice(price.minimumSellingPrice);
        document.getElementById("maximumPrice").textContent = formatPrice(price.maximumSellingPrice);
        document.getElementById("commissionAmount").textContent = formatPrice(price.commissionAmount);
        document.getElementById("sellerPayout").textContent = formatPrice(price.sellerPayout);
        document.getElementById("commissionPercentage").textContent = `${price.commissionPercentage}%`;

        estimatePlaceholder.style.display = "none";
        estimateResult.classList.add("show");

        showAlert("Price estimate calculated successfully.", "success");

      } catch (error) {

        console.error("Price estimation error:", error);
        showAlert(error.message || "Unable to calculate price estimate.");

      } finally {

        estimateButton.classList.remove("loading");
        estimateButton.innerHTML = '<i class="fas fa-calculator"></i> Calculate Price Estimate';

      }
    });


    /* =====================================================
       SUBMIT
    ===================================================== */

    form.addEventListener("submit", async event => {

      event.preventDefault();

      if (!validateForm()) return;

      submitButton.disabled = true;
      setLoading(true, "Uploading images and creating your listing...");

      try {

        const formData = new FormData();

        formData.append("title", titleInput.value.trim());
        formData.append("description", descriptionInput.value.trim());
        formData.append("category", categoryInput.value);
        formData.append("brand", brandInput.value.trim());
        formData.append("size", document.getElementById("size").value);
        formData.append("gender", document.getElementById("gender").value);
        formData.append("fabricType", document.getElementById("fabricType").value);
        formData.append("color", document.getElementById("color").value.trim());
        formData.append("weight", document.getElementById("weight").value);
        formData.append("condition", conditionInput.value);
        formData.append("ageOfCloth", ageInput.value);
        formData.append("damageLevel", damageInput.value);
        formData.append("originalPrice", originalPriceInput.value || "0");

        selectedFiles.forEach(file => {
          formData.append("images", file);
        });

        const response = await fetch("/old-clothes/upload", {
          method: "POST",
          body: formData,
          credentials: "include"
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || "Unable to upload your listing.");
        }

        showAlert("Listing uploaded successfully! Redirecting...", "success");

        setTimeout(() => {
          window.location.href = "/old-clothes/seller/dashboard";
        }, 1000);

      } catch (error) {

        console.error("Upload error:", error);
        showAlert(error.message || "Something went wrong while uploading.");
        submitButton.disabled = false;
        setLoading(false);
        return;
      }
    });


    /* =====================================================
       REMOVE INVALID CLASS ON INPUT
    ===================================================== */

    document.querySelectorAll(".input, .select, .textarea").forEach(field => {
      field.addEventListener("input", () => field.classList.remove("invalid"));
      field.addEventListener("change", () => field.classList.remove("invalid"));
    });


    /* =====================================================
       INITIAL STATE
    ===================================================== */

    titleCount.textContent = "0 / 150";
    descriptionCount.textContent = "0 / 3000";
    damageValue.textContent = "0%";


    console.log("Reciclaja — Sell Pre-Loved Clothes page loaded ♻️");

  </script>

</body>
