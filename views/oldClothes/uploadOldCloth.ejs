              <strong id="commissionAmount">
                ₹0
              </strong>

            </div>


            <div class="payout-row">

              <span>
                Estimated Seller Payout
              </span>

              <strong id="sellerPayout">
                ₹0
              </strong>

            </div>


            <div class="commission-note">

              Platform commission:
              <strong id="commissionPercentage">
                10%
