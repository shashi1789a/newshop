<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= product.title || product.name %> | Reciclaja
  </title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }
    button { font-family: inherit; cursor: pointer; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="left"] { transform: translateX(-40px); }
    [data-reveal="right"] { transform: translateX(40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       CONTAINER
    ===================================================== */

    .container {
      max-width: 1240px;
      margin: 45px auto 80px;
      padding: 0 22px;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       MESSAGE
    ===================================================== */

    #message {
      display: none;
      padding: 16px 20px;
      border-radius: var(--radius-sm);
      margin-bottom: 24px;
      font-size: 13.5px;
      font-weight: 600;
    }

    /* =====================================================
       PRODUCT CONTAINER
    ===================================================== */

    .product-container {
      background: var(--surface);
      border-radius: var(--radius-xl);
      border: 1px solid var(--border-soft);
      padding: 36px;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      box-shadow: 0 20px 60px rgba(13, 59, 46, 0.08);
      position: relative;
      overflow: hidden;
    }

    .product-container::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
    }

    /* =====================================================
       GALLERY
    ===================================================== */

    .main-image {
      height: 580px;
      background:
        radial-gradient(circle at 30% 30%, rgba(245, 158, 11, 0.04) 0%, transparent 50%),
        radial-gradient(circle at 70% 70%, rgba(16, 185, 129, 0.04) 0%, transparent 50%),
        linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-soft);
      position: relative;
    }

    .main-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .main-image:hover img {
      transform: scale(1.04);
    }

    /* Zoom hint */

    .zoom-hint {
      position: absolute;
      bottom: 18px;
      right: 18px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      color: var(--forest);
      padding: 8px 14px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.4px;
      display: flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--border);
      opacity: 0;
      transform: translateY(8px);
      transition: all 0.3s ease;
      pointer-events: none;
      z-index: 2;
    }

    .main-image:hover .zoom-hint {
      opacity: 1;
      transform: translateY(0);
    }

    .zoom-hint i {
      color: var(--mango-deep);
    }

    /* =====================================================
       THUMBNAILS
    ===================================================== */

    .thumbnail-container {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      overflow-x: auto;
      padding-bottom: 6px;
      scrollbar-width: none;
    }

    .thumbnail-container::-webkit-scrollbar {
      display: none;
    }

    .thumbnail {
      width: 88px;
      height: 88px;
      border: 2px solid transparent;
      border-radius: var(--radius-sm);
      overflow: hidden;
      cursor: pointer;
      flex-shrink: 0;
      background: var(--surface-2);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .thumbnail:hover {
      border-color: var(--mango);
      transform: translateY(-2px);
      box-shadow: var(--shadow-mango);
    }

    .thumbnail.active {
      border-color: var(--forest);
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.18);
    }

    .thumbnail img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* =====================================================
       DETAILS
    ===================================================== */

    .details {
      min-width: 0;
    }

    /* Badge */

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 15px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      font-size: 10.5px;
      font-weight: 800;
      border-radius: 30px;
      margin-bottom: 16px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      box-shadow: 0 6px 16px rgba(13, 59, 46, 0.22);
    }

    .badge::before {
      content: "✨";
      font-size: 11px;
    }

    .badge.used {
      background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
      color: var(--forest);
      box-shadow: 0 6px 16px rgba(245, 158, 11, 0.28);
    }

    .badge.used::before {
      content: "♻️";
    }

    /* Title */

    .product-title {
      font-family: var(--font-serif);
      font-size: 40px;
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -1.4px;
      margin-bottom: 12px;
      color: var(--forest);
    }

    /* Brand */

    .brand {
      color: var(--text-muted);
      font-size: 14.5px;
      margin-bottom: 20px;
    }

    .brand strong {
      color: var(--forest);
      font-weight: 800;
    }

    /* Rating */

    .rating {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      padding: 8px 14px;
      border-radius: 30px;
      color: var(--forest-3);
      font-weight: 800;
      font-size: 13px;
      margin-bottom: 22px;
      border: 1px solid rgba(16, 185, 129, 0.18);
      letter-spacing: 0.3px;
    }

    .rating span {
      color: var(--forest-3);
      font-weight: 600;
      font-size: 12px;
      opacity: 0.85;
    }

    /* =====================================================
       PRICE BOX
    ===================================================== */

    .price-box {
      background:
        radial-gradient(circle at 90% 20%, rgba(245, 158, 11, 0.1) 0%, transparent 60%),
        linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      border: 1px solid rgba(245, 158, 11, 0.18);
      border-radius: var(--radius);
      padding: 22px 24px;
      margin-bottom: 22px;
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 12px;
      position: relative;
      overflow: hidden;
    }

    .price-box::after {
      content: "🏷️";
      position: absolute;
      font-size: 100px;
      opacity: 0.07;
      right: -10px;
      bottom: -30px;
      transform: rotate(-12deg);
      pointer-events: none;
    }

    .price {
      font-family: var(--font-serif);
      font-size: 40px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -1.5px;
      line-height: 1;
      position: relative;
      z-index: 2;
    }

    .old-price {
      color: var(--text-light);
      font-size: 17px;
      text-decoration: line-through;
      font-weight: 600;
      position: relative;
      z-index: 2;
    }

    .discount {
      color: var(--forest-3);
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 6px 12px;
      background: #ffffff;
      border-radius: 30px;
      border: 1px solid rgba(16, 185, 129, 0.25);
      position: relative;
      z-index: 2;
    }

    .discount::before {
      content: "🎉 ";
    }

    /* =====================================================
       STOCK STATUS
    ===================================================== */

    .stock-status {
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.4px;
      padding: 10px 16px;
      border-radius: 30px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 22px;
    }

    .stock-status.available {
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      color: var(--forest-3);
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .stock-status.out {
      background: rgba(249, 115, 98, 0.08);
      color: var(--coral-deep);
      border: 1px solid rgba(249, 115, 98, 0.28);
    }

    /* =====================================================
       DESCRIPTION
    ===================================================== */

    .description {
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px dashed var(--border);
    }

    .description h3,
    .specifications h3,
    .seller h3 {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.4px;
      color: var(--forest);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .description h3::before,
    .specifications h3::before,
    .seller h3::before {
      content: "";
      width: 5px;
      height: 20px;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 4px;
      flex-shrink: 0;
    }

    .description p {
      color: var(--text-muted);
      line-height: 1.8;
      font-size: 14.5px;
    }

    /* =====================================================
       SPECIFICATIONS
    ===================================================== */

    .specifications {
      margin-top: 28px;
      padding-top: 24px;
      border-top: 1px dashed var(--border);
    }

    .spec-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .spec {
      background: var(--surface-2);
      padding: 16px 18px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-soft);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .spec::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 3px;
      height: 100%;
      background: linear-gradient(180deg, var(--mango) 0%, var(--emerald) 100%);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.35s ease;
    }

    .spec:hover::before {
      transform: scaleY(1);
    }

    .spec:hover {
      background: #ffffff;
      border-color: var(--mango);
      transform: translateX(3px);
      box-shadow: var(--shadow-mango);
    }

    .spec-label {
      color: var(--text-light);
      font-size: 10.5px;
      margin-bottom: 5px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-weight: 800;
    }

    .spec-value {
      font-size: 14px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -0.1px;
    }

    /* =====================================================
       SELLER
    ===================================================== */

    .seller {
      margin-top: 28px;
      padding-top: 24px;
      border-top: 1px dashed var(--border);
    }

    .seller-card {
      display: flex;
      align-items: center;
      gap: 14px;
      background:
        radial-gradient(circle at 90% 20%, rgba(16, 185, 129, 0.06) 0%, transparent 60%),
        linear-gradient(135deg, var(--surface-2) 0%, #ffffff 100%);
      padding: 18px;
      border-radius: var(--radius);
      border: 1px solid var(--border-soft);
      transition: all 0.3s ease;
    }

    .seller-card:hover {
      border-color: var(--emerald);
      box-shadow: var(--shadow-glow);
    }

    .seller-image {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      object-fit: cover;
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.28);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-weight: 800;
      font-size: 20px;
    }

    .seller-name {
      font-weight: 800;
      font-size: 14.5px;
      color: var(--forest);
      letter-spacing: -0.2px;
    }

    .seller-email {
      font-size: 12.5px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* =====================================================
       ACTIONS
    ===================================================== */

    .actions {
      margin-top: 28px;
      display: flex;
      gap: 12px;
      align-items: stretch;
      flex-wrap: wrap;
    }

    .buy-btn,
    .buy-now-btn,
    .wishlist-btn {
      border: none;
      border-radius: var(--radius-sm);
      padding: 16px 22px;
      cursor: pointer;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.4px;
      text-align: center;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: relative;
      overflow: hidden;
    }

    /* Add to Cart */

    .buy-btn {
      flex: 1;
      min-width: 160px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
    }

    .buy-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .buy-btn:hover::before { left: 100%; }

    .buy-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 12px;
    }

    .buy-btn:disabled {
      background: linear-gradient(135deg, var(--text-light) 0%, var(--text-muted) 100%);
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    /* Buy Now */

    .buy-now-btn {
      flex: 1;
      min-width: 160px;
      background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
      color: var(--forest);
      box-shadow: 0 10px 28px rgba(245, 158, 11, 0.28);
    }

    .buy-now-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(245, 158, 11, 0.45);
      gap: 12px;
    }

    .buy-now-btn.disabled {
      background: linear-gradient(135deg, var(--text-light) 0%, var(--text-muted) 100%);
      color: #ffffff;
      cursor: not-allowed;
      opacity: 0.75;
      transform: none;
      box-shadow: none;
    }

    /* Wishlist */

    .wishlist-btn {
      background: #ffffff;
      color: var(--forest);
      border: 2px solid var(--border);
      white-space: nowrap;
      box-shadow: var(--shadow-sm);
      min-width: 130px;
    }

    .wishlist-btn:hover {
      background: var(--forest);
      color: #ffffff;
      border-color: var(--forest);
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(13, 59, 46, 0.22);
    }

    /* =====================================================
       DELETE SECTION
    ===================================================== */

    .delete-section {
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px dashed var(--border);
    }

    .delete-btn {
      width: 100%;
      border: 2px solid rgba(249, 115, 98, 0.28);
      background: rgba(249, 115, 98, 0.06);
      color: var(--coral-deep);
      padding: 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-family: inherit;
    }

    .delete-btn:hover {
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      color: #ffffff;
      border-color: transparent;
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(249, 115, 98, 0.3);
      gap: 14px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1024px) {

      .product-container {
        grid-template-columns: 1fr;
        gap: 36px;
        padding: 30px;
      }

      .main-image { height: 520px; }

      .product-title { font-size: 34px; }

    }

    @media (max-width: 700px) {

      .container {
        padding: 0 16px;
        margin: 30px auto 60px;
      }

      .product-container {
        padding: 24px;
        border-radius: var(--radius-lg);
      }

      .product-title {
        font-size: 28px;
        letter-spacing: -1px;
      }

      .main-image { height: 420px; }

      .thumbnail {
        width: 72px;
        height: 72px;
      }

      .spec-grid {
        grid-template-columns: 1fr;
      }

      .actions {
        flex-direction: column;
      }

      .buy-btn,
      .buy-now-btn,
      .wishlist-btn {
        width: 100%;
        min-width: 0;
      }

      .price { font-size: 34px; }

      .price-box {
        padding: 18px 20px;
      }

    }

    @media (max-width: 500px) {

      .product-container {
        padding: 20px;
      }

      .product-title {
        font-size: 24px;
        letter-spacing: -0.8px;
      }

      .main-image { height: 340px; }

      .description h3,
      .specifications h3,
      .seller h3 {
        font-size: 18px;
      }

      .buy-btn,
      .buy-now-btn,
      .wishlist-btn {
        padding: 14px 18px;
        font-size: 12.5px;
      }

      .badge {
        font-size: 9.5px;
        padding: 6px 12px;
      }

      .price { font-size: 30px; }

      .stock-status {
        font-size: 11.5px;
        padding: 8px 14px;
      }

    }

  </style>

</head>


<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="container">


    <div id="message"></div>


    <div class="product-container">


      <!-- =================================================
           PRODUCT GALLERY
      ================================================== -->

      <div class="gallery" data-reveal="left">


        <div class="main-image">

          <% if (product.images && product.images.length > 0) { %>

            <img
              id="mainImage"
              src="<%= product.images[0].url || product.images[0] %>"
              alt="<%= product.title || product.name %>"
              onerror="this.src='https://via.placeholder.com/700x700?text=No+Image';"
            >

          <% } else { %>

            <img
              id="mainImage"
              src="https://via.placeholder.com/700x700?text=No+Image"
              alt="No Image"
            >

          <% } %>

          <div class="zoom-hint">
            <i class="fas fa-search-plus"></i>
            Hover to zoom
          </div>

        </div>


        <!-- THUMBNAILS -->

        <% if (product.images && product.images.length > 1) { %>

          <div class="thumbnail-container">

            <% product.images.forEach((image, index) => { %>

              <div
                class="thumbnail <%= index === 0 ? 'active' : '' %>"
                onclick="changeImage(
                  '<%= image.url || image %>',
                  this
                )"
              >

                <img
                  src="<%= image.url || image %>"
                  alt="<%= product.title || product.name %>"
                  onerror="this.style.display='none';"
                >

              </div>

            <% }) %>

          </div>

        <% } %>


      </div>


      <!-- =================================================
           PRODUCT DETAILS
      ================================================== -->

      <div class="details" data-reveal="right">


        <!-- PRODUCT TYPE -->

        <span
          class="badge <%= product.productType === 'USED' ? 'used' : '' %>"
        >

          <%= product.productType === "USED"
              ? "PRE-OWNED"
              : "NEW ARRIVAL" %>

        </span>


        <!-- TITLE -->

        <h1 class="product-title">

          <%= product.title || product.name %>

        </h1>


        <!-- BRAND -->

        <% if (product.brand) { %>

          <div class="brand">

            Brand:

            <strong>
              <%= product.brand %>
            </strong>

          </div>

        <% } %>


        <!-- RATING -->

        <div class="rating">

          ★ <%= product.rating || 0 %>

          <span>
            Rating
          </span>

        </div>


        <!-- =================================================
             PRICE
        ================================================== -->

        <div class="price-box">

          <span class="price">

            ₹<%= Number(
              product.price || 0
            ).toLocaleString("en-IN") %>

          </span>


          <% if (
            product.originalPrice &&
            product.originalPrice > product.price
          ) { %>

            <span class="old-price">

              ₹<%= Number(
                product.originalPrice
              ).toLocaleString("en-IN") %>

            </span>


            <%
              const discount =
                Math.round(
                  (
                    (
                      product.originalPrice -
                      product.price
                    )
                    /
                    product.originalPrice
                  ) * 100
                );
            %>

            <span class="discount">

              <%= discount %>% OFF

            </span>

          <% } %>

        </div>


        <!-- =================================================
             STOCK STATUS
        ================================================== -->

        <% if (
          product.stock !== undefined &&
          product.stock !== null
        ) { %>

          <% if (Number(product.stock) > 0) { %>

            <div class="stock-status available">

              <i class="fas fa-check-circle"></i>

              In Stock

              <% if (product.stock <= 5) { %>

                — Only
                <%= product.stock %>
                left

              <% } %>

            </div>

          <% } else { %>

            <div class="stock-status out">

              <i class="fas fa-times-circle"></i>

              Out of Stock

            </div>

          <% } %>

        <% } %>


        <!-- =================================================
             DESCRIPTION
        ================================================== -->

        <div class="description">

          <h3>
            Description
          </h3>

          <p>

            <%= product.description ||
                "No description available." %>

          </p>

        </div>


        <!-- =================================================
             SPECIFICATIONS
        ================================================== -->

        <div class="specifications">

          <h3>
            Product Information
          </h3>


          <div class="spec-grid">


            <!-- CATEGORY -->

            <% if (product.category) { %>

              <div class="spec">

                <div class="spec-label">
                  Category
                </div>

                <div class="spec-value">
                  <%= product.category %>
                </div>

              </div>

            <% } %>


            <!-- SIZE -->

            <% if (product.size) { %>

              <div class="spec">

                <div class="spec-label">
                  Size
                </div>

                <div class="spec-value">
                  <%= product.size %>
                </div>

              </div>

            <% } %>


            <!-- GENDER -->

            <% if (product.gender) { %>

              <div class="spec">

                <div class="spec-label">
                  Gender
                </div>

                <div class="spec-value">
                  <%= product.gender %>
                </div>

              </div>

            <% } %>


            <!-- FABRIC -->

            <% if (product.fabricType) { %>

              <div class="spec">

                <div class="spec-label">
                  Fabric
                </div>

                <div class="spec-value">
                  <%= product.fabricType %>
                </div>

              </div>

            <% } %>


            <!-- MATERIAL -->

            <% if (product.material) { %>

              <div class="spec">

                <div class="spec-label">
                  Material
                </div>

                <div class="spec-value">
                  <%= product.material %>
                </div>

              </div>

            <% } %>


            <!-- COLOR -->

            <% if (product.color) { %>

              <div class="spec">

                <div class="spec-label">
                  Color
                </div>

                <div class="spec-value">
                  <%= product.color %>
                </div>

              </div>

            <% } %>


            <!-- CONDITION -->

            <% if (product.condition) { %>

              <div class="spec">

                <div class="spec-label">
                  Condition
                </div>

                <div class="spec-value">
                  <%= product.condition %>
                </div>

              </div>

            <% } %>


            <!-- CLOTH AGE -->

            <% if (
              product.ageOfCloth !== undefined &&
              product.ageOfCloth !== null &&
              product.ageOfCloth !== ""
            ) { %>

              <div class="spec">

                <div class="spec-label">
                  Cloth Age
                </div>

                <div class="spec-value">
                  <%= product.ageOfCloth %>
                </div>

              </div>

            <% } %>


            <!-- OLD AGE FIELD -->

            <% if (
              product.age !== undefined &&
              product.age !== null &&
              product.age !== ""
            ) { %>

              <div class="spec">

                <div class="spec-label">
                  Product Age
                </div>

                <div class="spec-value">
                  <%= product.age %> months
                </div>

              </div>

            <% } %>


            <!-- DAMAGE LEVEL -->

            <% if (product.damageLevel) { %>

              <div class="spec">

                <div class="spec-label">
                  Damage Level
                </div>

                <div class="spec-value">
                  <%= product.damageLevel %>
                </div>

              </div>

            <% } %>


            <!-- OLD DAMAGE FIELD -->

            <% if (product.damage) { %>

              <div class="spec">

                <div class="spec-label">
                  Damage / Defects
                </div>

                <div class="spec-value">
                  <%= product.damage %>
                </div>

              </div>

            <% } %>


            <!-- STOCK -->

            <% if (
              product.stock !== undefined &&
              product.stock !== null
            ) { %>

              <div class="spec">

                <div class="spec-label">
                  Available Stock
                </div>

                <div class="spec-value">
                  <%= product.stock %>
                </div>

              </div>

            <% } %>


          </div>

        </div>


        <!-- =================================================
             SELLER
        ================================================== -->

        <% if (product.seller) { %>

          <div class="seller">

            <h3>
              Seller
            </h3>


            <div class="seller-card">


              <% if (product.seller.profileImage) { %>

                <img
                  class="seller-image"
                  src="<%= product.seller.profileImage %>"
                  alt="<%= product.seller.name || 'Seller' %>"
                >

              <% } else { %>

                <div class="seller-image">

                  <%= (product.seller.name || "S").charAt(0).toUpperCase() %>

                </div>

              <% } %>


              <div>

                <div class="seller-name">

                  <%= product.seller.name ||
                      "Seller" %>

                </div>


                <% if (product.seller.email) { %>

                  <div class="seller-email">

                    <%= product.seller.email %>

                  </div>

                <% } %>

              </div>

            </div>

          </div>

        <% } %>


        <!-- =================================================
             ACTION BUTTONS
        ================================================== -->

        <div class="actions">

          <% if (user) { %>

            <% if (
              product.stock &&
              Number(product.stock) > 0
            ) { %>

              <a
                href="/cart/add/<%= product._id %>"
                class="buy-btn"
              >
                <i class="fas fa-shopping-cart"></i>
                Add to Cart
              </a>

            <% } else { %>

              <button
                class="buy-btn"
                disabled
              >
                <i class="fas fa-times-circle"></i>
                Out of Stock
              </button>

            <% } %>


            <% if (
              product.stock &&
              Number(product.stock) > 0
            ) { %>

              <a
                href="/orders/order?productid=<%= product._id %>"
                class="buy-now-btn"
              >
                <i class="fas fa-bolt"></i>
                Buy Now
              </a>

            <% } else { %>

              <button
                class="buy-now-btn disabled"
                disabled
              >
                <i class="fas fa-times-circle"></i>
                Out of Stock
              </button>

            <% } %>


            <a
              href="/wishlist/add/<%= product._id %>"
              class="wishlist-btn"
            >
              <i class="far fa-heart"></i>
              Wishlist
            </a>

          <% } else { %>

            <a
              href="/auth/login"
              class="buy-btn"
            >
              <i class="fas fa-sign-in-alt"></i>
              Login to Buy
            </a>

          <% } %>

        </div>


        <!-- =================================================
             DELETE PRODUCT
        ================================================== -->

        <% if (
          user &&
          (
            user.role === "admin" ||
            (
              product.seller &&
              product.seller._id &&
              product.seller._id.toString() ===
              user._id.toString()
            )
          )
        ) { %>

          <div class="delete-section">

            <button
              class="delete-btn"
              onclick="deleteProduct('<%= product._id %>')"
            >
              <i class="fas fa-trash-alt"></i>
              Delete Product
            </button>

          </div>

        <% } %>


      </div>

    </div>

  </main>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       IMAGE GALLERY
    ===================================================== */

    function changeImage(url, element) {

      const mainImage = document.getElementById("mainImage");

      if (mainImage) {
        mainImage.style.opacity = "0.6";
        setTimeout(() => {
          mainImage.src = url;
          mainImage.style.opacity = "1";
        }, 100);
      }

      document
        .querySelectorAll(".thumbnail")
        .forEach(item => item.classList.remove("active"));

      element.classList.add("active");

    }


    /* =====================================================
       ADD TO CART
    ===================================================== */

    async function addToCart(productId) {

      try {

        const response = await fetch(
          `/cart/add/${productId}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            }
          }
        );


        const contentType =
          response.headers.get("content-type") || "";

        let data = {};

        if (contentType.includes("application/json")) {
          data = await response.json();
        }


        if (!response.ok) {
          alert(data.message || "Unable to add product to cart");
          return;
        }


        alert(data.message || "Product added to cart successfully!");

      } catch (error) {

        console.error("Add To Cart Error:", error);
        alert("Something went wrong while adding product to cart.");

      }

    }


    /* =====================================================
       WISHLIST
    ===================================================== */

    async function addToWishlist(productId) {

      try {

        const response = await fetch(
          `/wishlist/add/${productId}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            }
          }
        );


        const contentType =
          response.headers.get("content-type") || "";

        let data = {};

        if (contentType.includes("application/json")) {
          data = await response.json();
        }


        if (!response.ok) {
          alert(data.message || "Unable to add to wishlist");
          return;
        }


        alert(data.message || "Added to wishlist!");

      } catch (error) {

        console.error("Wishlist Error:", error);
        alert("Something went wrong.");

      }

    }


    /* =====================================================
       DELETE PRODUCT
    ===================================================== */

    async function deleteProduct(productId) {

      const confirmed = confirm(
        "Are you sure you want to delete this product?"
      );


      if (!confirmed) return;


      try {

        const response = await fetch(
          `/products/api/${productId}`,
          {
            method: "DELETE"
          }
        );


        const contentType =
          response.headers.get("content-type") || "";

        let data = {};

        if (contentType.includes("application/json")) {
          data = await response.json();
        }


        if (!response.ok || !data.success) {
          throw new Error(data.message || "Unable to delete product");
        }


        alert("Product deleted successfully.");

        window.location.href = "/products/shop";

      } catch (error) {

        console.error("Delete Product Error:", error);
        alert(error.message || "Something went wrong.");

      }

    }


    console.log("Reciclaja — Product Detail page loaded 🌿");

  </script>

</body>

</html>