<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<h1>Shop</h1>

<div class="product-grid">

<% products.forEach(product => { %>

<div class="card">

  <% if(product.image){ %>
    <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>">
  <% } %>

  <h3><%= product.name %></h3>

  <p>₹ <%= product.price %></p>

  <a href="/addtocart/<%= product._id %>">Add To Cart</a>

  <a href="/wishlist/add/<%= product._id %>">Wishlist</a>

</div>

<% }) %>

</div>

</body>
</html>