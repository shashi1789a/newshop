<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Your Cart — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="left"] { transform: translateX(-40px); }
    [data-reveal="right"] { transform: translateX(40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       CART CONTAINER
    ===================================================== */

    .cart-container {
      width: 92%;
      max-width: 1200px;
      margin: 45px auto 80px;
    }

    /* =====================================================
       PAGE HEADER
    ===================================================== */

    .page-header {
      margin-bottom: 34px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
      position: relative;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      flex-wrap: wrap;
    }

    .page-header::after {
      content: "";
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 90px;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 3px;
    }

    .page-header-text {
      flex: 1;
      min-width: 260px;
    }

    .page-header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      border: 1px solid rgba(13, 59, 46, 0.08);
      color: var(--forest-3);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .page-header-eyebrow::before {
      content: "🛒";
      font-size: 12px;
    }

    .page-header h1 {
      font-family: var(--font-serif);
      font-size: 42px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 8px;
    }

    .page-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 14.5px;
      max-width: 560px;
      line-height: 1.65;
    }

    /* =====================================================
       CART COUNT BADGE
    ===================================================== */

    .cart-count {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 12px 20px;
      border-radius: 30px;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.25);
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }

    .cart-count::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .cart-count:hover::before {
      left: 100%;
    }

    .cart-count i {
      font-size: 12px;
      color: var(--mango-soft);
    }

    /* =====================================================
       CART LAYOUT
    ===================================================== */

    .cart-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 28px;
      align-items: start;
    }

    /* =====================================================
       CART ITEMS
    ===================================================== */

    .cart-items {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .cart-item {
      background: var(--surface);
      border: 2px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 24px;
      display: flex;
      gap: 24px;
      align-items: center;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      animation: cardIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    @keyframes cardIn {
      0% { opacity: 0; transform: translateY(24px) scale(0.97); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .cart-item::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .cart-item:hover::before {
      transform: scaleX(1);
    }

    .cart-item:hover {
      transform: translateY(-6px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    /* =====================================================
       PRODUCT IMAGE
    ===================================================== */

    .product-image {
      width: 140px;
      height: 160px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      flex-shrink: 0;
      border: 1px solid var(--border-soft);
      transition: transform 0.35s ease;
      position: relative;
    }

    .cart-item:hover .product-image {
      transform: scale(1.03);
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--text-light);
      font-size: 44px;
    }

    /* =====================================================
       PRODUCT INFO
    ===================================================== */

    .product-info {
      flex: 1;
      min-width: 0;
    }

    .product-info h3 {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.5px;
      line-height: 1.3;
      margin-bottom: 12px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-category {
      color: var(--text-light);
      font-size: 11px;
      margin-bottom: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .product-category i {
      color: var(--mango-deep);
      font-size: 11px;
    }

    .product-condition {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      color: var(--forest-3);
      padding: 6px 13px;
      border-radius: 30px;
      font-size: 10px;
      margin-bottom: 14px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .product-condition::before {
      content: "♻️";
      font-size: 11px;
    }

    .product-price {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -0.8px;
      margin-bottom: 16px;
      line-height: 1;
    }

    /* =====================================================
       QUANTITY CONTROLS
    ===================================================== */

    .quantity-wrapper {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .quantity-label {
      font-size: 11px;
      color: var(--text-light);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
    }

    .quantity-controls {
      display: flex;
      align-items: center;
      border: 2px solid var(--border);
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: var(--surface-2);
      transition: all 0.3s ease;
    }

    .quantity-controls:hover {
      border-color: var(--mango);
      box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.08);
    }

    .quantity-btn {
      width: 40px;
      height: 38px;
      border: none;
      background: transparent;
      color: var(--forest);
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 700;
      transition: all 0.25s ease;
      line-height: 1;
    }

    .quantity-btn:hover {
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
    }

    .quantity-number {
      min-width: 44px;
      height: 38px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: 800;
      color: var(--forest);
      font-size: 14px;
      border-left: 2px solid var(--border);
      border-right: 2px solid var(--border);
      background: #ffffff;
    }

    /* =====================================================
       REMOVE BUTTON
    ===================================================== */

    .remove-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--coral-deep);
      text-decoration: none;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: all 0.25s ease;
      padding: 8px 14px;
      border-radius: 30px;
      background: rgba(249, 115, 98, 0.08);
      border: 1px solid rgba(249, 115, 98, 0.18);
    }

    .remove-btn::before {
      content: "✕";
      font-size: 12px;
      font-weight: 900;
    }

    .remove-btn:hover {
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      color: #ffffff;
      border-color: transparent;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(249, 115, 98, 0.3);
    }

    /* =====================================================
       CART SUMMARY
    ===================================================== */

    .cart-summary {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 28px 26px 24px;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      position: sticky;
      top: 100px;
      position: relative;
      overflow: hidden;
    }

    .cart-summary::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 100%);
    }

    .cart-summary h2 {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.4px;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--border);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cart-summary h2 i {
      color: var(--mango-deep);
      font-size: 18px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0;
      color: var(--text-muted);
      font-size: 13.5px;
      border-bottom: 1px dashed var(--border);
    }

    .summary-row:last-of-type {
      border-bottom: none;
    }

    .summary-row span:first-child {
      font-weight: 600;
    }

    .summary-row span:last-child,
    .summary-row strong {
      color: var(--forest);
      font-weight: 800;
      font-size: 14px;
    }

    .summary-row .free {
      color: var(--emerald) !important;
      font-weight: 800 !important;
      letter-spacing: 0.5px;
    }

    /* Total */

    .summary-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 22px;
      margin-top: 8px;
      border-top: 2px solid var(--border);
      gap: 12px;
    }

    .summary-total span:first-child {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.3px;
    }

    .summary-total span:last-child {
      font-family: var(--font-serif);
      font-size: 30px;
      font-weight: 700;
      letter-spacing: -1px;
      line-height: 1;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* =====================================================
       ORDER BUTTON
    ===================================================== */

    .order-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      text-align: center;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 17px 24px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      margin-top: 24px;
      font-weight: 800;
      font-size: 13.5px;
      letter-spacing: 0.5px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      overflow: hidden;
    }

    .order-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .order-btn:hover::before { left: 100%; }

    .order-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    .order-btn i {
      transition: transform 0.3s ease;
    }

    .order-btn:hover i {
      transform: translateX(4px);
    }

    /* =====================================================
       CLEAR BUTTON
    ===================================================== */

    .clear-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      text-align: center;
      color: var(--coral-deep);
      text-decoration: none;
      margin-top: 14px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 12px 18px;
      border-radius: var(--radius-sm);
      transition: all 0.3s ease;
      border: 1.5px solid rgba(249, 115, 98, 0.18);
      background: rgba(249, 115, 98, 0.04);
    }

    .clear-btn:hover {
      background: linear-gradient(135deg, var(--coral) 0%, var(--coral-deep) 100%);
      color: #ffffff;
      border-color: transparent;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(249, 115, 98, 0.28);
      gap: 12px;
    }

    /* =====================================================
       EMPTY CART
    ===================================================== */

    .empty-cart {
      background:
        radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.06) 0%, transparent 65%),
        var(--surface);
      border: 2px dashed var(--border);
      border-radius: var(--radius-xl);
      padding: 80px 30px;
      text-align: center;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.05);
      position: relative;
      overflow: hidden;
    }

    .empty-cart::before {
      content: "🛒";
      position: absolute;
      font-size: 220px;
      opacity: 0.04;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .empty-icon {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
      color: var(--coral);
      margin: 0 auto 22px;
      box-shadow: 0 12px 32px rgba(249, 115, 98, 0.2);
      position: relative;
      z-index: 2;
    }

    .empty-cart h2 {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.6px;
      margin-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .empty-cart p {
      color: var(--text-muted);
      font-size: 14.5px;
      max-width: 400px;
      margin: 0 auto 26px;
      line-height: 1.65;
      position: relative;
      z-index: 2;
    }

    .shop-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 15px 30px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      z-index: 2;
      overflow: hidden;
    }

    .shop-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .shop-btn:hover::before { left: 100%; }

    .shop-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 900px) {

      .cart-layout {
        grid-template-columns: 1fr;
      }

      .cart-summary {
        position: static;
      }

      .page-header h1 { font-size: 34px; }

    }

    @media (max-width: 700px) {

      .cart-container {
        width: 94%;
        margin: 30px auto 60px;
      }

      .page-header {
        margin-bottom: 26px;
        padding-bottom: 20px;
      }

      .page-header h1 { font-size: 28px; letter-spacing: -1px; }

      .page-header p { font-size: 13.5px; }

      .cart-item {
        padding: 20px;
        gap: 18px;
      }

      .product-image {
        width: 110px;
        height: 130px;
      }

      .product-info h3 { font-size: 18px; }

      .product-price { font-size: 20px; }

      .cart-summary {
        padding: 24px 22px 20px;
      }

      .cart-summary h2 { font-size: 19px; }

      .summary-total span:last-child { font-size: 26px; }

    }

    @media (max-width: 550px) {

      .cart-container {
        width: 94%;
        margin: 25px auto 50px;
      }

      .page-header {
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
      }

      .cart-count {
        justify-content: center;
        width: 100%;
        padding: 11px 18px;
      }

      .cart-item {
        flex-direction: column;
        align-items: stretch;
        padding: 18px;
      }

      .product-image {
        width: 100%;
        height: 220px;
      }

      .product-info h3 {
        font-size: 17px;
      }

      .product-price {
        font-size: 19px;
      }

      .quantity-wrapper {
        flex-wrap: wrap;
      }

      .cart-summary {
        padding: 22px 18px 18px;
      }

      .cart-summary h2 { font-size: 18px; }

      .summary-total span:first-child { font-size: 17px; }

      .summary-total span:last-child { font-size: 24px; }

      .order-btn {
        padding: 15px 20px;
        font-size: 12.5px;
      }

      .clear-btn { font-size: 11px; }

      .empty-cart {
        padding: 55px 22px;
      }

      .empty-icon {
        width: 72px;
        height: 72px;
        font-size: 32px;
      }

      .empty-cart h2 { font-size: 22px; }

    }

  </style>

</head>

<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="cart-container">


    <!-- =================================================
         PAGE HEADER
    ================================================== -->

    <div class="page-header" data-reveal="down">

      <div class="page-header-text">

        <span class="page-header-eyebrow">
          Shopping Bag
        </span>

        <h1>
          Your <em>Cart.</em>
        </h1>

        <p>
          Review your picks, adjust quantities, and check out when you're ready.
          Free delivery on every order.
        </p>

      </div>


      <%
        const totalCartQuantity = (cart || []).reduce(
          (total, item) => total + Number(item.quantity || 1),
          0
        );
      %>


      <span class="cart-count">

        <i class="fas fa-shopping-bag"></i>

        <%= totalCartQuantity %>
        <%= totalCartQuantity === 1 ? 'Item' : 'Items' %>

      </span>

    </div>


    <!-- =================================================
         EMPTY CART
    ================================================== -->

    <% if (!cart || cart.length === 0) { %>


      <div class="empty-cart" data-reveal="zoom-up">

        <div class="empty-icon">
          <i class="fas fa-shopping-bag"></i>
        </div>

        <h2>
          Your Cart is Empty
        </h2>

        <p>
          Looks like you haven't added anything yet. Start exploring our
          sustainable collection and make your first pick.
        </p>

        <a href="/products" class="shop-btn">
          <i class="fas fa-shopping-bag"></i>
          Continue Shopping
        </a>

      </div>


    <% } else { %>


      <!-- =================================================
           CART LAYOUT
      ================================================== -->

      <div class="cart-layout">


        <!-- =================================================
             CART ITEMS
        ================================================== -->

        <div class="cart-items">

          <% cart.forEach((item, index) => { %>

            <% if (item.product) { %>

              <div
                class="cart-item"
                data-reveal="zoom-up"
                data-delay="<%= Math.min(index * 80, 500) %>"
              >


                <!-- IMAGE -->

                <div class="product-image">

                  <% if (
                    item.product.images &&
                    item.product.images.length > 0
                  ) { %>

                    <img
                      src="<%= typeof item.product.images[0] === 'string'
                        ? item.product.images[0]
                        : item.product.images[0].url %>"
                      alt="<%= item.product.name %>"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    >

                    <div
                      class="image-placeholder"
                      style="display:none;"
                    >
                      <i class="fas fa-tshirt"></i>
                    </div>

                  <% } else { %>

                    <div class="image-placeholder">
                      <i class="fas fa-tshirt"></i>
                    </div>

                  <% } %>

                </div>


                <!-- PRODUCT INFO -->

                <div class="product-info">


                  <h3>
                    <%= item.product.name %>
                  </h3>


                  <div class="product-category">

                    <i class="fas fa-tag"></i>

                    <%= item.product.category || "Clothing" %>

                  </div>


                  <% if (item.product.condition) { %>

                    <span class="product-condition">

                      <%= String(item.product.condition).replace(/_/g, " ") %>

                    </span>

                  <% } %>


                  <div class="product-price">

                    ₹ <%= Number(item.product.price || 0).toLocaleString("en-IN") %>

                  </div>


                  <!-- QUANTITY -->

                  <div class="quantity-wrapper">

                    <span class="quantity-label">
                      Quantity
                    </span>

                    <div class="quantity-controls">

                      <a
                        href="/cart/decrease/<%= item.product._id %>"
                        class="quantity-btn"
                        title="Decrease quantity"
                      >
                        −
                      </a>

                      <span class="quantity-number">
                        <%= item.quantity || 1 %>
                      </span>

                      <a
                        href="/cart/increase/<%= item.product._id %>"
                        class="quantity-btn"
                        title="Increase quantity"
                      >
                        +
                      </a>

                    </div>

                  </div>


                  <!-- REMOVE -->

                  <a
                    href="/cart/remove/<%= item.product._id %>"
                    class="remove-btn"
                    onclick="return confirm('Remove this product from cart?')"
                  >
                    Remove
                  </a>


                </div>

              </div>

            <% } %>

          <% }) %>

        </div>


        <!-- =================================================
             CART SUMMARY
        ================================================== -->

        <div class="cart-summary" data-reveal="right" data-delay="200">


          <h2>
            <i class="fas fa-receipt"></i>
            Order Summary
          </h2>


          <!-- TOTAL ITEMS -->

          <div class="summary-row">

            <span>Items</span>

            <span>
              <%= totalCartQuantity %>
            </span>

          </div>


          <!-- SUBTOTAL -->

          <%
            const subtotal = (cart || []).reduce(
              (total, item) => {
                if (!item.product) return total;
                return total +
                  Number(item.product.price || 0) *
                  Number(item.quantity || 1);
              },
              0
            );
          %>

          <div class="summary-row">

            <span>Subtotal</span>

            <span>
              ₹ <%= subtotal.toLocaleString("en-IN") %>
            </span>

          </div>


          <!-- DELIVERY -->

          <div class="summary-row">

            <span>Delivery</span>

            <span class="free">
              FREE
            </span>

          </div>


          <!-- TOTAL -->

          <div class="summary-total">

            <span>Total</span>

            <span>
              ₹ <%= subtotal.toLocaleString("en-IN") %>
            </span>

          </div>


          <!-- PLACE ORDER -->

          <a
            href="/orders/order"
            class="order-btn"
          >

            <i class="fas fa-lock"></i>
            Place Order

          </a>


          <!-- CLEAR CART -->

          <a
            href="/cart/clear"
            class="clear-btn"
            onclick="return confirm('Are you sure you want to clear the cart?')"
          >

            <i class="fas fa-trash-alt"></i>
            Clear Cart

          </a>


        </div>

      </div>

    <% } %>


  </main>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    console.log("Reciclaja — Cart page loaded 🛒");

  </script>

</body>

</html>