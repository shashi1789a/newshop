<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<h1>Your Cart</h1>

<% cart.forEach(item => { %>

<div class="cart-item">

  <h3><%= item.product.name %></h3>

  <p>Quantity: <%= item.quantity %></p>

  <p>₹ <%= item.product.price %></p>

  <a href="/removefromcart/<%= item.product._id %>">
    Remove
  </a>

</div>

<% }) %>

<a href="/orders/order">Place Order</a>

</body>
</html>