<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../partials/head') %>

  <title>Application Submitted — Reciclaja</title>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.25);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

    /* =====================================================
       PAGE WRAPPER
    ===================================================== */

    .pending-page {
      min-height: calc(100vh - 100px);
      padding: 70px 0 90px;
      background:
        radial-gradient(circle at 10% 20%, rgba(245, 158, 11, 0.06) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.06) 0%, transparent 40%),
        linear-gradient(160deg, #fffdf9 0%, #f5efe4 100%);
      position: relative;
      overflow: hidden;
    }

    .pending-page::before {
      content: "";
      position: absolute;
      top: -100px;
      left: -100px;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(251, 191, 36, 0.14) 0%, transparent 70%);
      pointer-events: none;
      filter: blur(60px);
    }

    .pending-page::after {
      content: "";
      position: absolute;
      bottom: -120px;
      right: -120px;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
      pointer-events: none;
      filter: blur(60px);
    }

    /* Floating decorations */

    .pending-float {
      position: absolute;
      color: var(--mango);
      opacity: 0.09;
      pointer-events: none;
      animation: floatY 9s ease-in-out infinite;
      z-index: 1;
    }

    .pending-float.f1 { top: 15%; left: 6%; font-size: 76px; animation-delay: 0s; }
    .pending-float.f2 { top: 70%; right: 8%; font-size: 62px; animation-delay: 2s; }
    .pending-float.f3 { bottom: 10%; left: 12%; font-size: 56px; animation-delay: 4s; }
    .pending-float.f4 { top: 30%; right: 12%; font-size: 48px; animation-delay: 1s; }

    @keyframes floatY {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-22px) rotate(8deg); }
    }

    /* =====================================================
       MAIN CONTAINER
    ===================================================== */

    .pending-container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 20px;
      position: relative;
      z-index: 5;
      text-align: center;
    }

    /* =====================================================
       SUCCESS ICON
    ===================================================== */

    .pending-icon-wrap {
      position: relative;
      width: 140px;
      height: 140px;
      margin: 0 auto 32px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Rotating dashed ring */

    .pending-icon-wrap::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px dashed rgba(245, 158, 11, 0.35);
      animation: spinSlow 24s linear infinite;
    }

    @keyframes spinSlow {
      to { transform: rotate(360deg); }
    }

    /* Soft glow behind */

    .pending-icon-wrap::after {
      content: "";
      position: absolute;
      inset: -20px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(251, 191, 36, 0.25) 0%, transparent 70%);
      filter: blur(20px);
      z-index: -1;
      animation: glowPulse 4s ease-in-out infinite;
    }

    @keyframes glowPulse {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.1); }
    }

    .pending-icon {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--mango) 0%, var(--coral) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 46px;
      color: #ffffff;
      box-shadow:
        0 20px 48px rgba(245, 158, 11, 0.35),
        inset 0 -4px 12px rgba(0, 0, 0, 0.08);
      animation: iconBounce 2.4s ease-in-out infinite;
      position: relative;
      z-index: 2;
    }

    @keyframes iconBounce {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-6px) scale(1.03); }
    }

    /* Small success check badge */

    .pending-check {
      position: absolute;
      bottom: 8px;
      right: 8px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      color: #ffffff;
      border: 3px solid #ffffff;
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
      z-index: 3;
      animation: checkPop 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.4s both;
    }

    @keyframes checkPop {
      0% { transform: scale(0); opacity: 0; }
      60% { transform: scale(1.2); }
      100% { transform: scale(1); opacity: 1; }
    }

    /* =====================================================
       EYEBROW BADGE
    ===================================================== */

    .pending-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.25);
      color: var(--forest-3);
      padding: 8px 18px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 22px;
    }

    .pending-eyebrow i {
      font-size: 11px;
      color: var(--emerald);
    }

    /* =====================================================
       HEADING
    ===================================================== */

    .pending-title {
      font-family: var(--font-serif);
      font-size: 44px;
      font-weight: 500;
      color: var(--forest);
      letter-spacing: -1.4px;
      line-height: 1.12;
      margin-bottom: 18px;
    }

    .pending-title em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .pending-desc {
      font-size: 16px;
      color: var(--text-muted);
      line-height: 1.75;
      max-width: 560px;
      margin: 0 auto 40px;
    }

    .pending-desc strong {
      color: var(--forest);
      font-weight: 700;
    }

    /* =====================================================
       INFO CARD (Main panel)
    ===================================================== */

    .pending-card {
      background: #ffffff;
      border-radius: var(--radius-lg);
      padding: 40px 36px;
      box-shadow: 0 20px 60px rgba(13, 59, 46, 0.1);
      border: 1px solid var(--border-soft);
      position: relative;
      overflow: hidden;
      margin-bottom: 32px;
      text-align: left;
    }

    .pending-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
    }

    .pending-card::after {
      content: "♻️";
      position: absolute;
      font-size: 180px;
      opacity: 0.03;
      right: -40px;
      bottom: -60px;
      transform: rotate(-15deg);
      pointer-events: none;
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 26px;
      position: relative;
      z-index: 2;
    }

    .card-header-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.25);
    }

    .card-header h3 {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.4px;
      line-height: 1.2;
    }

    .card-header p {
      font-size: 13px;
      color: var(--text-light);
      margin-top: 2px;
    }

    /* =====================================================
       TIMELINE STEPS
    ===================================================== */

    .pending-steps {
      display: flex;
      flex-direction: column;
      gap: 22px;
      position: relative;
      z-index: 2;
    }

    .pending-step {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      position: relative;
    }

    .pending-step-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
      transition: transform 0.35s ease;
      position: relative;
      z-index: 2;
    }

    .pending-step:hover .pending-step-icon {
      transform: scale(1.08) rotate(-6deg);
    }

    .pending-step.active .pending-step-icon {
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .pending-step.current .pending-step-icon {
      background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%);
      color: var(--forest);
      box-shadow: 0 8px 20px rgba(245, 158, 11, 0.35);
      animation: stepPulse 2s ease-in-out infinite;
    }

    @keyframes stepPulse {
      0%, 100% { box-shadow: 0 8px 20px rgba(245, 158, 11, 0.35); }
      50% { box-shadow: 0 8px 28px rgba(245, 158, 11, 0.55); }
    }

    .pending-step.pending .pending-step-icon {
      background: var(--surface-2);
      color: var(--text-light);
      border: 2px solid var(--border);
    }

    /* Connecting line */

    .pending-step:not(:last-child)::before {
      content: "";
      position: absolute;
      left: 20px;
      top: 46px;
      bottom: -22px;
      width: 2px;
      background: linear-gradient(180deg, var(--border) 0%, transparent 100%);
      z-index: 1;
    }

    .pending-step.active:not(:last-child)::before {
      background: linear-gradient(180deg, var(--emerald) 0%, var(--border) 100%);
    }

    .pending-step-content {
      flex: 1;
      padding-top: 4px;
    }

    .pending-step-content h4 {
      font-size: 14.5px;
      font-weight: 800;
      color: var(--forest);
      margin-bottom: 4px;
      letter-spacing: -0.2px;
    }

    .pending-step-content p {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.55;
      margin: 0;
    }

    .pending-step-status {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 4px 10px;
      border-radius: 20px;
      display: inline-block;
      margin-top: 6px;
    }

    .pending-step-status.done {
      background: rgba(16, 185, 129, 0.12);
      color: var(--forest-3);
    }

    .pending-step-status.in-progress {
      background: rgba(245, 158, 11, 0.12);
      color: var(--mango-deep);
    }

    .pending-step-status.waiting {
      background: var(--surface-2);
      color: var(--text-light);
    }

    /* =====================================================
       INFO NOTICE BOX
    ===================================================== */

    .pending-notice {
      background:
        radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.1) 0%, transparent 50%),
        linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      border: 1px solid rgba(16, 185, 129, 0.18);
      border-radius: var(--radius);
      padding: 20px 24px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 32px;
      text-align: left;
      position: relative;
      overflow: hidden;
    }

    .pending-notice::before {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 1px solid rgba(16, 185, 129, 0.15);
      pointer-events: none;
    }

    .pending-notice-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.28);
      position: relative;
      z-index: 2;
    }

    .pending-notice-content {
      position: relative;
      z-index: 2;
      flex: 1;
    }

    .pending-notice-content strong {
      display: block;
      font-size: 13.5px;
      color: var(--forest);
      font-weight: 800;
      margin-bottom: 4px;
      letter-spacing: -0.1px;
    }

    .pending-notice-content p {
      font-size: 12.5px;
      color: var(--forest-3);
      line-height: 1.6;
      margin: 0;
      font-weight: 500;
    }

    .pending-notice-content a {
      color: var(--mango-deep);
      font-weight: 800;
      text-decoration: underline;
      text-decoration-color: rgba(245, 158, 11, 0.4);
      text-underline-offset: 2px;
    }

    .pending-notice-content a:hover {
      color: var(--coral);
      text-decoration-color: var(--coral);
    }

    /* =====================================================
       ACTION BUTTONS
    ===================================================== */

    .pending-actions {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .pending-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 15px 32px;
      border-radius: var(--radius-sm);
      font-size: 13.5px;
      font-weight: 800;
      letter-spacing: 0.3px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      font-family: inherit;
      border: none;
      cursor: pointer;
    }

    .pending-btn.primary {
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
    }

    .pending-btn.primary::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(251, 191, 36, 0.35),
        transparent
      );
      transition: left 0.6s ease;
    }

    .pending-btn.primary:hover::before { left: 100%; }

    .pending-btn.primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    .pending-btn.secondary {
      background: #ffffff;
      color: var(--forest);
      border: 2px solid var(--forest);
      box-shadow: var(--shadow-sm);
    }

    .pending-btn.secondary:hover {
      background: var(--forest);
      color: #ffffff;
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(13, 59, 46, 0.22);
      gap: 14px;
    }

    .pending-btn i {
      transition: transform 0.3s ease;
    }

    .pending-btn:hover i {
      transform: translateX(4px);
    }

    /* =====================================================
       TRUST STRIP
    ===================================================== */

    .pending-trust {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 40px;
      padding-top: 26px;
      border-top: 1px dashed var(--border);
      flex-wrap: wrap;
    }

    .pending-trust-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11.5px;
      color: var(--text-light);
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .pending-trust-item i {
      color: var(--emerald);
      font-size: 13px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 768px) {

      .pending-page { padding: 50px 0 70px; }

      .pending-title { font-size: 34px; letter-spacing: -1px; }

      .pending-desc { font-size: 14.5px; }

      .pending-icon-wrap {
        width: 120px;
        height: 120px;
        margin-bottom: 24px;
      }

      .pending-icon {
        width: 88px;
        height: 88px;
        font-size: 40px;
      }

      .pending-check {
        width: 34px;
        height: 34px;
        font-size: 14px;
        bottom: 6px;
        right: 6px;
      }

      .pending-card { padding: 32px 26px; }

      .card-header h3 { font-size: 19px; }

    }

    @media (max-width: 560px) {

      .pending-page { padding: 40px 0 60px; }

      .pending-float { display: none; }

      .pending-title { font-size: 27px; letter-spacing: -0.8px; }

      .pending-desc { font-size: 13.5px; margin-bottom: 30px; }

      .pending-eyebrow {
        font-size: 9.5px;
        padding: 6px 14px;
        letter-spacing: 1.5px;
      }

      .pending-icon-wrap {
        width: 104px;
        height: 104px;
      }

      .pending-icon {
        width: 76px;
        height: 76px;
        font-size: 34px;
      }

      .pending-check {
        width: 30px;
        height: 30px;
        font-size: 12px;
      }

      .pending-card {
        padding: 26px 20px;
        border-radius: 18px;
      }

      .card-header-icon {
        width: 42px;
        height: 42px;
        font-size: 16px;
      }

      .card-header h3 { font-size: 17px; }

      .card-header p { font-size: 11.5px; }

      .pending-step-icon {
        width: 38px;
        height: 38px;
        font-size: 13px;
      }

      .pending-step-content h4 { font-size: 13.5px; }

      .pending-step-content p { font-size: 12px; }

      .pending-notice {
        padding: 16px 18px;
        border-radius: 14px;
      }

      .pending-notice-icon {
        width: 38px;
        height: 38px;
        font-size: 14px;
      }

      .pending-notice-content strong { font-size: 12.5px; }

      .pending-notice-content p { font-size: 11.5px; }

      .pending-btn {
        width: 100%;
        justify-content: center;
        padding: 13px 24px;
        font-size: 12.5px;
      }

      .pending-trust { gap: 14px; }

      .pending-trust-item { font-size: 10.5px; }

    }

  </style>

</head>

<body>

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       APPLICATION SUBMITTED PAGE
  ====================================================== -->

  <div class="pending-page">

    <!-- Floating decorations -->
    <i class="fas fa-hourglass-half pending-float f1"></i>
    <i class="fas fa-recycle pending-float f2"></i>
    <i class="fas fa-leaf pending-float f3"></i>
    <i class="fas fa-check-circle pending-float f4"></i>


    <div class="pending-container">

      <!-- =====================================================
           ANIMATED ICON
      ====================================================== -->

      <div class="pending-icon-wrap">

        <div class="pending-icon">
          <i class="fas fa-hourglass-half"></i>
        </div>

        <div class="pending-check">
          <i class="fas fa-check"></i>
        </div>

      </div>


      <!-- =====================================================
           EYEBROW
      ====================================================== -->

      <span class="pending-eyebrow">
        <i class="fas fa-paper-plane"></i>
        Application Received
      </span>


      <!-- =====================================================
           HEADING
      ====================================================== -->

      <h1 class="pending-title">
        Thanks, <em><%= name %>!</em><br>
        Your seller application is in.
      </h1>

      <p class="pending-desc">
        We've received your business details and our team is reviewing
        everything carefully. You'll get an email at the address you
        provided as soon as your account is approved.
      </p>


      <!-- =====================================================
           STATUS TIMELINE CARD
      ====================================================== -->

      <div class="pending-card">

        <div class="card-header">
          <div class="card-header-icon">
            <i class="fas fa-clipboard-check"></i>
          </div>
          <div>
            <h3>What Happens Next</h3>
            <p>Your application review timeline</p>
          </div>
        </div>


        <div class="pending-steps">

          <!-- Step 1 — Done -->

          <div class="pending-step active">
            <div class="pending-step-icon">
              <i class="fas fa-check"></i>
            </div>
