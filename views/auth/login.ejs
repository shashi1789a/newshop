<!DOCTYPE html>
<html lang="en">
<head>

  <%- include('../partials/head') %>

  <title>Login</title>

</head>

<body>

  <%- include('../partials/navbar') %>

  <div class="auth-container">

    <form action="/auth/login" method="POST" class="auth-form">

      <h2>Login</h2>

      <!-- ERRORS -->
      <% if (errors && errors.length > 0) { %>

        <div class="error-box">

          <% errors.forEach(error => { %>
            <p><%= error.msg %></p>
          <% }) %>

        </div>

      <% } %>

      <!-- EMAIL -->
      <input
        type="email"
        name="email"
        placeholder="Enter Email"
        value="<%= oldInput?.email || '' %>"
        required
      >

      <!-- PASSWORD -->
      <input
        type="password"
        name="password"
        placeholder="Enter Password"
        required
      >

      <button type="submit">
        Login
      </button>

      <p>
        Don't have account?
        <a href="/auth/register">
          Register
        </a>
      </p>

    </form>

  </div>

</body>
</html>