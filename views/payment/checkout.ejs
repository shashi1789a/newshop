<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Secure Payment — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <!-- Razorpay SDK -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    button { font-family: inherit; cursor: pointer; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       PAGE WRAPPER
    ===================================================== */

    .payment-page {
      min-height: calc(100vh - 100px);
      padding: 55px 0 90px;
      position: relative;
      overflow: hidden;
    }

    .payment-page::before {
      content: "";
      position: absolute;
      top: -120px;
      right: -120px;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.14) 0%, transparent 70%);
      filter: blur(60px);
      pointer-events: none;
    }

    .payment-page::after {
      content: "";
      position: absolute;
      bottom: -140px;
      left: -140px;
      width: 460px;
      height: 460px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
      filter: blur(60px);
      pointer-events: none;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 22px;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       PAGE HEADER
    ===================================================== */

    .page-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .page-header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      border: 1px solid rgba(13, 59, 46, 0.08);
      color: var(--forest-3);
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }

    .page-header-eyebrow::before {
      content: "🔒";
      font-size: 12px;
    }

    .page-header h1 {
      font-family: var(--font-serif);
      font-size: 42px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 10px;
    }

    .page-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 15px;
      max-width: 460px;
      margin: 0 auto;
      line-height: 1.65;
    }

    /* =====================================================
       PAYMENT CARD
    ===================================================== */

    .payment-card {
      background: var(--surface);
      border-radius: var(--radius-xl);
      padding: 42px 40px 38px;
      box-shadow: 0 24px 80px rgba(13, 59, 46, 0.14);
      border: 1px solid var(--border-soft);
      position: relative;
      overflow: hidden;
    }

    .payment-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
    }

    .payment-card::after {
      content: "";
      position: absolute;
      top: -80px;
      right: -80px;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      border: 1px solid rgba(16, 185, 129, 0.08);
      pointer-events: none;
    }

    /* =====================================================
       LOGO / BRAND
    ===================================================== */

    .logo {
      text-align: center;
      margin-bottom: 8px;
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.25);
    }

    .logo-text {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -0.8px;
    }

    .logo-text span {
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .subtitle {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 30px;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.3px;
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .subtitle i {
      color: var(--emerald);
      font-size: 12px;
    }

    /* =====================================================
       AMOUNT BOX
    ===================================================== */

    .amount-box {
      background:
        radial-gradient(circle at 90% 20%, rgba(245, 158, 11, 0.12) 0%, transparent 60%),
        linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      border: 1px solid rgba(245, 158, 11, 0.18);
      border-radius: var(--radius);
      padding: 32px 24px;
      text-align: center;
      margin-bottom: 26px;
      position: relative;
      overflow: hidden;
    }

    .amount-box::before {
      content: "₹";
      position: absolute;
      font-family: var(--font-serif);
      font-size: 220px;
      font-weight: 700;
      opacity: 0.05;
      right: -30px;
      bottom: -80px;
      line-height: 1;
      pointer-events: none;
    }

    .amount-label {
      color: var(--mango-deep);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 12px;
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .amount-label::before,
    .amount-label::after {
      content: "";
      width: 24px;
      height: 1.5px;
      background: var(--mango-deep);
      border-radius: 2px;
      opacity: 0.5;
    }

    .amount {
      font-family: var(--font-serif);
      font-size: 52px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -2px;
      line-height: 1;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       ORDER INFO
    ===================================================== */

    .order-info {
      background: var(--surface-2);
      border-radius: var(--radius);
      padding: 24px 26px;
      margin-bottom: 26px;
      position: relative;
      z-index: 2;
      border: 1px solid var(--border-soft);
    }

    .row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 13px 0;
      border-bottom: 1px dashed var(--border);
      transition: all 0.25s ease;
    }

    .row:hover {
      padding-left: 4px;
    }

    .row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .row:first-child {
      padding-top: 0;
    }

    .label {
      color: var(--text-light);
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .label i {
      color: var(--mango-deep);
      font-size: 11px;
      width: 14px;
      text-align: center;
    }

    .value {
      font-weight: 700;
      text-align: right;
      color: var(--forest);
      font-size: 14px;
      word-break: break-word;
      letter-spacing: -0.1px;
      max-width: 60%;
    }

    .value.payment-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: linear-gradient(135deg, var(--sky) 0%, var(--sky-2) 100%);
      color: #2b7de0;
      border-radius: 30px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      border: 1px solid rgba(43, 125, 224, 0.2);
    }

    .value.payment-pill::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 8px currentColor;
    }

    /* =====================================================
       PAY BUTTON
    ===================================================== */

    .pay-button {
      width: 100%;
      padding: 18px 26px;
      border: none;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      font-family: inherit;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.5px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      overflow: hidden;
      margin-bottom: 18px;
      z-index: 2;
    }

    .pay-button::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .pay-button:hover::before { left: 100%; }

    .pay-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    .pay-button:disabled {
      background: linear-gradient(135deg, var(--text-light) 0%, var(--text-muted) 100%);
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .pay-button:disabled::before {
      display: none;
    }

    /* =====================================================
       BACK BUTTON
    ===================================================== */

    .back-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: var(--forest-3);
      text-decoration: none;
      margin-top: 8px;
      font-size: 13px;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: var(--radius-sm);
      transition: all 0.3s ease;
      width: 100%;
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .back-button:hover {
      background: var(--surface-2);
      color: var(--mango-deep);
      gap: 12px;
    }

    /* =====================================================
       SECURE NOTE
    ===================================================== */

    .secure {
      text-align: center;
      color: var(--text-light);
      font-size: 12px;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px dashed var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 600;
      position: relative;
      z-index: 2;
    }

    .secure i {
      color: var(--emerald);
      font-size: 12px;
    }

    /* =====================================================
       ERROR BOX
    ===================================================== */

    .error {
      display: none;
      margin-top: 6px;
      margin-bottom: 16px;
      padding: 14px 18px;
      background: rgba(249, 115, 98, 0.08);
      color: var(--coral-deep);
      border: 1px solid rgba(249, 115, 98, 0.28);
      border-left: 4px solid var(--coral);
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.5;
      align-items: flex-start;
      gap: 10px;
      position: relative;
      z-index: 2;
      animation: alertIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes alertIn {
      0% { opacity: 0; transform: translateY(-10px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    .error.show {
      display: flex;
    }

    .error::before {
      content: "⚠";
      font-size: 15px;
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* =====================================================
       TRUST BADGES
    ===================================================== */

    .trust-badges {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 18px;
      flex-wrap: wrap;
      position: relative;
      z-index: 2;
    }

    .trust-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      border: 1px solid rgba(16, 185, 129, 0.15);
      border-radius: 30px;
      font-size: 10.5px;
      color: var(--forest-3);
      font-weight: 800;
      letter-spacing: 0.3px;
    }

    .trust-badge i {
      color: var(--emerald);
      font-size: 11px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 600px) {

      .payment-page {
        padding: 35px 0 60px;
      }

      .container {
        padding: 0 16px;
      }

      .page-header h1 {
        font-size: 32px;
        letter-spacing: -1px;
      }

      .page-header p {
        font-size: 13.5px;
      }

      .payment-card {
        padding: 32px 24px 28px;
        border-radius: var(--radius-lg);
      }

      .logo-text {
        font-size: 24px;
      }

      .logo-icon {
        width: 38px;
        height: 38px;
        font-size: 16px;
      }

      .subtitle {
        font-size: 12.5px;
      }

      .amount-box {
        padding: 26px 20px;
      }

      .amount {
        font-size: 42px;
        letter-spacing: -1.5px;
      }

      .amount-box::before {
        font-size: 180px;
        right: -20px;
        bottom: -60px;
      }

      .order-info {
        padding: 20px 20px;
      }

      .row {
        padding: 11px 0;
      }

      .value {
        font-size: 13px;
        max-width: 55%;
      }

      .pay-button {
        padding: 16px 22px;
        font-size: 13px;
      }

      .trust-badges {
        gap: 8px;
      }

      .trust-badge {
        font-size: 10px;
        padding: 6px 11px;
      }

    }

    @media (max-width: 420px) {

      .page-header h1 { font-size: 26px; }

      .payment-card {
        padding: 28px 20px 24px;
      }

      .amount { font-size: 36px; }

      .amount-box::before {
        font-size: 150px;
        bottom: -50px;
      }

      .row {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
      }

      .value {
        text-align: left;
        max-width: 100%;
      }

      .label {
        font-size: 10px;
      }

      .pay-button {
        padding: 15px 20px;
        font-size: 12.5px;
      }

    }

  </style>

</head>


<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       PAYMENT PAGE
  ====================================================== -->

  <div class="payment-page">

    <div class="container">


      <!-- =================================================
           PAGE HEADER
      ================================================== -->

      <div class="page-header" data-reveal="down">

        <span class="page-header-eyebrow">
          Secure Checkout
        </span>

        <h1>
          Complete Your <em>Payment.</em>
        </h1>

        <p>
          Your order is ready. Pay securely via Razorpay using UPI, cards,
          or net banking — protected end to end.
        </p>

      </div>


      <!-- =================================================
           PAYMENT CARD
      ================================================== -->

      <div class="payment-card" data-reveal="zoom-up" data-delay="120">


        <!-- BRAND -->

        <div class="logo">

          <div class="logo-icon">
            <i class="fas fa-recycle"></i>
          </div>

          <div class="logo-text">
            Recicl<span>aja</span>
          </div>

        </div>


        <div class="subtitle">
          <i class="fas fa-shield-alt"></i>
          Secure Payment
        </div>


        <!-- AMOUNT BOX -->

        <div class="amount-box">

          <div class="amount-label">
            Amount Payable
          </div>

          <div class="amount">

            ₹<%= Number(
              order.totalAmount || 0
            ).toLocaleString("en-IN") %>

          </div>

        </div>


        <!-- ORDER INFO -->

        <div class="order-info">


          <div class="row">

            <span class="label">
              <i class="fas fa-hashtag"></i>
              Order ID
            </span>

            <span class="value">

              #<%= order._id
                .toString()
                .slice(-8)
                .toUpperCase() %>

            </span>

          </div>


          <div class="row">

            <span class="label">
              <i class="fas fa-user"></i>
              Customer
            </span>

            <span class="value">
              <%= order.shippingAddress.name %>
            </span>

          </div>


          <div class="row">

            <span class="label">
              <i class="fas fa-phone"></i>
              Phone
            </span>

            <span class="value">
              <%= order.shippingAddress.phone %>
            </span>

          </div>


          <div class="row">

            <span class="label">
              <i class="fas fa-credit-card"></i>
              Payment
            </span>

            <span class="value payment-pill">
              Razorpay
            </span>

          </div>


        </div>


        <!-- ERROR BOX -->

        <div
          id="errorBox"
          class="error"
        ></div>


        <!-- PAY BUTTON -->

        <button
          type="button"
          id="payButton"
          class="pay-button"
        >

          <i class="fas fa-lock"></i>

          Pay ₹<%= Number(
            order.totalAmount || 0
          ).toLocaleString("en-IN") %>

        </button>


        <!-- BACK -->

        <a
          href="/orders/<%= order._id %>"
          class="back-button"
        >

          <i class="fas fa-arrow-left"></i>
          Back to Order

        </a>


        <!-- SECURE -->

        <div class="secure">

          <i class="fas fa-shield-alt"></i>
          Secured & powered by Razorpay

        </div>


        <!-- TRUST BADGES -->

        <div class="trust-badges">

          <span class="trust-badge">
            <i class="fas fa-lock"></i>
            256-bit SSL
          </span>

          <span class="trust-badge">
            <i class="fas fa-user-shield"></i>
            PCI Compliant
          </span>

          <span class="trust-badge">
            <i class="fas fa-undo-alt"></i>
            Instant Refunds
          </span>

        </div>


      </div>

    </div>

  </div>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       RAZORPAY PAYMENT
    ===================================================== */

    const payButton = document.getElementById("payButton");
    const errorBox = document.getElementById("errorBox");


    // ==================================================
    // SHOW ERROR
    // ==================================================

    function showError(message) {

      errorBox.innerText = message;
      errorBox.classList.add("show");

    }


    function hideError() {

      errorBox.innerText = "";
      errorBox.classList.remove("show");

    }


    // ==================================================
    // PAY NOW
    // ==================================================

    payButton.addEventListener("click", async function () {

      try {

        hideError();

        payButton.disabled = true;

        payButton.innerHTML =
          '<i class="fas fa-spinner fa-spin"></i> Creating Payment...';


        // ==============================================
        // CREATE RAZORPAY ORDER
        // ==============================================

        const response = await fetch(
          "/payment/create-order/<%= order._id %>",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
          }
        );


        const data = await response.json();


        if (!response.ok || !data.success) {

          throw new Error(
            data.message || "Unable to create payment"
          );

        }


        // ==============================================
        // RAZORPAY OPTIONS
        // ==============================================

        const options = {

          key: data.keyId,

          amount: data.amount,

          currency: data.currency,

          name: "Reciclaja",

          description: "Sustainable Fashion Order",

          order_id: data.razorpayOrderId,


          prefill: {

            name: data.customerName,

            contact: data.customerPhone,

          },


          theme: {

            color: "#0d3b2e",

          },


          // ============================================
          // PAYMENT SUCCESS
          // ============================================

          handler: async function (razorpayResponse) {

            try {

              payButton.disabled = true;

              payButton.innerHTML =
                '<i class="fas fa-spinner fa-spin"></i> Verifying Payment...';


              const verifyResponse = await fetch(
                "/payment/verify",
                {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify({

                    orderId: "<%= order._id %>",

                    razorpay_order_id:
                      razorpayResponse.razorpay_order_id,

                    razorpay_payment_id:
                      razorpayResponse.razorpay_payment_id,

                    razorpay_signature:
                      razorpayResponse.razorpay_signature,

                  }),
                }
              );


              const verifyData = await verifyResponse.json();


              if (!verifyResponse.ok || !verifyData.success) {

                throw new Error(
                  verifyData.message || "Payment verification failed"
                );

              }


              // ======================================
              // SUCCESS
              // ======================================

              window.location.href =
                "/payment/success/<%= order._id %>";


            } catch (error) {

              console.error("Verification Error:", error);

              showError(error.message);

              payButton.disabled = false;

              payButton.innerHTML =
                '<i class="fas fa-redo"></i> Try Payment Again';

            }

          },


          // ============================================
          // MODAL CLOSE
          // ============================================

          modal: {

            ondismiss: function () {

              payButton.disabled = false;

              payButton.innerHTML =
                '<i class="fas fa-lock"></i> Pay Now';

            },

          },

        };


        // ==============================================
        // OPEN RAZORPAY
        // ==============================================

        const razorpay = new Razorpay(options);


        razorpay.on("payment.failed", async function (response) {

          console.error("Payment Failed:", response);


          try {

            await fetch("/payment/failed", {

              method: "POST",

              headers: {
                "Content-Type": "application/json",
              },

              body: JSON.stringify({

                orderId: "<%= order._id %>",

                razorpayOrderId:
                  response.error?.metadata?.order_id,

                reason: response.error?.description,

                code: response.error?.code,

              }),

            });

          } catch (error) {

            console.error("Failed Payment Save Error:", error);

          }


          showError(
            response.error?.description || "Payment failed"
          );


          payButton.disabled = false;

          payButton.innerHTML =
            '<i class="fas fa-redo"></i> Try Payment Again';

        });


        razorpay.open();


      } catch (error) {

        console.error("Payment Error:", error);

        showError(error.message || "Something went wrong");

        payButton.disabled = false;

        payButton.innerHTML =
          '<i class="fas fa-redo"></i> Try Payment Again';

      }

    });


    console.log("Reciclaja — Secure Payment page loaded 🔒");

  </script>

</body>

</html>