<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Confirm Payment — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      overflow-x: hidden;
    }

    button, input, select { font: inherit; }
    button { cursor: pointer; font-family: inherit; }
    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       PAGE WRAPPER
    ===================================================== */

    .payment-page {
      min-height: calc(100vh - 100px);
      padding: 50px 0 80px;
      position: relative;
      overflow: hidden;
    }

    .payment-page::before {
      content: "";
      position: absolute;
      top: -100px;
      right: -100px;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(251, 191, 36, 0.14) 0%, transparent 70%);
      filter: blur(60px);
      pointer-events: none;
    }

    .payment-page::after {
      content: "";
      position: absolute;
      bottom: -120px;
      left: -120px;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
      filter: blur(60px);
      pointer-events: none;
    }

    .payment-container {
      width: 92%;
      max-width: 620px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       PAGE HEADER
    ===================================================== */

    .page-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .page-header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      border: 1px solid rgba(13, 59, 46, 0.08);
      color: var(--forest-3);
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 16px;
    }

    .page-header-eyebrow::before {
      content: "💳";
      font-size: 12px;
    }

    .page-header h1 {
      font-family: var(--font-serif);
      font-size: 44px;
      font-weight: 500;
      letter-spacing: -1.6px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 12px;
    }

    .page-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 15px;
      max-width: 460px;
      margin: 0 auto;
      line-height: 1.65;
    }

    /* =====================================================
       PAYMENT CARD
    ===================================================== */

    .payment-card {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(13, 59, 46, 0.1);
      position: relative;
    }

    .payment-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      z-index: 2;
    }

    /* =====================================================
       TOTAL AMOUNT DISPLAY
    ===================================================== */

    .total-display {
      background:
        radial-gradient(circle at 90% 20%, rgba(245, 158, 11, 0.12) 0%, transparent 60%),
        linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      padding: 36px 32px 34px;
      text-align: center;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid var(--border-soft);
    }

    .total-display::before {
      content: "₹";
      position: absolute;
      font-family: var(--font-serif);
      font-size: 280px;
      font-weight: 700;
      opacity: 0.05;
      right: -40px;
      bottom: -100px;
      pointer-events: none;
      line-height: 1;
    }

    .total-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--mango-deep);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 12px;
      position: relative;
      z-index: 2;
    }

    .total-label::before,
    .total-label::after {
      content: "";
      width: 24px;
      height: 1.5px;
      background: var(--mango-deep);
      border-radius: 2px;
      opacity: 0.5;
    }

    .total-amount {
      font-family: var(--font-serif);
      font-size: 56px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -2.5px;
      line-height: 1;
      position: relative;
      z-index: 2;
      display: block;
    }

    .total-caption {
      color: var(--forest-3);
      font-size: 13px;
      margin-top: 10px;
      font-weight: 600;
      position: relative;
      z-index: 2;
    }

    /* =====================================================
       PAYMENT METHOD SECTION
    ===================================================== */

    .payment-body {
      padding: 32px 32px 28px;
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      font-weight: 800;
      color: var(--forest);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 18px;
    }

    .section-label i {
      width: 30px;
      height: 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, var(--mint) 0%, var(--mint-2) 100%);
      border-radius: 9px;
      color: var(--emerald);
      font-size: 13px;
    }

    /* =====================================================
       PAYMENT OPTION
    ===================================================== */

    .payment-option {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px 22px;
      border: 2px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface-2);
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      margin-bottom: 14px;
    }

    .payment-option::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--mango) 0%, var(--coral) 100%);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.35s ease;
    }

    .payment-option:hover {
      border-color: var(--mango);
      background: #ffffff;
      transform: translateX(3px);
      box-shadow: var(--shadow-mango);
    }

    .payment-option:hover::before {
      transform: scaleY(1);
    }

    .payment-option.selected {
      border-color: var(--forest);
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      box-shadow: 0 10px 28px rgba(16, 185, 129, 0.18);
    }

    .payment-option.selected::before {
      transform: scaleY(1);
      background: linear-gradient(180deg, var(--emerald) 0%, var(--forest-3) 100%);
    }

    .payment-option input[type="radio"] {
      width: 20px;
      height: 20px;
      accent-color: var(--forest);
      cursor: pointer;
      flex-shrink: 0;
    }

    .payment-option-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--mango) 0%, var(--mango-soft) 100%);
      color: var(--forest);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(245, 158, 11, 0.28);
      transition: transform 0.35s ease;
    }

    .payment-option:hover .payment-option-icon {
      transform: scale(1.08) rotate(-6deg);
    }

    .payment-option-text {
      flex: 1;
      min-width: 0;
    }

    .payment-option-title {
      font-family: var(--font-serif);
      font-size: 16px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.3px;
      margin-bottom: 3px;
    }

    .payment-option-desc {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .payment-option-check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: transparent;
      font-size: 11px;
      flex-shrink: 0;
      transition: all 0.3s ease;
      background: #ffffff;
    }

    .payment-option.selected .payment-option-check {
      border-color: var(--emerald);
      background: linear-gradient(135deg, var(--emerald) 0%, var(--forest-3) 100%);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }

    /* =====================================================
       INFO NOTICE
    ===================================================== */

    .info-notice {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 16px 18px;
      background: linear-gradient(135deg, var(--sky) 0%, var(--sky-2) 100%);
      border: 1px solid rgba(43, 125, 224, 0.18);
      border-left: 3px solid #2b7de0;
      border-radius: var(--radius-sm);
      margin-bottom: 26px;
    }

    .info-notice-icon {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, #2b7de0 0%, #1e5fb8 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      flex-shrink: 0;
      box-shadow: 0 4px 10px rgba(43, 125, 224, 0.28);
    }

    .info-notice-text {
      flex: 1;
    }

    .info-notice-text strong {
      display: block;
      font-size: 12.5px;
      color: #1e5fb8;
      font-weight: 800;
      margin-bottom: 3px;
      letter-spacing: -0.1px;
    }

    .info-notice-text p {
      font-size: 12px;
      color: #4a6fa5;
      line-height: 1.55;
      margin: 0;
      font-weight: 500;
    }

    /* =====================================================
       CONFIRM BUTTON
    ===================================================== */

    .confirm-btn {
      width: 100%;
      border: none;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 18px 26px;
      border-radius: var(--radius-sm);
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      overflow: hidden;
      font-family: inherit;
    }

    .confirm-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .confirm-btn:hover::before { left: 100%; }

    .confirm-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    .confirm-btn:disabled {
      background: linear-gradient(135deg, var(--text-light) 0%, var(--text-muted) 100%);
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    /* =====================================================
       TRUST STRIP
    ===================================================== */

    .trust-strip {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px dashed var(--border);
      flex-wrap: wrap;
    }

    .trust-item {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 11px;
      color: var(--text-light);
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .trust-item i {
      color: var(--emerald);
      font-size: 12px;
    }

    /* =====================================================
       BACK LINK
    ===================================================== */

    .back-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
      color: var(--forest-3);
      font-size: 13px;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: var(--radius-sm);
      transition: all 0.3s ease;
      width: 100%;
      text-align: center;
    }

    .back-link:hover {
      background: var(--surface-2);
      color: var(--mango-deep);
      gap: 12px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 600px) {

      .payment-page {
        padding: 30px 0 60px;
      }

      .payment-container {
        width: 94%;
      }

      .page-header h1 {
        font-size: 32px;
        letter-spacing: -1px;
      }

      .page-header p {
        font-size: 13.5px;
      }

      .total-display {
        padding: 30px 22px 28px;
      }

      .total-amount {
        font-size: 44px;
        letter-spacing: -2px;
      }

      .total-display::before {
        font-size: 220px;
        right: -30px;
        bottom: -80px;
      }

      .payment-body {
        padding: 26px 22px 24px;
      }

      .payment-option {
        padding: 16px 18px;
        gap: 14px;
      }

      .payment-option-icon {
        width: 40px;
        height: 40px;
        font-size: 16px;
      }

      .payment-option-title {
        font-size: 14.5px;
      }

      .payment-option-desc {
        font-size: 11.5px;
      }

      .confirm-btn {
        padding: 16px 22px;
        font-size: 13px;
      }

      .trust-strip {
        gap: 14px;
      }

      .trust-item {
        font-size: 10.5px;
      }

    }

  </style>

</head>

<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       PAYMENT PAGE
  ====================================================== -->

  <div class="payment-page">

    <div class="payment-container">


      <!-- =================================================
           PAGE HEADER
      ================================================== -->

      <div class="page-header" data-reveal="down">

        <span class="page-header-eyebrow">
          Secure Payment
        </span>

        <h1>
          Confirm Your <em>Payment.</em>
        </h1>

        <p>
          Review your order total and choose your preferred payment method
          to complete your order.
        </p>

      </div>


      <!-- =================================================
           PAYMENT CARD
      ================================================== -->

      <div class="payment-card" data-reveal="zoom-up" data-delay="120">


        <!-- =================================================
             TOTAL AMOUNT DISPLAY
        ================================================== -->

        <div class="total-display">

          <span class="total-label">
            Total Amount
          </span>

          <span class="total-amount">
            ₹<%= Number(totalAmount || 0).toLocaleString("en-IN") %>
          </span>

          <div class="total-caption">
            Amount payable for this order
          </div>

        </div>


        <!-- =================================================
             PAYMENT BODY
        ================================================== -->

        <div class="payment-body">


          <form
            action="/orders/payment/<%= order._id %>"
            method="POST"
            id="paymentForm"
          >


            <!-- SECTION LABEL -->

            <div class="section-label">
              <i class="fas fa-wallet"></i>
              Choose Payment Method
            </div>


            <!-- INFO NOTICE -->

            <div class="info-notice">

              <div class="info-notice-icon">
                <i class="fas fa-info"></i>
              </div>

              <div class="info-notice-text">
                <strong>
                  Cash on Delivery Available
                </strong>
                <p>
                  Pay in cash when your order arrives. Please keep exact
                  change ready. No advance payment required.
                </p>
              </div>

            </div>


            <!-- =================================================
                 COD PAYMENT OPTION
            ================================================== -->

            <label class="payment-option selected" for="cod">

              <input
                type="radio"
                id="cod"
                name="paymentMethod"
                value="COD"
                checked
              >

              <div class="payment-option-icon">
                <i class="fas fa-money-bill-wave"></i>
              </div>

              <div class="payment-option-text">

                <div class="payment-option-title">
                  Cash on Delivery
                </div>

                <div class="payment-option-desc">
                  Pay in cash when your order is delivered.
                </div>

              </div>

              <div class="payment-option-check">
                <i class="fas fa-check"></i>
              </div>

            </label>


            <!-- =================================================
                 CONFIRM BUTTON
            ================================================== -->

            <button
              type="submit"
              class="confirm-btn"
              id="confirmBtn"
              style="margin-top: 22px;"
            >
              <i class="fas fa-lock"></i>
              Confirm Payment
            </button>


            <!-- =================================================
                 TRUST STRIP
            ================================================== -->

            <div class="trust-strip">

              <div class="trust-item">
                <i class="fas fa-shield-alt"></i>
                <span>Secure Payment</span>
              </div>

              <div class="trust-item">
                <i class="fas fa-lock"></i>
                <span>Encrypted</span>
              </div>

              <div class="trust-item">
                <i class="fas fa-truck"></i>
                <span>Fast Delivery</span>
              </div>

            </div>


          </form>


          <!-- BACK LINK -->

          <a href="/cart" class="back-link">
            <i class="fas fa-arrow-left"></i>
            Back to Cart
          </a>


        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    /* =====================================================
       PAYMENT OPTION SELECTION
    ===================================================== */

    const paymentOptions = document.querySelectorAll('.payment-option');

    paymentOptions.forEach(function(option) {

      const radio = option.querySelector('input[type="radio"]');

      if (radio) {

        option.addEventListener('click', function() {

          paymentOptions.forEach(function(opt) {
            opt.classList.remove('selected');
          });

          option.classList.add('selected');

        });

      }

    });


    /* =====================================================
       PREVENT DOUBLE SUBMISSION
    ===================================================== */

    const paymentForm = document.getElementById('paymentForm');
    const confirmBtn = document.getElementById('confirmBtn');

    if (paymentForm && confirmBtn) {

      paymentForm.addEventListener('submit', function() {

        confirmBtn.disabled = true;

        confirmBtn.innerHTML =
          '<i class="fas fa-spinner fa-spin"></i> Confirming...';

      });

    }


    console.log("Reciclaja — Payment page loaded 💳");

  </script>

</body>

</html>