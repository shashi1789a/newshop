<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>My Orders — Reciclaja</title>

  <%- include('../partials/head') %>

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/5471644867.js" crossorigin="anonymous"></script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,700&display=swap" rel="stylesheet" />

  <style>

    /* =====================================================
       DESIGN TOKENS
    ===================================================== */

    :root {
      --forest: #0d3b2e;
      --forest-2: #14523f;
      --forest-3: #1e6b52;
      --forest-soft: #2d8a6a;
      --forest-deep: #072a20;

      --emerald: #10b981;
      --emerald-soft: #34d399;

      --mango: #f59e0b;
      --mango-soft: #fbbf24;
      --mango-deep: #d97706;

      --coral: #f97362;
      --coral-soft: #fb9585;
      --coral-deep: #e05a44;

      --blush: #fef3e7;
      --blush-2: #fde8d0;

      --mint: #ecfdf5;
      --mint-2: #d1fae5;

      --sky: #e8f4ff;
      --sky-2: #d0e6ff;

      --lavender: #f0ebff;
      --lavender-2: #e0d5ff;

      --bg: #fbfaf7;
      --surface: #ffffff;
      --surface-2: #f7f4ee;
      --surface-3: #efeae0;

      --text: #10261d;
      --text-muted: #556b5f;
      --text-light: #8a9a90;

      --border: #e6e0d4;
      --border-soft: #f0ebe0;

      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius: 16px;
      --radius-sm: 10px;

      --shadow-sm: 0 2px 8px rgba(13, 59, 46, 0.05);
      --shadow-md: 0 8px 28px rgba(13, 59, 46, 0.08);
      --shadow-lg: 0 20px 48px rgba(13, 59, 46, 0.12);
      --shadow-glow: 0 12px 40px rgba(16, 185, 129, 0.18);
      --shadow-mango: 0 12px 40px rgba(245, 158, 11, 0.22);

      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* =====================================================
       RESET
    ===================================================== */

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    img { display: block; max-width: 100%; }

    /* =====================================================
       PAGE BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 12% 15%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 88% 85%, rgba(16, 185, 129, 0.05) 0%, transparent 40%);
      pointer-events: none;
      z-index: -1;
    }

    /* =====================================================
       SCROLL PROGRESS BAR
    ===================================================== */

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--emerald) 0%, var(--mango) 50%, var(--coral) 100%);
      z-index: 9999;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
    }

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: opacity, transform;
    }

    [data-reveal="up"] { transform: translateY(40px); }
    [data-reveal="down"] { transform: translateY(-40px); }
    [data-reveal="zoom-up"] { transform: scale(0.94) translateY(30px); }

    [data-reveal].is-revealed {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* =====================================================
       CONTAINER
    ===================================================== */

    .container {
      width: 92%;
      max-width: 1140px;
      margin: 45px auto 80px;
    }

    /* =====================================================
       PAGE HEADER
    ===================================================== */

    .page-header {
      margin-bottom: 34px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
      position: relative;
    }

    .page-header::after {
      content: "";
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 90px;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 100%);
      border-radius: 3px;
    }

    .page-header-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(13, 59, 46, 0.06);
      border: 1px solid rgba(13, 59, 46, 0.08);
      color: var(--forest-3);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .page-header-eyebrow::before {
      content: "📦";
      font-size: 12px;
    }

    .page-header h1 {
      font-family: var(--font-serif);
      font-size: 42px;
      font-weight: 500;
      letter-spacing: -1.5px;
      color: var(--forest);
      line-height: 1.1;
      margin-bottom: 10px;
    }

    .page-header h1 em {
      font-style: italic;
      background: linear-gradient(120deg, var(--mango-deep) 0%, var(--coral) 60%, var(--mango) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 15px;
      max-width: 560px;
      line-height: 1.65;
    }

    /* =====================================================
       EMPTY STATE
    ===================================================== */

    .empty {
      background:
        radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.06) 0%, transparent 65%),
        var(--surface);
      border: 2px dashed var(--border);
      border-radius: var(--radius-xl);
      padding: 80px 30px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .empty::before {
      content: "📦";
      position: absolute;
      font-size: 220px;
      opacity: 0.04;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .empty-icon {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
      color: var(--coral);
      margin: 0 auto 22px;
      box-shadow: 0 12px 32px rgba(249, 115, 98, 0.2);
      position: relative;
      z-index: 2;
    }

    .empty h2 {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.6px;
      margin-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .empty p {
      color: var(--text-muted);
      font-size: 14.5px;
      max-width: 400px;
      margin: 0 auto 26px;
      line-height: 1.65;
      position: relative;
      z-index: 2;
    }

    .shop-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 15px 30px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      border-radius: var(--radius-sm);
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 28px rgba(13, 59, 46, 0.25);
      position: relative;
      z-index: 2;
      overflow: hidden;
    }

    .shop-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .shop-btn:hover::before { left: 100%; }

    .shop-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 36px rgba(13, 59, 46, 0.35);
      gap: 14px;
    }

    /* =====================================================
       ORDER CARD
    ===================================================== */

    .order-card {
      background: var(--surface);
      border: 2px solid var(--border-soft);
      border-radius: var(--radius-lg);
      margin-bottom: 22px;
      overflow: hidden;
      box-shadow: 0 12px 40px rgba(13, 59, 46, 0.06);
      position: relative;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      animation: cardIn 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    @keyframes cardIn {
      0% { opacity: 0; transform: translateY(24px) scale(0.97); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .order-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--mango) 0%, var(--coral) 50%, var(--emerald) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .order-card:hover::before {
      transform: scaleX(1);
    }

    .order-card:hover {
      transform: translateY(-6px);
      border-color: var(--mint-2);
      box-shadow: var(--shadow-glow);
    }

    /* =====================================================
       ORDER HEADER
    ===================================================== */

    .order-header {
      padding: 22px 26px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      border-bottom: 1px dashed var(--border);
      background:
        radial-gradient(circle at 90% 20%, rgba(16, 185, 129, 0.04) 0%, transparent 60%),
        linear-gradient(135deg, var(--surface-2) 0%, #ffffff 100%);
      flex-wrap: wrap;
    }

    .order-id {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 600;
      color: var(--forest);
      letter-spacing: -0.3px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .order-id i {
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, var(--blush) 0%, var(--blush-2) 100%);
      border-radius: 10px;
      color: var(--mango-deep);
      font-size: 13px;
      flex-shrink: 0;
    }

    .order-date {
      color: var(--text-light);
      font-size: 12.5px;
      margin-top: 6px;
      padding-left: 42px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .order-date i {
      color: var(--mango-deep);
      font-size: 11px;
    }

    /* =====================================================
       STATUS BADGES
    ===================================================== */

    .status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 15px;
      border-radius: 30px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .status::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 8px currentColor;
    }

    .status.pending {
      background: linear-gradient(135deg, var(--blush) 0%, var(--blush-2) 100%);
      color: var(--mango-deep);
      border-color: rgba(245, 158, 11, 0.25);
    }

    .status.placed {
      background: linear-gradient(135deg, var(--sky) 0%, var(--sky-2) 100%);
      color: #2b7de0;
      border-color: rgba(43, 125, 224, 0.22);
    }

    .status.confirmed {
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      color: var(--forest-3);
      border-color: rgba(16, 185, 129, 0.22);
    }

    .status.processing {
      background: linear-gradient(135deg, var(--lavender) 0%, var(--lavender-2) 100%);
      color: #6352b8;
      border-color: rgba(99, 82, 184, 0.22);
    }

    .status.shipped {
      background: linear-gradient(135deg, #e8f7ff 0%, #d0ecff 100%);
      color: #16749a;
      border-color: rgba(22, 116, 154, 0.22);
    }

    .status.out_for_delivery {
      background: linear-gradient(135deg, #fff2e0 0%, #ffe0b8 100%);
      color: var(--mango-deep);
      border-color: rgba(217, 119, 6, 0.22);
    }

    .status.delivered {
      background: linear-gradient(135deg, var(--mint) 0%, var(--mint-2) 100%);
      color: var(--forest-3);
      border-color: rgba(16, 185, 129, 0.22);
    }

    .status.cancelled {
      background: linear-gradient(135deg, #ffeaea 0%, #ffd4d4 100%);
      color: var(--coral-deep);
      border-color: rgba(224, 90, 68, 0.22);
    }

    /* =====================================================
       ITEMS
    ===================================================== */

    .items {
      padding: 4px 26px;
    }

    .item {
      display: flex;
      gap: 18px;
      padding: 20px 0;
      border-bottom: 1px dashed var(--border);
      align-items: center;
      transition: all 0.3s ease;
    }

    .item:hover {
      padding-left: 4px;
    }

    .item:last-child {
      border-bottom: none;
    }

    .item-image {
      width: 84px;
      height: 84px;
      background: linear-gradient(145deg, var(--surface-2) 0%, var(--surface-3) 100%);
      border-radius: var(--radius-sm);
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-soft);
      font-size: 32px;
      transition: transform 0.35s ease;
    }

    .item:hover .item-image {
      transform: scale(1.04);
    }

    .item-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .item-info {
      flex: 1;
      min-width: 0;
    }

    .item-name {
      font-family: var(--font-serif);
      font-weight: 600;
      font-size: 16px;
      color: var(--forest);
      margin-bottom: 8px;
      letter-spacing: -0.3px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .item-price {
      color: var(--forest-3);
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.2px;
    }

    .item-quantity {
      color: var(--text-light);
      font-size: 12.5px;
      margin-top: 5px;
      font-weight: 600;
    }

    .item-quantity strong {
      color: var(--forest);
      font-weight: 800;
    }

    /* =====================================================
       ORDER FOOTER
    ===================================================== */

    .order-footer {
      padding: 22px 26px;
      background:
        radial-gradient(circle at 90% 20%, rgba(245, 158, 11, 0.06) 0%, transparent 60%),
        linear-gradient(135deg, var(--surface-2) 0%, #ffffff 100%);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      border-top: 1px solid var(--border-soft);
      flex-wrap: wrap;
    }

    .total-label {
      color: var(--text-light);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 800;
    }

    .total {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -1px;
      margin-top: 6px;
      line-height: 1;
    }

    .payment {
      margin-top: 12px;
      font-size: 12px;
      color: var(--text-light);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .payment strong {
      color: var(--forest-3);
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .payment strong i {
      font-size: 11px;
      color: var(--mango-deep);
    }

    .payment-divider {
      color: var(--border);
      font-weight: 400;
    }

    /* =====================================================
       VIEW BUTTON
    ===================================================== */

    .view-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, var(--forest) 0%, var(--forest-3) 100%);
      color: #ffffff;
      padding: 13px 24px;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.4px;
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 8px 20px rgba(13, 59, 46, 0.22);
      position: relative;
      overflow: hidden;
      white-space: nowrap;
    }

    .view-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.35), transparent);
      transition: left 0.6s ease;
    }

    .view-btn:hover::before { left: 100%; }

    .view-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(13, 59, 46, 0.32);
      gap: 14px;
    }

    .view-btn i {
      transition: transform 0.3s ease;
    }

    .view-btn:hover i {
      transform: translateX(3px);
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 768px) {

      .container {
        width: 94%;
        margin: 30px auto 60px;
      }

      .page-header h1 {
        font-size: 32px;
        letter-spacing: -1px;
      }

      .order-header {
        padding: 18px 22px;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
      }

      .order-id {
        font-size: 16px;
      }

      .order-date {
        padding-left: 42px;
      }

      .items {
        padding: 4px 22px;
      }

      .item-image {
        width: 76px;
        height: 76px;
        font-size: 28px;
      }

      .item-name {
        font-size: 15px;
      }

      .order-footer {
        padding: 20px 22px;
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
      }

      .total {
        font-size: 24px;
      }

      .view-btn {
        width: 100%;
        justify-content: center;
      }

    }

    @media (max-width: 500px) {

      .page-header h1 {
        font-size: 26px;
        letter-spacing: -0.8px;
      }

      .page-header p {
        font-size: 13.5px;
      }

      .order-card {
        border-radius: var(--radius);
      }

      .order-header {
        padding: 16px 18px;
      }

      .order-id {
        font-size: 14.5px;
      }

      .order-id i {
        width: 28px;
        height: 28px;
        font-size: 12px;
      }

      .order-date {
        padding-left: 36px;
        font-size: 11.5px;
      }

      .items {
        padding: 4px 18px;
      }

      .item {
        gap: 14px;
        padding: 16px 0;
      }

      .item-image {
        width: 68px;
        height: 68px;
        font-size: 24px;
      }

      .item-name {
        font-size: 14px;
        margin-bottom: 6px;
      }

      .item-price {
        font-size: 13px;
      }

      .item-quantity {
        font-size: 11.5px;
      }

      .order-footer {
        padding: 18px;
      }

      .total {
        font-size: 22px;
      }

      .payment {
        font-size: 11px;
        gap: 6px;
      }

      .view-btn {
        padding: 12px 20px;
        font-size: 12px;
      }

      .status {
        font-size: 9.5px;
        padding: 6px 12px;
      }

      .empty {
        padding: 50px 22px;
      }

      .empty-icon {
        width: 72px;
        height: 72px;
        font-size: 30px;
      }

      .empty h2 {
        font-size: 21px;
      }

      .shop-btn {
        padding: 13px 24px;
        font-size: 12.5px;
      }

    }

  </style>

</head>


<body>

  <!-- Scroll progress -->
  <div class="scroll-progress" id="scrollProgress"></div>


  <!-- =====================================================
       NAVBAR
  ====================================================== -->

  <%- include('../partials/navbar') %>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="container">


    <!-- =================================================
         PAGE HEADER
    ================================================== -->

    <div class="page-header" data-reveal="down">

      <span class="page-header-eyebrow">
        Order History
      </span>

      <h1>
        My <em>Orders.</em>
      </h1>

      <p>
        Track and manage all your orders — from placement to delivery,
        everything in one place.
      </p>

    </div>


    <!-- =================================================
         EMPTY ORDERS
    ================================================== -->

    <% if (!orders || orders.length === 0) { %>


      <div class="empty" data-reveal="zoom-up">

        <div class="empty-icon">
          <i class="fas fa-box-open"></i>
        </div>

        <h2>
          No Orders Yet
        </h2>

        <p>
          You haven't placed any orders yet. Start exploring our
          sustainable collection and make your first purchase.
        </p>

        <a href="/" class="shop-btn">
          <i class="fas fa-shopping-bag"></i>
          Start Shopping
        </a>

      </div>


    <% } else { %>


      <!-- =================================================
           ORDERS
      ================================================== -->

      <% orders.forEach((order, index) => { %>


        <div
          class="order-card"
          data-reveal="zoom-up"
          data-delay="<%= Math.min(index * 80, 500) %>"
        >


          <!-- ================= HEADER ================= -->

          <div class="order-header">


            <div>

              <div class="order-id">

                <i class="fas fa-receipt"></i>

                Order #<%= String(order._id)
                  .slice(-8)
                  .toUpperCase() %>

              </div>


              <div class="order-date">

                <i class="far fa-clock"></i>

                <%= order.createdAt
                  ? new Date(order.createdAt).toLocaleString("en-IN", {
                      day: "numeric",
                      month: "short",
                      year: "numeric",
                      hour: "2-digit",
                      minute: "2-digit"
                    })
                  : "Date unavailable" %>

              </div>

            </div>


            <!-- STATUS -->

            <%
              const status =
                String(order.orderStatus || "PENDING").toLowerCase();
            %>

            <span class="status <%= status %>">

              <%= String(order.orderStatus || "PENDING")
                .replaceAll("_", " ") %>

            </span>


          </div>


          <!-- ================= ITEMS ================= -->

          <div class="items">


            <% if (order.items && order.items.length > 0) { %>


              <% order.items.forEach(item => { %>


                <div class="item">


                  <!-- IMAGE -->

                  <div class="item-image">

                    <% if (
                      item.product &&
                      item.product.images &&
                      item.product.images.length > 0
                    ) { %>

                      <img
                        src="<%= item.product.images[0].url || item.product.images[0] %>"
                        alt="<%= item.product.name || 'Product' %>"
                        onerror="this.style.display='none';"
                      >

                    <% } else { %>

                      👕

                    <% } %>

                  </div>


                  <!-- PRODUCT INFO -->

                  <div class="item-info">

                    <div class="item-name">

                      <%= item.product
                        ? (item.product.name || item.product.title || "Product")
                        : "Product Unavailable" %>

                    </div>


                    <div class="item-price">

                      ₹<%= Number(item.price || 0).toLocaleString("en-IN") %>

                    </div>


                    <div class="item-quantity">

                      Quantity: <strong><%= item.quantity || 1 %></strong>

                    </div>

                  </div>


                </div>


              <% }) %>


            <% } else { %>


              <div style="
                padding: 20px 0;
                color: var(--text-muted);
                font-style: italic;
              ">

                No products found.

              </div>


            <% } %>


          </div>


          <!-- ================= FOOTER ================= -->

          <div class="order-footer">


            <div>


              <div class="total-label">
                Total Amount
              </div>


              <div class="total">

                ₹<%= Number(order.totalAmount || 0).toLocaleString("en-IN") %>

              </div>


              <div class="payment">


                <strong>

                  <% if (order.paymentMethod === "RAZORPAY") { %>

                    <i class="fas fa-credit-card"></i>
                    Online Payment

                  <% } else { %>

                    <i class="fas fa-money-bill-wave"></i>
                    Cash on Delivery

                  <% } %>

                </strong>


                <span class="payment-divider">|</span>


                <strong>

                  <i class="fas fa-shield-alt"></i>

                  <%= String(order.paymentStatus || "pending")
                    .toUpperCase() %>

                </strong>


              </div>


            </div>


            <!-- VIEW DETAILS -->

            <a
              href="/orders/<%= order._id %>"
              class="view-btn"
            >

              View Details

              <i class="fas fa-arrow-right"></i>

            </a>


          </div>


        </div>


      <% }) %>


    <% } %>


  </main>


  <!-- =====================================================
       FOOTER PARTIAL
  ====================================================== -->

  <%- include('../partials/footer') %>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SCROLL PROGRESS
    ===================================================== */

    const progressBar = document.getElementById('scrollProgress');

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();


    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealEls = document.querySelectorAll('[data-reveal]');

    if ('IntersectionObserver' in window) {

      const revealObserver = new IntersectionObserver((entries, observer) => {

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = parseInt(el.dataset.delay || 0, 10);

            setTimeout(() => {
              el.classList.add('is-revealed');
            }, delay);

            observer.unobserve(el);
          }
        });

      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -60px 0px'
      });

      revealEls.forEach(el => revealObserver.observe(el));

    } else {

      revealEls.forEach(el => el.classList.add('is-revealed'));

    }


    console.log("Reciclaja — My Orders page loaded 📦");

  </script>

</body>

</html>