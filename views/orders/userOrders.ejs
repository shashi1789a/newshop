<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head') %>
</head>
<body>

<h1>My Orders</h1>

<% orders.forEach(order => { %>

<div class="order-card">

  <p>Total: ₹ <%= order.totalAmount %></p>

  <p>Status: <%= order.orderStatus %></p>

  <% order.items.forEach(item => { %>

    <h4><%= item.product.name %></h4>

  <% }) %>

</div>

<% }) %>

</body>
</html>